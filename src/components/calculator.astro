// ── FUNNY 3D BACKGROUND (THREE.JS) ────────────────────────
(function() {
  const container = document.getElementById('sg-3d-bg');
  if (!container || typeof THREE === 'undefined') return;

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
  const renderer = new THREE.WebGLRenderer({ canvas: container, alpha: true, antialias: true });
  
  function resize() {
    const parent = container.parentElement;
    renderer.setSize(parent.offsetWidth, parent.offsetHeight);
    camera.aspect = parent.offsetWidth / parent.offsetHeight;
    camera.updateProjectionMatrix();
  }
  window.addEventListener('resize', resize);
  resize();

  // Playful Lights
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
  scene.add(ambientLight);
  const pointLight = new THREE.PointLight(0x7b2ff7, 1);
  pointLight.position.set(5, 5, 5);
  scene.add(pointLight);

  // Use the actual tech SVGs exported from the game logic
  const symbols = [];
  const texLoader = new THREE.TextureLoader();
  
  // Convert SVG string to a data URI texture
  function createSvgTexture(svgStr) {
    if (!svgStr) return null;
    
    // SVGs must have an xmlns to be loaded as images
    let str = svgStr;
    if (!str.includes('xmlns=')) {
      str = str.replace('<svg ', '<svg xmlns="http://www.w3.org/2000/svg" ');
    }
    
    const canvas = document.createElement('canvas');
    canvas.width = 128; 
    canvas.height = 128;
    const ctx = canvas.getContext('2d');
    
    // Add a slight glow
    ctx.shadowColor = 'rgba(255, 255, 255, 0.4)';
    ctx.shadowBlur = 15;
    
    const texture = new THREE.CanvasTexture(canvas);
    
    const img = new Image();
    const blob = new Blob([str], {type: 'image/svg+xml;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    
    img.onload = () => {
      // Draw centered
      ctx.drawImage(img, 16, 16, 96, 96);
      texture.needsUpdate = true;
      URL.revokeObjectURL(url);
    };
    img.src = url;
    
    return texture;
  }

  const icons = window.TECH_ICONS ? Object.values(window.TECH_ICONS) : [];
  
  // Fallback to text if icons not available
  function createTextTexture(text) {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    ctx.font = 'bold 32px "JetBrains Mono", monospace';
    ctx.fillStyle = 'rgba(34, 211, 238, 0.5)';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(text, 64, 64);
    return new THREE.CanvasTexture(canvas);
  }

  const particleCount = icons.length > 0 ? 30 : 20;

  for (let i = 0; i < particleCount; i++) {
    let texture = null;
    if (icons.length > 0) {
      texture = createSvgTexture(icons[i % icons.length]);
    } else {
      const fallbacks = ['React', 'Angular', 'Docker', 'AWS', 'Java', 'Node'];
      texture = createTextTexture(fallbacks[Math.floor(Math.random() * fallbacks.length)]);
    }

    const material = new THREE.SpriteMaterial({ map: texture, transparent: true, opacity: 0.15 });
    const sprite = new THREE.Sprite(material);
    
    // Spread them across the background
    sprite.position.set(
      (Math.random() - 0.5) * 25,
      (Math.random() - 0.5) * 25,
      (Math.random() - 0.5) * 15
    );
    
    // Varying sizes
    const size = Math.random() * 2 + 1.5;
    sprite.scale.set(size, size, size);
    
    sprite.userData = { 
        vel: new THREE.Vector3((Math.random()-0.5)*0.03, (Math.random()-0.5)*0.03, 0),
        rotVel: (Math.random()-0.5)*0.05 
    };
    
    scene.add(sprite);
    symbols.push(sprite);
  }

  camera.position.z = 12;

  function animate() {
    requestAnimationFrame(animate);
    
    symbols.forEach(s => {
      s.position.add(s.userData.vel);
      // Sprite rotation requires material rotation
      s.material.rotation += s.userData.rotVel;
      
      // Bounce off invisible walls
      if (Math.abs(s.position.x) > 15) s.userData.vel.x *= -1;
      if (Math.abs(s.position.y) > 12) s.userData.vel.y *= -1;
    });

    renderer.render(scene, camera);
  }

  animate();
})();
</script>

