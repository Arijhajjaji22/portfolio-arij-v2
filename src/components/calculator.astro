---
// Stack Attack — Premium Whac-a-Mole Game
---

<section id="sg" class="sg">

  <!-- ══ ANIMATED DARK BACKGROUND ══ -->
  <div class="sg-bg">
    <canvas id="sg-cv"></canvas>
    <div class="sg-orb o1"></div>
    <div class="sg-orb o2"></div>
    <div class="sg-orb o3"></div>
    <div class="sg-grid"></div>
    <!-- Funny 3D Background -->
    <canvas id="sg-3d-bg" class="absolute inset-0 pointer-events-none opacity-40"></canvas>
    
    <!-- Matrix rain -->
    <canvas id="sg-mat"></canvas>
    <!-- Horizontal beams -->
    <div class="sg-beam bm1"></div>
    <div class="sg-beam bm2"></div>
    <!-- Noise -->
    <div class="sg-noise"></div>
    <!-- Scanlines -->
    <div class="sg-scan"></div>
  </div>

  <div class="sg-wrap">

    <!-- INTRO PILL -->
    <div class="sg-intro">
      <span class="sg-intro-dot"></span>
      <span class="sg-intro-txt">scrolled all the way down? take a break & play</span>
      <span class="sg-intro-icon">🎮</span>
    </div>

    <!-- HEADER -->
    <div class="sg-head">
      <div class="sg-badge">
        <span class="sg-badge-dot"></span>
        BONUS.LEVEL
      </div>
      <h2 class="sg-title">
        <span class="sg-t1">Stack</span>
        <span class="sg-t2">Attack!</span>
      </h2>
      <p class="sg-desc">Catch techs · dodge bugs · blame the intern</p>
    </div>

    <!-- HUD -->
    <div class="sg-hud">
      <div class="sg-hud-card hc-score">
        <span class="sg-hud-ico">⭐</span>
        <div>
          <div class="sg-hud-lbl">SCORE</div>
          <div class="sg-hud-val" id="sg-score">0</div>
        </div>
      </div>
      <div class="sg-hud-card hc-time">
        <span class="sg-hud-ico">⏱</span>
        <div>
          <div class="sg-hud-lbl">TIME</div>
          <div class="sg-hud-val" id="sg-time">30</div>
        </div>
      </div>
      <div class="sg-hud-card hc-best">
        <span class="sg-hud-ico">🏆</span>
        <div>
          <div class="sg-hud-lbl">BEST</div>
          <div class="sg-hud-val" id="sg-best">0</div>
        </div>
      </div>
      <div class="sg-hud-card hc-combo">
        <span class="sg-hud-ico">🔥</span>
        <div>
          <div class="sg-hud-lbl">LEVEL</div>
          <div class="sg-hud-val" id="sg-level">1</div>
        </div>
      </div>
    </div>

    <!-- STATUS + TIMER -->
    <div class="sg-status-row">
      <div class="sg-status" id="sg-status">
        <span class="sg-status-dot" id="sg-sdot"></span>
        <span id="sg-stxt">deploy to prod on friday?</span>
      </div>
    </div>
    <div class="sg-timer-track">
      <div class="sg-timer-fill" id="sg-tbar"></div>
    </div>

    <!-- BOARD -->
    <div class="sg-board-wrap">
      <div class="sg-board" id="sg-board">
        <!-- 9 holes -->
        {Array.from({length: 9}).map((_, i) => (
          <div class="sg-hole" data-idx={i}>
            <div class="sg-hole-inner">
              <div class="sg-hole-shine"></div>
            </div>
            <div class="sg-mole" data-idx={i}>
              <div class="sg-eyes">
                <div class="sg-eye"></div>
                <div class="sg-eye"></div>
              </div>
            </div>
          </div>
        ))}

        <!-- Overlay -->
        <div class="sg-overlay" id="sg-ov">
          <div class="sg-ov-box">
            <div class="sg-ov-icon" id="sg-ov-icon">🚀</div>
            <h3 class="sg-ov-title" id="sg-ov-title">Stack Attack!</h3>
            <p class="sg-ov-sub" id="sg-ov-sub">catch tech · dodge bugs · blame the intern</p>
            <div class="sg-ov-stats" id="sg-ov-stats"></div>
            <button class="sg-play-btn" id="sg-play">
              <span class="sg-play-glow"></span>
              <span class="sg-play-icon">▶</span>
              <span id="sg-play-txt">START</span>
            </button>
            <div class="sg-legend">
              <span class="sg-leg"><span class="sg-leg-dot" style="background:#94a3b8"></span>+10</span>
              <span class="sg-leg"><span class="sg-leg-dot" style="background:#3b82f6"></span>+20</span>
              <span class="sg-leg"><span class="sg-leg-dot" style="background:#a78bfa"></span>+40</span>
              <span class="sg-leg"><span class="sg-leg-dot" style="background:#fbbf24"></span>+80</span>
              <span class="sg-leg sg-leg-bad"><span class="sg-leg-dot" style="background:#ef4444"></span>−30</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- STACK BAR -->
    <div class="sg-stack" id="sg-stack">
      <span class="sg-stack-lbl">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        <span id="sg-scount">0</span>
      </span>
      <div class="sg-stack-chips" id="sg-chips">
        <span class="sg-stack-empty" id="sg-empty">npm install skills --save</span>
      </div>
    </div>

    <!-- Game Effects Overlay -->
    <div id="sg-fx-bg" class="sg-hit-bg"></div>

    <!-- FOOTER -->
    <div class="sg-footer">
      <p class="sg-quote" id="sg-quote">git commit -m "fixed it" (narrator: he did not fix it)</p>
      <div class="sg-mini-stats">
        <span>runs: <strong id="sg-runs">0</strong></span>
        <span class="sg-dot-sep">·</span>
        <span>total pts: <strong id="sg-total">0</strong></span>
      </div>
    </div>

  </div>
</section>

<style>
/* ── BASE ──────────────────────────────────────────── */
.sg {
  position: relative;
  padding: 8rem 0 10rem;
  background: #08080a;
  overflow: hidden;
  isolation: isolate;
}
.sg-wrap {
  position: relative; z-index: 10;
  max-width: 620px; margin: 0 auto; padding: 0 1.25rem;
  display: flex; flex-direction: column; gap: 1.1rem;
}

/* ── ANIMATED BACKGROUND ───────────────────────────── */
.sg-bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }

#sg-cv {
  position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.2;
}
#sg-mat {
  position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.05;
}

.sg-orb {
  position: absolute; border-radius: 50%;
  filter: blur(100px); pointer-events: none;
}
.o1 { width: 500px; height: 500px; top: -160px; left: -120px; background: radial-gradient(circle, rgba(123,47,247,0.08) 0%, transparent 70%); animation: sg-drift1 20s ease-in-out infinite alternate; }
.o2 { width: 420px; height: 420px; bottom: -130px; right: -80px; background: radial-gradient(circle, rgba(59,130,246,0.09) 0%, transparent 70%); animation: sg-drift2 16s ease-in-out infinite alternate; }
.o3 { width: 280px; height: 280px; top: 45%; left: 55%; background: radial-gradient(circle, rgba(192,132,252,0.05) 0%, transparent 70%); animation: sg-drift3 22s ease-in-out infinite alternate; }
@keyframes sg-drift1 { 0% { transform: translate(0,0); } 100% { transform: translate(45px,-30px) scale(1.1); } }
@keyframes sg-drift2 { 0% { transform: translate(0,0); } 100% { transform: translate(-35px,22px) scale(0.92); } }
@keyframes sg-drift3 { 0% { transform: translate(0,0); } 100% { transform: translate(-50px,-35px); } }

.sg-grid {
  position: absolute; inset: 0;
  background-image: linear-gradient(rgba(34,211,238,0.013) 1px, transparent 1px), linear-gradient(90deg, rgba(34,211,238,0.013) 1px, transparent 1px);
  background-size: 50px 50px;
  mask-image: radial-gradient(ellipse 85% 75% at 50% 50%, black 5%, transparent 72%);
}

.sg-beam {
  position: absolute; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(34,211,238,0.14) 30%, rgba(167,139,250,0.2) 50%, rgba(34,211,238,0.14) 70%, transparent);
  opacity: 0;
}
.bm1 { top: 30%; animation: sg-beam 9s ease-in-out infinite; }
.bm2 { top: 68%; animation: sg-beam 13s ease-in-out infinite 4s; }
@keyframes sg-beam { 0%,100% { opacity:0; transform:scaleX(0.2); } 20% { opacity:1; transform:scaleX(1); } 80% { opacity:1; } }

.sg-noise {
  position: absolute; inset: 0; z-index: 2;
  background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.02'/%3E%3C/svg%3E");
  opacity: 0.45; mix-blend-mode: overlay;
}
.sg-scan {
  position: absolute; inset: 0; z-index: 1;
  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.007) 2px, rgba(0,0,0,0.007) 4px);
}

/* ── INTRO PILL ────────────────────────────────────── */
.sg-intro {
  display: inline-flex; align-items: center; gap: 14px;
  padding: 12px 28px; border-radius: 999px; align-self: center;
  background: rgba(10, 10, 15, 0.85);
  border: 2px solid rgba(34, 211, 238, 0.4);
  backdrop-filter: blur(14px);
  animation: sg-up 0.6s ease both, sg-pill-float 2.5s ease-in-out infinite alternate;
  z-index: 100;
  margin-bottom: 20px;
}
@keyframes sg-pill-float {
  0% { transform: translateY(0); box-shadow: 0 0 25px rgba(34, 211, 238, 0.15); border-color: rgba(34, 211, 238, 0.4); }
  100% { transform: translateY(-8px); box-shadow: 0 15px 40px rgba(34, 211, 238, 0.4), inset 0 0 25px rgba(34, 211, 238, 0.2); border-color: rgba(34, 211, 238, 0.8); }
}

.sg-intro-dot {
  width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
  background: #4ade80; box-shadow: 0 0 20px #4ade80, 0 0 10px #4ade80;
  animation: sg-pulse 1.2s ease-in-out infinite;
}

.sg-intro-txt {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
  font-weight: 900;
  background: linear-gradient(90deg, #ffffff, #22d3ee, #ffffff, #22d3ee);
  background-size: 300% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: sg-txt-shimmer 3s linear infinite;
}
@keyframes sg-txt-shimmer { 0% { background-position: 0% 50%; } 100% { background-position: 300% 50%; } }

.sg-intro-icon { 
  font-size: 1.6rem;
  display: inline-block;
  animation: sg-wiggle 1.8s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  transform-origin: center;
  filter: drop-shadow(0 0 15px rgba(255,255,255,0.6));
}
@keyframes sg-wiggle {
  0%, 100% { transform: rotate(0deg) scale(1); }
  25% { transform: rotate(-25deg) scale(1.2); }
  50% { transform: rotate(15deg) scale(1.2); }
  75% { transform: rotate(-10deg) scale(1.1); }
}

/* ── HEADER ────────────────────────────────────────── */
.sg-head { text-align: center; animation: sg-up 0.6s ease 0.1s both; }

.sg-badge {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 4px 14px 4px 10px; border-radius: 999px; margin-bottom: 0.8rem;
  background: rgba(249,115,22,0.06); border: 1px solid rgba(249,115,22,0.2);
  font-family: 'JetBrains Mono', monospace;
  font-size: 8px; letter-spacing: 0.35em; text-transform: uppercase;
  color: rgba(249,115,22,0.8); position: relative; overflow: hidden;
}
.sg-badge::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(249,115,22,0.12), transparent);
  animation: sg-shimmer 3s ease-in-out infinite;
}
.sg-badge-dot {
  width: 5px; height: 5px; border-radius: 50%;
  background: #4ade80; box-shadow: 0 0 8px #4ade80;
  animation: sg-pulse 2s ease-in-out infinite;
}

.sg-title { margin: 0 0 0.4rem; line-height: 1; }
.sg-t1 {
  display: block; font-family: 'Outfit', sans-serif; font-weight: 500;
  font-size: clamp(1rem, 2.5vw, 1.2rem); letter-spacing: 0.25em;
  text-transform: uppercase; color: rgba(255,255,255,0.4);
}
.sg-t2 {
  display: block; font-family: 'Outfit', sans-serif; font-weight: 900;
  font-size: clamp(3rem, 7vw, 5rem); letter-spacing: -0.04em;
  text-transform: uppercase;
  background: linear-gradient(120deg, #7b2ff7 0%, #3b82f6 50%, #c084fc 100%);
  background-size: 250% 250%; -webkit-background-clip: text;
  -webkit-text-fill-color: transparent; background-clip: text;
  animation: sg-grad 7s ease-in-out infinite;
  filter: drop-shadow(0 0 35px rgba(123,47,247,0.15));
}
@keyframes sg-grad { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }

.sg-desc {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase;
  color: rgba(255,255,255,0.2);
}

/* ── HUD ───────────────────────────────────────────── */
.sg-hud {
  display: grid; grid-template-columns: repeat(4,1fr); gap: 8px;
  animation: sg-up 0.6s ease 0.15s both;
}
.sg-hud-card {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 12px; border-radius: 12px;
  background: rgba(255,255,255,0.025);
  border: 1px solid rgba(255,255,255,0.06);
  backdrop-filter: blur(14px);
  transition: transform 0.2s, border-color 0.3s;
}
.sg-hud-card:hover { transform: translateY(-2px); }
.sg-hud-ico { font-size: 1.1rem; flex-shrink: 0; }
.sg-hud-lbl {
  font-family: 'JetBrains Mono', monospace;
  font-size: 6.5px; letter-spacing: 0.2em; text-transform: uppercase;
  color: rgba(255,255,255,0.22); margin-bottom: 2px;
}
.sg-hud-val {
  font-family: 'Outfit', sans-serif; font-weight: 900;
  font-size: 1.2rem; line-height: 1;
  font-variant-numeric: tabular-nums;
  transition: transform 0.15s, text-shadow 0.2s;
}
.hc-score .sg-hud-val { color: #fbbf24; }
.hc-time  .sg-hud-val { color: #22d3ee; }
.hc-best  .sg-hud-val { color: #a78bfa; }
.hc-combo .sg-hud-val { color: #f97316; }
.sg-hud-val.pop { transform: scale(1.4); }

/* ── STATUS + TIMER ────────────────────────────────── */
.sg-status-row { display: flex; align-items: center; gap: 8px; }
.sg-status {
  flex: 1; display: flex; align-items: center; gap: 8px;
  padding: 8px 14px; border-radius: 10px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  backdrop-filter: blur(10px);
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
  color: rgba(255,255,255,0.35); transition: all 0.3s;
}
.sg-status-dot {
  width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
  background: rgba(255,255,255,0.2); transition: all 0.3s;
}
.sg-status.ok   { border-color: rgba(74,222,128,0.2); }
.sg-status.ok .sg-status-dot { background: #4ade80; box-shadow: 0 0 8px #4ade80; }
.sg-status.ok #sg-stxt { color: rgba(74,222,128,0.7); }
.sg-status.bad  { border-color: rgba(239,68,68,0.25); animation: sg-shake 0.4s; }
.sg-status.bad .sg-status-dot { background: #ef4444; box-shadow: 0 0 8px #ef4444; }
.sg-status.bad #sg-stxt { color: rgba(239,68,68,0.8); }
.sg-status.epic { border-color: rgba(251,191,36,0.3); }
.sg-status.epic .sg-status-dot { background: #fbbf24; box-shadow: 0 0 10px #fbbf24; }
.sg-status.epic #sg-stxt { color: rgba(251,191,36,0.85); }

@keyframes sg-shake { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-5px)} 60%{transform:translateX(5px)} }

.sg-timer-track {
  height: 5px; border-radius: 3px; background: rgba(255,255,255,0.04); overflow: hidden;
}
.sg-timer-fill {
  height: 100%; width: 100%; border-radius: inherit;
  background: linear-gradient(90deg, #22d3ee, #a78bfa, #f97316);
  background-size: 200% 100%;
  animation: sg-tflow 2.5s linear infinite;
  box-shadow: 0 0 10px rgba(34,211,238,0.4);
  transition: width 0.12s linear;
}
.sg-timer-fill.urgent {
  background: linear-gradient(90deg, #ef4444, #f97316, #ef4444);
  box-shadow: 0 0 15px rgba(239,68,68,0.6);
  animation: sg-tflow 0.5s linear infinite, sg-urgent-blink 0.35s ease-in-out infinite;
}
@keyframes sg-tflow { 0% { background-position: 0% 0%; } 100% { background-position: 200% 0%; } }
@keyframes sg-urgent-blink { 0%,100% { opacity: 1; } 50% { opacity: 0.65; } }

/* ── BOARD ─────────────────────────────────────────── */
.sg-board-wrap { position: relative; }
.sg-board {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
  padding: 20px; border-radius: 24px;
  background: linear-gradient(145deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
  border: 1px solid rgba(255,255,255,0.07);
  backdrop-filter: blur(24px);
  box-shadow: 0 20px 60px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.06);
  position: relative;
  perspective: 1000px;
  transform-style: preserve-3d;
}

.sg-hole {
  position: relative; aspect-ratio: 1;
  border-radius: 50%; overflow: visible;
  cursor: pointer; user-select: none;
  -webkit-tap-highlight-color: transparent;
  transition: transform 0.2s cubic-bezier(0.16,1,0.3,1);
}
.sg-hole:hover { transform: scale(1.06); }
.sg-hole:active { transform: scale(0.94); }

.sg-hole-inner {
  position: absolute; inset: 0; border-radius: 50%;
  background: radial-gradient(ellipse at 35% 30%, rgba(35,40,55,0.92), rgba(8,10,18,0.98) 75%);
  border: 2px solid rgba(255,255,255,0.07);
  box-shadow: inset 0 8px 22px rgba(0,0,0,0.75), inset 0 -3px 8px rgba(255,255,255,0.02);
  transition: all 0.25s;
  overflow: hidden;
}
.sg-hole-shine {
  position: absolute; top: 10%; left: 15%; width: 35%; height: 25%;
  border-radius: 50%; background: rgba(255,255,255,0.05);
  pointer-events: none;
}

.sg-hole.hit .sg-hole-inner  { border-color: rgba(34,211,238,0.5); box-shadow: inset 0 8px 22px rgba(0,0,0,0.75), 0 0 25px rgba(34,211,238,0.3); }
.sg-hole.bad .sg-hole-inner  { border-color: rgba(239,68,68,0.5);  box-shadow: inset 0 8px 22px rgba(0,0,0,0.75), 0 0 25px rgba(239,68,68,0.3); }
.sg-hole.glow .sg-hole-inner { border-color: rgba(var(--gc,34,211,238),0.3); }

.sg-mole {
  position: absolute; inset: 0; display: flex;
  flex-direction: column; align-items: center; justify-content: center;
  gap: 4px; pointer-events: none; z-index: 2;
  transform: translateY(110%) translateZ(-50px) rotateX(-20deg) scale(0.5); opacity: 0;
  transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.2s;
  transform-style: preserve-3d;
}
.sg-mole.up { transform: translateY(-8%) translateZ(20px) rotateX(0deg) scale(1); opacity: 1; }
.sg-mole.out { transform: translateY(-30%) translateZ(100px) rotateY(180deg) scale(0); opacity: 0; transition: transform 0.3s, opacity 0.2s; }

/* Tech badge inside hole */
.sg-badge-inner {
  width: 65px; height: 65px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  position: relative; 
  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.2), rgba(0,0,0,0.4));
  box-shadow: 
    inset -5px -5px 15px rgba(0,0,0,0.6), 
    inset 5px 5px 15px rgba(255,255,255,0.1),
    0 10px 30px rgba(0,0,0,0.5);
  transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1);
  transform-style: preserve-3d;
}
.sg-badge-inner::before {
  content: ''; position: absolute; top: 15%; left: 15%; width: 30%; height: 30%;
  background: radial-gradient(circle, rgba(255,255,255,0.4) 0%, transparent 70%);
  border-radius: 50%; pointer-events: none; z-index: 5;
}

/* Funny Googly Eyes for Bugs */
.sg-eyes {
  position: absolute; top: 20%; left: 50%; transform: translateX(-50%);
  display: none; gap: 4px; pointer-events: none; z-index: 10;
}
.sg-mole.bug .sg-eyes { display: flex; }
.sg-eye {
  width: 14px; height: 14px; background: white; border-radius: 50%;
  position: relative; border: 1px solid #000;
}
.sg-eye::after {
  content: ''; position: absolute; width: 6px; height: 6px; background: black;
  border-radius: 50%; top: 20%; left: 20%; animation: sg-eye-roll 1.5s infinite linear;
}
@keyframes sg-eye-roll {
  0%, 100% { transform: translate(0, 0); }
  25% { transform: translate(3px, 1px); }
  50% { transform: translate(1px, 4px); }
  75% { transform: translate(-2px, 2px); }
}

.sg-badge-inner svg { position: relative; z-index: 1; filter: drop-shadow(0 5px 5px rgba(0,0,0,0.5)); transform: translateZ(10px); }

.sg-tech-lbl {
  font-family: 'JetBrains Mono', monospace;
  font-size: 7px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase;
  color: #fff; padding: 3px 9px; border-radius: 8px;
  background: rgba(0,0,0,0.65); backdrop-filter: blur(4px);
  border: 1px solid rgba(255,255,255,0.08);
}

/* Rarities */
.sg-mole.common .sg-badge-inner  { box-shadow: 0 8px 28px rgba(0,0,0,0.55), 0 0 0 1.5px rgba(148,163,184,0.25); animation: sg-bouncy 2s ease-in-out infinite; }
.sg-mole.rare   .sg-badge-inner  { box-shadow: 0 8px 28px rgba(0,0,0,0.55), 0 0 0 2px rgba(59,130,246,0.4), 0 0 18px rgba(59,130,246,0.2); animation: sg-bouncy 1.5s ease-in-out infinite; }
.sg-mole.epic   .sg-badge-inner  { box-shadow: 0 8px 28px rgba(0,0,0,0.55), 0 0 0 2px rgba(167,139,250,0.5), 0 0 28px rgba(167,139,250,0.25); animation: sg-epic 0.65s ease-in-out infinite alternate, sg-bouncy 1s ease-in-out infinite; }
.sg-mole.legend .sg-badge-inner  { box-shadow: 0 8px 28px rgba(0,0,0,0.55), 0 0 0 2.5px rgba(251,191,36,0.65), 0 0 45px rgba(251,191,36,0.3); animation: sg-legend 0.45s ease-in-out infinite alternate, sg-bouncy 0.8s ease-in-out infinite; }
.sg-mole.bug    .sg-badge-inner  { box-shadow: 0 8px 28px rgba(0,0,0,0.55), 0 0 0 2px rgba(239,68,68,0.5), 0 0 22px rgba(239,68,68,0.2); animation: sg-bugshake 0.12s ease-in-out infinite; filter: hue-rotate(90deg); }

@keyframes sg-bouncy { 
    0%, 100% { transform: translateY(0) rotate(0); } 
    25% { transform: translateY(-5px) rotate(-2deg); } 
    75% { transform: translateY(5px) rotate(2deg); } 
}

@keyframes sg-epic   { from { transform: scale(1) rotate(-1.5deg); } to { transform: scale(1.07) rotate(1.5deg); } }
@keyframes sg-legend { from { transform: scale(1) rotate(-2deg); filter: brightness(1); } to { transform: scale(1.09) rotate(2deg); filter: brightness(1.2); } }
@keyframes sg-bugshake { 0%,100% { transform: rotate(0); } 25% { transform: rotate(-12deg); } 75% { transform: rotate(12deg); } }

/* ── OVERLAY ───────────────────────────────────────── */
.sg-overlay {
  position: absolute; inset: 0; z-index: 50; border-radius: 24px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(2,2,8,0.96); backdrop-filter: blur(28px);
  transition: opacity 0.4s, visibility 0.4s;
}
.sg-overlay.hidden { opacity: 0; visibility: hidden; pointer-events: none; }

.sg-ov-box {
  text-align: center; padding: 24px 20px;
  animation: sg-ov-in 0.6s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes sg-ov-in { from { transform: scale(0.6) translateY(30px); opacity: 0; } to { transform: none; opacity: 1; } }

.sg-ov-icon {
  font-size: 2.8rem; margin-bottom: 12px; display: block;
  animation: sg-bounce 1.5s ease-in-out infinite;
}
@keyframes sg-bounce { 0%,100% { transform: translateY(0) rotate(-5deg); } 50% { transform: translateY(-12px) rotate(5deg); } }

.sg-ov-title {
  font-family: 'Outfit', sans-serif; font-weight: 900;
  font-size: clamp(1.4rem, 4vw, 2rem); letter-spacing: -0.03em; margin-bottom: 8px;
  background: linear-gradient(135deg, #22d3ee, #a78bfa, #f97316);
  background-size: 200% 200%; -webkit-background-clip: text;
  -webkit-text-fill-color: transparent; background-clip: text;
  animation: sg-grad 4s ease infinite;
}
.sg-ov-sub {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9.5px; color: rgba(255,255,255,0.3); letter-spacing: 0.1em;
  text-transform: uppercase; margin-bottom: 16px; line-height: 1.8;
}
.sg-ov-new { color: #fbbf24 !important; font-weight: 700; }

.sg-ov-stats {
  display: flex; justify-content: center; gap: 8px; margin-bottom: 16px; flex-wrap: wrap;
}
.sg-ov-stat {
  padding: 10px 14px; border-radius: 12px;
  background: rgba(255,255,255,0.025);
  border: 1px solid rgba(255,255,255,0.07); min-width: 70px;
  transition: transform 0.25s;
}
.sg-ov-stat:hover { transform: translateY(-3px) scale(1.05); }
.sg-ov-stat-v { font-family: 'Syne', sans-serif; font-weight: 900; font-size: 1.4rem; color: #fbbf24; }
.sg-ov-stat-l { font-family: 'JetBrains Mono', monospace; font-size: 7px; color: rgba(255,255,255,0.25); letter-spacing: 0.15em; text-transform: uppercase; margin-top: 3px; }

.sg-play-btn {
  position: relative; display: inline-flex; align-items: center; gap: 10px;
  padding: 14px 36px; border: none; border-radius: 999px; cursor: pointer;
  font-family: 'Outfit', sans-serif; font-weight: 900;
  font-size: 0.95rem; letter-spacing: 0.15em; text-transform: uppercase; color: #fff;
  background: linear-gradient(135deg, #22d3ee, #a78bfa, #f97316);
  background-size: 200% 200%;
  box-shadow: 0 12px 40px rgba(34,211,238,0.3);
  animation: sg-grad 4s ease infinite, sg-playfloat 2.5s ease-in-out infinite;
  transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s;
  overflow: hidden;
}
.sg-play-btn::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  transform: translateX(-100%); animation: sg-btnshine 3.5s infinite;
}
@keyframes sg-btnshine { 0%,60%,100% { transform: translateX(-100%); } 30% { transform: translateX(100%); } }
@keyframes sg-playfloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
.sg-play-btn:hover { transform: translateY(-6px) scale(1.05); box-shadow: 0 18px 55px rgba(34,211,238,0.45); animation: sg-grad 4s ease infinite; }
.sg-play-btn:active { transform: scale(0.96); }
.sg-play-glow {
  position: absolute; inset: -2px; border-radius: 999px;
  background: linear-gradient(135deg, #22d3ee, #a78bfa, #f97316);
  filter: blur(12px); opacity: 0.35; z-index: -1;
  animation: sg-grad 4s ease infinite;
}
.sg-play-icon { font-size: 1rem; }

.sg-legend {
  display: flex; justify-content: center; gap: 8px; flex-wrap: wrap;
  margin-top: 14px;
}
.sg-leg {
  display: flex; align-items: center; gap: 5px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 8.5px; color: rgba(255,255,255,0.3);
  padding: 4px 10px; border-radius: 999px;
  background: rgba(255,255,255,0.025);
  border: 1px solid rgba(255,255,255,0.05);
}
.sg-leg-bad { border-color: rgba(239,68,68,0.2); background: rgba(239,68,68,0.05); }
.sg-leg-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

/* ── STACK BAR ─────────────────────────────────────── */
.sg-stack {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 16px; border-radius: 14px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  backdrop-filter: blur(12px);
  min-height: 60px; overflow-x: auto;
}
.sg-stack::-webkit-scrollbar { height: 3px; }
.sg-stack::-webkit-scrollbar-thumb { background: linear-gradient(90deg,#22d3ee,#a78bfa); border-radius: 2px; }

.sg-stack-lbl {
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 7px; letter-spacing: 0.15em; text-transform: uppercase;
  color: rgba(255,255,255,0.18); flex-shrink: 0;
}
.sg-stack-lbl svg { color: rgba(255,255,255,0.25); }
.sg-stack-lbl span {
  font-size: 9px; font-weight: 700; color: #22d3ee;
  background: rgba(34,211,238,0.1); padding: 1px 6px; border-radius: 6px;
}
.sg-stack-chips {
  display: flex; gap: 6px; align-items: center; flex-wrap: nowrap;
}
.sg-stack-empty {
  font-family: 'JetBrains Mono', monospace;
  font-size: 8.5px; color: rgba(255,255,255,0.12);
  font-style: italic; white-space: nowrap;
}
.sg-chip {
  width: 38px; height: 38px; border-radius: 11px; flex-shrink: 0;
  display: grid; place-items: center; position: relative;
  border: 1px solid rgba(255,255,255,0.14);
  box-shadow: 0 5px 16px rgba(0,0,0,0.4);
  animation: sg-chippop 0.45s cubic-bezier(0.34,1.56,0.64,1);
  cursor: default; transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
  overflow: hidden;
}
.sg-chip::after { content: ''; position: absolute; inset: 0; background: linear-gradient(145deg, rgba(255,255,255,0.2), transparent 55%); pointer-events: none; }
.sg-chip:hover { transform: scale(1.25) translateY(-6px) rotate(-5deg); z-index: 10; }
.sg-chip svg { position: relative; z-index: 1; }
@keyframes sg-chippop { from { transform: scale(0) rotate(-180deg); } 60% { transform: scale(1.2) rotate(10deg); } to { transform: scale(1); } }

/* ── EFFECTS ───────────────────────────────────────── */
.sg-float {
  position: absolute; pointer-events: none; font-weight: 900;
  font-size: 1.4rem; z-index: 60;
  animation: sg-floatup 0.9s ease-out forwards;
  text-shadow: 0 0 20px currentColor;
}
@keyframes sg-floatup {
  0% { transform: translateX(-50%) translateY(0) scale(0.5); opacity: 0; }
  12% { transform: translateX(-50%) translateY(-8px) scale(1.4); opacity: 1; }
  100% { transform: translateX(-50%) translateY(-65px) scale(0.5); opacity: 0; }
}

.sg-bonk {
  position: absolute; pointer-events: none; z-index: 60; font-size: 1.6rem;
  animation: sg-bonkanim 0.55s ease-out forwards;
}
@keyframes sg-bonkanim {
  0% { transform: scale(0) rotate(-30deg); opacity: 1; }
  35% { transform: scale(1.3); }
  100% { transform: scale(0.1) rotate(-20deg) translateY(-40px); opacity: 0; }
}

.sg-spark {
  position: absolute; pointer-events: none; border-radius: 50%; z-index: 55;
  animation: sg-sparkfly 0.65s ease-out forwards;
}
@keyframes sg-sparkfly {
  0% { transform: translate(0,0) scale(1); opacity: 1; }
  100% { transform: translate(var(--sx),var(--sy)) scale(0); opacity: 0; }
}

.sg-combo-txt {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%); pointer-events: none; z-index: 70;
  font-family: 'Outfit', sans-serif; font-weight: 900;
  font-size: clamp(1.8rem, 6vw, 3rem); white-space: nowrap;
  text-shadow: 0 0 40px currentColor;
  animation: sg-combopop 0.9s cubic-bezier(0.34,1.56,0.64,1) forwards;
}
@keyframes sg-combopop {
  0% { transform: translate(-50%,-50%) scale(0) rotate(-20deg); opacity: 0; filter: blur(10px); }
  20% { transform: translate(-50%,-50%) scale(1.8) rotate(10deg); opacity: 1; filter: blur(0); }
  100% { transform: translate(-50%,-120%) scale(0.5); opacity: 0; filter: blur(4px); }
}

.sg-overdrive {
  animation: sg-shake 0.1s infinite;
  box-shadow: 0 0 100px rgba(123,47,247,0.4) !important;
}

.sg-hit-bg {
  position: absolute; inset: 0; background: rgba(255,255,255,0.1);
  pointer-events: none; opacity: 0; z-index: 100;
}
.sg-hit-bg.active { animation: sg-flash 0.15s ease-out; }
@keyframes sg-flash { 0% { opacity: 0.8; scale: 1; } 100% { opacity: 0; scale: 1.2; } }

.sg-flash {
  position: fixed; inset: 0; pointer-events: none; z-index: 400;
  animation: sg-flashout 0.3s ease-out forwards;
}
@keyframes sg-flashout { 0% { opacity: 0.6; } 100% { opacity: 0; } }

/* ── FOOTER ────────────────────────────────────────── */
.sg-footer { text-align: center; }
.sg-quote {
  font-family: 'JetBrains Mono', monospace;
  font-size: 8.5px; color: rgba(255,255,255,0.14);
  font-style: italic; letter-spacing: 0.06em; line-height: 1.7;
  padding: 10px 18px; border-radius: 10px;
  background: rgba(255,255,255,0.01);
  border: 1px dashed rgba(255,255,255,0.05); display: inline-block;
  transition: color 0.3s;
}
.sg-quote:hover { color: rgba(255,255,255,0.25); }
.sg-mini-stats {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  margin-top: 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 8px; color: rgba(255,255,255,0.14);
}
.sg-mini-stats strong { color: rgba(255,255,255,0.28); }
.sg-dot-sep { opacity: 0.3; }

/* ── UTILS ─────────────────────────────────────────── */
@keyframes sg-up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
@keyframes sg-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
@keyframes sg-shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(200%); } }
@keyframes sg-shake { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-5px)} 60%{transform:translateX(5px)} }

/* ── RESPONSIVE ────────────────────────────────────── */
@media (max-width: 560px) {
  .sg { padding: 3rem 0 2.5rem; }
  .sg-hud { grid-template-columns: repeat(2,1fr); }
  .sg-board { gap: 8px; padding: 14px; border-radius: 18px; }
  .sg-badge-inner { width: 46px; height: 46px; border-radius: 14px; }
  .sg-badge-inner svg { width: 20px !important; height: 20px !important; }
  .sg-tech-lbl { font-size: 6px; padding: 2px 6px; }
  .sg-ov-box { padding: 18px 14px; }
  .sg-ov-icon { font-size: 2.2rem; }
}
@media (max-width: 380px) {
  .sg-board { gap: 6px; padding: 10px; }
  .sg-badge-inner { width: 40px; height: 40px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}
