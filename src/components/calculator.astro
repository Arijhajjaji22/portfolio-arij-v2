/* ══ FUNNY SOUNDS ═══════════════════════════════════════ */
let aC=null;
function getAC(){
  if(!aC) aC=new(window.AudioContext||window.webkitAudioContext)();
  if(aC.state==='suspended') aC.resume();
  return aC;
}

const SFX={
  // common: satisfying "ding"
  common(c){
    const o=c.createOscillator(),g=c.createGain();
    o.connect(g);g.connect(c.destination);
    o.frequency.setValueAtTime(880,c.currentTime);
    o.frequency.exponentialRampToValueAtTime(440,c.currentTime+0.12);
    g.gain.setValueAtTime(0.18,c.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001,c.currentTime+0.2);
    o.start();o.stop(c.currentTime+0.2);
  },
  // rare: cool synth blip
  rare(c){
    const o=c.createOscillator(),g=c.createGain(),f=c.createBiquadFilter();
    f.type='bandpass';f.frequency.value=1200;f.Q.value=2;
    o.connect(f);f.connect(g);g.connect(c.destination);
    o.type='sawtooth';
    o.frequency.setValueAtTime(600,c.currentTime);
    o.frequency.exponentialRampToValueAtTime(1200,c.currentTime+0.08);
    g.gain.setValueAtTime(0.15,c.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001,c.currentTime+0.25);
    o.start();o.stop(c.currentTime+0.25);
  },
  // epic: power-up ascending chord
  epic(c){
    [0,4,7].forEach((note,k)=>{
      const o=c.createOscillator(),g=c.createGain();
      o.connect(g);g.connect(c.destination);
      o.type='triangle';
      const freq=440*Math.pow(2,note/12);
      o.frequency.setValueAtTime(freq,c.currentTime+k*0.06);
      g.gain.setValueAtTime(0,c.currentTime+k*0.06);
      g.gain.linearRampToValueAtTime(0.14,c.currentTime+k*0.06+0.02);
      g.gain.exponentialRampToValueAtTime(0.001,c.currentTime+k*0.06+0.22);
      o.start(c.currentTime+k*0.06);
      o.stop(c.currentTime+k*0.06+0.25);
    });
  },
  // legend: triumphant fanfare + sparkle
  legend(c){
    [0,7,12,16].forEach((note,k)=>{
      const o=c.createOscillator(),g=c.createGain();
      o.connect(g);g.connect(c.destination);
      o.type='sine';
      const freq=523.25*Math.pow(2,note/12);
      o.frequency.setValueAtTime(freq,c.currentTime+k*0.09);
      o.frequency.setValueAtTime(freq*1.01,c.currentTime+k*0.09+0.04);
      g.gain.setValueAtTime(0,c.currentTime+k*0.09);
      g.gain.linearRampToValueAtTime(0.22,c.currentTime+k*0.09+0.03);
      g.gain.exponentialRampToValueAtTime(0.001,c.currentTime+k*0.09+0.35);
      o.start(c.currentTime+k*0.09);
      o.stop(c.currentTime+k*0.09+0.38);
    });
    // sparkle on top
    const o2=c.createOscillator(),g2=c.createGain();
    o2.connect(g2);g2.connect(c.destination);
    o2.type='sine';
    o2.frequency.setValueAtTime(2093,c.currentTime+0.1);
    o2.frequency.exponentialRampToValueAtTime(3000,c.currentTime+0.5);
    g2.gain.setValueAtTime(0.08,c.currentTime+0.1);
    g2.gain.exponentialRampToValueAtTime(0.001,c.currentTime+0.55);
    o2.start(c.currentTime+0.1);o2.stop(c.currentTime+0.6);
  },
  // bug: cartoon "bwonk" fail sound
  bug(c){
    const o=c.createOscillator(),g=c.createGain();
    o.connect(g);g.connect(c.destination);
    o.type='sawtooth';
    o.frequency.setValueAtTime(280,c.currentTime);
    o.frequency.exponentialRampToValueAtTime(60,c.currentTime+0.35);
    g.gain.setValueAtTime(0.28,c.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001,c.currentTime+0.4);
    o.start();o.stop(c.currentTime+0.4);
    // extra "splat" noise
    const buf=c.createBuffer(1,c.sampleRate*0.05,c.sampleRate);
    const d=buf.getChannelData(0);
    for(let i=0;i<d.length;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/d.length,2);
    const src=c.createBufferSource(),g2=c.createGain();
    src.buffer=buf;src.connect(g2);g2.connect(c.destination);
    g2.gain.setValueAtTime(0.4,c.currentTime+0.05);
    src.start(c.currentTime+0.05);
  },
  // miss: short soft thud
  miss(c){
    const buf=c.createBuffer(1,c.sampleRate*0.06,c.sampleRate);
    const d=buf.getChannelData(0);
    for(let i=0;i<d.length;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/d.length,3);
    const src=c.createBufferSource(),g=c.createGain(),f=c.createBiquadFilter();
    f.type='lowpass';f.frequency.value=300;
    src.buffer=buf;src.connect(f);f.connect(g);g.connect(c.destination);
    g.gain.setValueAtTime(0.25,c.currentTime);
    src.start();
  },
};

function playSound(type){
  try{ SFX[type]?.(getAC()); }catch(e){}
}

