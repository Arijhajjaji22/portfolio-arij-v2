/* ══ STATUS ═════════════════════════════════════════════ */
function setStatus(type,msg){
  clearTimeout(stTO);
  const txt=msg||rf(STATUS[type]||STATUS.idle);
  if(elStxt) elStxt.textContent=txt;
  if(elStatus){
    elStatus.className='sg-status';
    if(type==='good'||type==='play') elStatus.classList.add('ok');
    else if(type==='bug'||type==='low') elStatus.classList.add('bad');
    else if(type==='epic'||type==='legend') elStatus.classList.add('epic');
  }
  if(type!=='play'&&type!=='idle'&&type!=='low'){
    stTO=setTimeout(()=>{if(active)setStatus('play');},2200);
  }
}

/* ══ CANVAS BG ══════════════════════════════════════════ */
(function(){
  const cv=document.getElementById('sg-cv'); if(!cv) return;
  const ctx=cv.getContext('2d'); let W,H,pts=[];
  const COLS=['#22d3ee','#a78bfa','#f97316','#4ade80','#fbbf24'];
  function init(){
    const r=cv.parentElement.getBoundingClientRect();
    W=cv.width=r.width; H=cv.height=r.height; pts=[];
    for(let i=0;i<55;i++){
      const c=COLS[Math.floor(Math.random()*COLS.length)];
      pts.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.4,vy:(Math.random()-.5)*.4,r:Math.random()*1.8+0.5,a:Math.random()*.2+.04,c});
    }
  }
  init();
  function draw(){
    ctx.clearRect(0,0,W,H);
    for(let i=0;i<pts.length;i++){
      const p=pts[i]; p.x+=p.vx; p.y+=p.vy;
      if(p.x<0)p.x=W; if(p.x>W)p.x=0; if(p.y<0)p.y=H; if(p.y>H)p.y=0;
      ctx.globalAlpha=p.a; ctx.fillStyle=p.c;
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fill();
      for(let j=i+1;j<pts.length;j++){
        const q=pts[j],dx=p.x-q.x,dy=p.y-q.y,d=Math.sqrt(dx*dx+dy*dy);
        if(d<130){ctx.globalAlpha=.035*(1-d/130);ctx.strokeStyle=p.c;ctx.lineWidth=.5;ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);ctx.stroke();}
      }
    }
    ctx.globalAlpha=1; requestAnimationFrame(draw);
  }
  draw();
  let rt; window.addEventListener('resize',()=>{clearTimeout(rt);rt=setTimeout(init,250);},{passive:true});
})();

/* Matrix rain */
(function(){
  const mc=document.getElementById('sg-mat'); if(!mc) return;
  const ctx=mc.getContext('2d'); let W,H,drops;
  const chars='01アイウカキ<>{}[]';
  function init(){const r=mc.parentElement.getBoundingClientRect();W=mc.width=r.width;H=mc.height=r.height;drops=Array.from({length:Math.floor(W/16)},()=>Math.random()*-50);}
  init();
  setInterval(()=>{
    ctx.fillStyle='rgba(2,2,8,0.055)';ctx.fillRect(0,0,W,H);
    ctx.font='12px "JetBrains Mono",monospace';
    drops.forEach((y,i)=>{
      const ch=chars[Math.floor(Math.random()*chars.length)];
      const r=Math.random();
      ctx.fillStyle=r<.4?`rgba(34,211,238,${.18+Math.random()*.28})`:r<.65?`rgba(167,139,250,${.15+Math.random()*.22})`:`rgba(96,165,250,${.12+Math.random()*.2})`;
      ctx.fillText(ch,i*16,y*16);
      if(y*16>H&&Math.random()>.978)drops[i]=0;
      drops[i]+=.22+Math.random()*.12;
    });
  },80);
  let rt; window.addEventListener('resize',()=>{clearTimeout(rt);rt=setTimeout(init,250);},{passive:true});
})();

/* ══ GAME LOGIC ═════════════════════════════════════════ */
function startGame(){
  score=streak=maxStreak=totalHits=totalMisses=caughtN=0;
  timeLeft=GTIME; active=true; diff=1; currentLevel=1; moleData.fill(null); caughtSet={};
  moles.forEach(m=>{m.className='sg-mole';m.innerHTML='';});
  holes.forEach(h=>{h.className='sg-hole';});
  if(elChips){elChips.innerHTML='';if(elEmpty){const e=elEmpty.cloneNode(true);e.textContent='acquiring targets...';elChips.appendChild(e);}}
  if(elScount) elScount.textContent='0';
  if(elLevel) elLevel.textContent='1';
  updateHUD();
  if(elOv) elOv.classList.add('hidden');
  setStatus('play');
  clearInterval(tInt); clearTimeout(spawnTO);
  tInt=setInterval(()=>{
    timeLeft-=.1;
    if(timeLeft<=0){timeLeft=0;endGame();return;}
    diff=1+(GTIME-timeLeft)/GTIME*2.8 + (currentLevel * 0.5);
    updateTimer();
    if(timeLeft<=5&&timeLeft>4.9) setStatus('low');
  },100);
  sched();
}

function sched(){
  if(!active)return;
  const d=Math.max(220,900-diff*115);
  spawnTO=setTimeout(()=>{spawn();sched();},d+Math.random()*250);
}

function spawn(){
  if(!active)return;
  const empty=[];
  moleData.forEach((m,i)=>{if(!m)empty.push(i);});
  if(!empty.length)return;
  const idx=empty[Math.floor(Math.random()*empty.length)];
  const r=Math.random();
  const bugC=.14+((diff-1)*.03);
  let t;
  if(r<.03) t=pick('legend');
  else if(r<.1) t=pick('epic');
  else if(r<.1+bugC) t=pick('bug');
  else if(r<.52) t=pick('rare');
  else t=pick('common');

  moleData[idx]={...t,bonked:false,spawn:Date.now()};
  const m=moles[idx];
  m.innerHTML=buildBadge(t);
  m.className=`sg-mole up ${t.t}`;

  const show=t.t==='legend'?750:t.t==='epic'?850:t.t==='bug'?1700:Math.max(550,1300-diff*150);
  ((ii)=>{setTimeout(()=>{if(moleData[ii]&&!moleData[ii].bonked)hideM(ii);},show);})(idx);
}

function pick(type){const a=TECHS.filter(t=>t.t===type);return a[Math.floor(Math.random()*a.length)];}

function buildBadge(t){
  const ico=I[t.k]||'';
  return `<div class="sg-badge-inner" style="background:${t.bg}">${ico}</div><span class="sg-tech-lbl">${t.n}</span>`;
}

function hideM(i){
  moleData[i]=null;
  const m=moles[i]; m.className='sg-mole';
  setTimeout(()=>{if(!moleData[i]){m.innerHTML='';m.className='sg-mole';}},280);
  holes[i].className='sg-hole';
}

function whack(i){
  if(!active)return;
  const t=moleData[i];
  if(!t||t.bonked){
    playSound('miss');
    streak=0; totalMisses++; updateHUD(); return;
  }
  t.bonked=true; totalHits++;
  const h=holes[i], m=moles[i];
  const hr=h.getBoundingClientRect(), br=elBoard.getBoundingClientRect();
  const cx=hr.left-br.left+hr.width/2, cy=hr.top-br.top+hr.height/2;

  m.className=`sg-mole out ${t.t}`;

  if(t.t==='bug'){
    playSound('bug');
    score=Math.max(0,score+t.pts); streak=0;
    h.classList.add('bad');
    floatFx(cx,cy,t.pts,'#ef4444');
    bonkFx(cx,cy,'✕','#ef4444');
    sparks(cx,cy,['#ef4444','#f87171','#fca5a5']);
    elBoard.classList.add('sg-screen-shake');
    flash('rgba(239,68,68,.14)');
    setStatus('bug');
    if(navigator.vibrate) navigator.vibrate(80);
    setTimeout(()=>{h.classList.remove('bad');elBoard.classList.remove('sg-screen-shake');hideM(i);},350);
  } else {
    const mult=1+streak*.2;
    const quick=(Date.now()-t.spawn)<400;
    const pts=Math.round(t.pts*mult*(quick?1.3:1));
    score+=pts; streak++; if(streak>maxStreak) maxStreak=streak;
    h.classList.add('hit');
    // Play sound based on rarity
    playSound(t.t==='legend'?'legend':t.t==='epic'?'epic':t.t==='rare'?'rare':'common');
    const cols=t.t==='legend'?['#fbbf24','#fde68a','#f59e0b']:t.t==='epic'?['#a78bfa','#c4b5fd','#8b5cf6']:['#22d3ee','#67e8f9','#06b6d4'];
    floatFx(cx,cy,pts,t.t==='legend'?'#fbbf24':t.t==='epic'?'#a78bfa':'#4ade80');
    bonkFx(cx,cy,t.t==='legend'?'★':t.t==='epic'?'✦':'✓',cols[0]);
    sparks(cx,cy,cols);
    if(t.t==='legend'){flash('rgba(251,191,36,.1)');sparks(cx,cy,cols);setStatus('legend');}
    else if(t.t==='epic'){flash('rgba(167,139,250,.08)');setStatus('epic');}
    else if(streak>=5) setStatus('play',`STREAK ×${streak}!`);
    else if(Math.random()>.6) setStatus('good');

    COMBOS.forEach(c=>{if(streak===c.at)comboFx(c.txt,c.c);});

    if(t.t==='legend') timeLeft=Math.min(GTIME,timeLeft+5);
    else if(t.t==='epic') timeLeft=Math.min(GTIME,timeLeft+2.5);
    
    // Level Up Logic
    const newLevel = Math.floor(score / 200) + 1;
    if(newLevel > currentLevel) {
       currentLevel = newLevel;
       if(elLevel) {
         elLevel.textContent = currentLevel;
         elLevel.classList.add('pop');
         setTimeout(() => elLevel.classList.remove('pop'), 300);
       }
       comboFx(`LEVEL ${currentLevel}!`, '#fbbf24');
       if(currentLevel >= 3) elBoard.classList.add('sg-overdrive');
       setStatus('epic', `LEVEL UP! SPEED++`);
    }

    if(!caughtSet[t.n]){addChip(t);caughtSet[t.n]=true;caughtN++;}
    setTimeout(()=>{h.classList.remove('hit');hideM(i);},280);
    
    // Visual hit flash
    if(elFxBg) {
      elFxBg.classList.add('active');
      setTimeout(() => elFxBg.classList.remove('active'), 200);
    }
  }
  updateHUD();
}

function addChip(t){
  const emp=elChips.querySelector('.sg-stack-empty');
  if(emp) emp.remove();
  const ch=document.createElement('div');
  ch.className='sg-chip'; ch.style.background=t.bg;
  const ico=I[t.k]||'';
  const tmp=document.createElement('div'); tmp.innerHTML=ico;
  const s=tmp.querySelector('svg');
  if(s){s.setAttribute('width','18');s.setAttribute('height','18');}
  ch.innerHTML=tmp.innerHTML;
  ch.title=`${t.n} +${t.pts}`;
  elChips.appendChild(ch);
  if(elScount) elScount.textContent=caughtN+1;
  const sb=document.getElementById('sg-stack');
  if(sb) sb.scrollLeft=sb.scrollWidth;
}

function updateHUD(){
  if(elScore){elScore.textContent=score;elScore.classList.add('pop');setTimeout(()=>elScore.classList.remove('pop'),140);}
}
function updateTimer(){
  if(elTime) elTime.textContent=Math.ceil(timeLeft);
  if(elTbar){
    elTbar.style.width=((timeLeft/GTIME)*100)+'%';
    if(timeLeft<=5) elTbar.classList.add('urgent');
    else elTbar.classList.remove('urgent');
  }
  if(elTime){
    if(timeLeft<=5) elTime.style.color='#ef4444';
    else if(timeLeft<=10) elTime.style.color='#fbbf24';
    else elTime.style.color='#22d3ee';
  }
}

function endGame(){
  active=false; clearInterval(tInt); clearTimeout(spawnTO); clearTimeout(stTO);
  moleData.forEach((_,i)=>{if(moleData[i])hideM(i);});
  const isNew=score>best;
  if(isNew){best=score;localStorage.setItem('sa-best',String(best));if(elBest)elBest.textContent=best;}
  gamesPlayed++; lifetime+=score;
  localStorage.setItem('sa-games',String(gamesPlayed));
  localStorage.setItem('sa-lifetime',String(lifetime));
  if(elRuns) elRuns.textContent=gamesPlayed;
  if(elTotal) elTotal.textContent=lifetime.toLocaleString();

  let m=END[0];
  for(let i=END.length-1;i>=0;i--){if(score>=END[i].min){m=END[i];break;}}

  const acc=totalHits+totalMisses>0?Math.round(totalHits/(totalHits+totalMisses)*100):0;
  const accC=acc>=90?'#4ade80':acc>=70?'#fbbf24':acc>=50?'#f97316':'#f87171';

  if(elOvIcon) elOvIcon.textContent=m.ico;
  if(elOvTitle) elOvTitle.textContent=m.ti;
  if(elOvSub) elOvSub.innerHTML=`${m.su}<br><span class="sg-ov-new">${isNew?'★ NEW PERSONAL BEST ★':'try again?'}</span>`;
  if(elOvStats) elOvStats.innerHTML=`
    <div class="sg-ov-stat"><div class="sg-ov-stat-v">${score}</div><div class="sg-ov-stat-l">Score</div></div>
    <div class="sg-ov-stat"><div class="sg-ov-stat-v">${caughtN}</div><div class="sg-ov-stat-l">Techs</div></div>
    <div class="sg-ov-stat"><div class="sg-ov-stat-v">${maxStreak}×</div><div class="sg-ov-stat-l">Streak</div></div>
    <div class="sg-ov-stat"><div class="sg-ov-stat-v" style="color:${accC}">${acc}%</div><div class="sg-ov-stat-l">Accuracy</div></div>
  `;
  if(elPlayTxt) elPlayTxt.textContent=isNew?'BEAT IT!':'TRY AGAIN';
  if(elOv) elOv.classList.remove('hidden');
  if(score>=200) confetti();
  setStatus('idle',isNew?'new record! play again?':'gg. another round?');
  if(elQuote) elQuote.textContent=rf(QUOTES);
}

