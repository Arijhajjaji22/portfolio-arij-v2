---
// Footer Component - Premium Animated Version
const navLinks = ["about", "journey", "experience", "projects", "skills", "contact"];

const socials = [
  { name: "GitHub", icon: "devicon-github-original", url: "https://github.com/Arijhajjaji22", color: "#fff" },
  { name: "LinkedIn", icon: "devicon-linkedin-plain", url: "https://linkedin.com/in/arij-hajjaji", color: "#0A66C2" },
  { name: "Email", icon: "devicon-google-plain", url: "mailto:arijhajjaji2@gmail.com", color: "#EA4335" }
];

const stack = [
  { name: "Spring Boot", icon: "devicon-spring-plain", color: "#6DB33F" },
  { name: "Angular", icon: "devicon-angularjs-plain", color: "#DD0031" },
  { name: ".NET Core", icon: "devicon-dotnetcore-plain", color: "#512BD4" },
  { name: "Docker", icon: "devicon-docker-plain", color: "#2496ED" },
  { name: "PostgreSQL", icon: "devicon-postgresql-plain", color: "#4169E1" },
  { name: "TypeScript", icon: "devicon-typescript-plain", color: "#3178C6" },
  { name: "Elasticsearch", icon: "devicon-elasticsearch-plain", color: "#005571" },
  { name: "Redis", icon: "devicon-redis-plain", color: "#DC382D" }
];

const currentYear = new Date().getFullYear();
---

<footer class="relative bg-[#08080a] overflow-hidden" id="footer-section">
  <!-- ANIMATED BACKGROUND -->
  <div class="absolute inset-0 pointer-events-none">
    <!-- Mesh Gradient Background -->
    <canvas id="footer-mesh" class="absolute inset-0 w-full h-full opacity-30"></canvas>
    
    <!-- Floating Orbs -->
    <div class="absolute top-0 left-1/3 w-[400px] h-[400px] bg-purple-500/[0.04] rounded-full blur-[100px] animate-float-1"></div>
    <div class="absolute bottom-0 right-1/3 w-[350px] h-[350px] bg-blue-500/[0.04] rounded-full blur-[80px] animate-float-2"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-indigo-500/[0.03] rounded-full blur-[120px] animate-float-3"></div>
    
    <!-- Animated Lines -->
    <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="line-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" style="stop-color:transparent" />
          <stop offset="50%" style="stop-color:rgba(123,47,247,0.3)" />
          <stop offset="100%" style="stop-color:transparent" />
        </linearGradient>
      </defs>
      <line x1="0" y1="20%" x2="100%" y2="20%" stroke="url(#line-gradient)" stroke-width="1" class="animate-line-1" />
      <line x1="0" y1="50%" x2="100%" y2="50%" stroke="url(#line-gradient)" stroke-width="1" class="animate-line-2" />
      <line x1="0" y1="80%" x2="100%" y2="80%" stroke="url(#line-gradient)" stroke-width="1" class="animate-line-3" />
    </svg>
    
    <!-- Grid -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:80px_80px] [mask-image:radial-gradient(ellipse_at_center,black_10%,transparent_60%)]"></div>
  </div>

  <!-- Tech Stack Marquee -->
  <div class="relative py-6 border-y border-white/[0.04] overflow-hidden mb-16">
    <div class="absolute left-0 top-0 bottom-0 w-32 bg-gradient-to-r from-[#020204] to-transparent z-10"></div>
    <div class="absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-[#020204] to-transparent z-10"></div>
    
    <div class="marquee-track flex gap-12 items-center whitespace-nowrap">
      {[...stack, ...stack, ...stack, ...stack].map((tech) => (
        <div class="flex items-center gap-3 group cursor-default" key={tech.name}>
          <div class="w-8 h-8 rounded-lg bg-white/[0.03] border border-white/[0.06] flex items-center justify-center group-hover:border-purple-500/30 group-hover:bg-white/[0.05] transition-all">
            <i class={`${tech.icon} text-base text-gray-600 group-hover:text-purple-400 transition-colors`}></i>
          </div>
          <span class="text-xs font-mono text-gray-600 uppercase tracking-wider group-hover:text-white transition-colors">
            {tech.name}
          </span>
          <span class="text-purple-500/30 mx-2">→</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Main Content -->
  <div class="container mx-auto px-6 lg:px-10 pb-20 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Brand Section -->
      <div class="lg:col-span-4 space-y-8">
        <a href="#home" class="flex items-center gap-4 group w-fit">
          <div class="relative w-14 h-14 rounded-xl overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-purple-500 via-blue-500 to-blue-500 opacity-40 group-hover:opacity-80 group-hover:scale-110 transition-all duration-300"></div>
            <div class="absolute inset-[1px] rounded-xl bg-[#0a0a10] flex items-center justify-center">
              <span class="text-2xl font-black font-outfit text-transparent bg-clip-text bg-gradient-to-br from-white to-blue-300">A</span>
            </div>
          </div>
          
          <div>
            <span class="block text-lg font-bold font-outfit text-white tracking-tight group-hover:text-purple-400 transition-colors uppercase">ARIJ HAJJAJI</span>
            <span class="text-[9px] font-mono text-purple-500/60 uppercase tracking-[0.3em] font-bold">Software Engineer</span>
          </div>
        </a>

        <p class="text-gray-500 text-sm leading-relaxed max-w-sm">
          Building <span class="text-white font-semibold">scalable systems</span> with precision and <span class="text-blue-400 font-semibold">creative innovation</span>. Specializing in full-stack development and cloud architecture.
        </p>

        <!-- Social Links -->
        <div class="flex gap-3">
          {socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group w-11 h-11 rounded-lg bg-white/[0.02] border border-white/[0.06] flex items-center justify-center text-gray-500 hover:text-white hover:border-purple-500/30 hover:bg-purple-500/5 transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-500/20"
              aria-label={s.name}
            >
              <i class={`${s.icon} text-lg`}></i>
            </a>
          ))}
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-white/[0.06]">
          <div>
    
          
      
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div class="lg:col-span-3">
        <div class="text-[9px] font-mono text-gray-600 uppercase tracking-[0.3em] mb-6 flex items-center gap-2">
          <span class="w-6 h-[1px] bg-gray-700"></span>
          <span>Navigate</span>
        </div>
        
        <nav class="grid grid-cols-2 gap-x-6 gap-y-3">
          {navLinks.map((id, i) => (
            <a
              href={`#${id}`}
              class="group flex items-center gap-2 py-2 text-xs font-mono text-gray-500 hover:text-white transition-all hover:translate-x-1 capitalize"
            >
              <span class="text-[9px] text-purple-500/50 group-hover:text-purple-500">0{i + 1}</span>
              <span>{id}</span>
              <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </nav>
      </div>

      <!-- Resources -->
     

      <!-- Live Clock Card -->
      <div class="lg:col-span-3">
        <div class="text-[9px] font-mono text-gray-600 uppercase tracking-[0.3em] mb-6 flex items-center gap-2">
          <span class="w-6 h-[1px] bg-gray-700"></span>
          <span>Local Time</span>
        </div>
        
        <div class="p-6 rounded-xl bg-white/[0.02] border border-white/[0.06] backdrop-blur-sm group hover:border-purple-500/20 transition-all">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-10 h-10 rounded-lg bg-white/[0.03] border border-white/[0.08] flex items-center justify-center">
              <div class="w-2.5 h-2.5 rounded-full bg-green-500 shadow-[0_0_15px_#10b981] animate-pulse"></div>
            </div>
            <div>
              <div id="footer-clock" class="text-2xl font-bold font-outfit text-white tracking-tight tabular-nums">--:--:--</div>
              <div class="text-[9px] font-mono text-gray-600 uppercase tracking-wider">Tunis, Tunisia</div>
            </div>
          </div>
          
          <div class="text-[10px] font-mono text-gray-600">
            <span class="text-green-500">●</span> Available for opportunities
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/[0.04]">
    <div class="container mx-auto px-6 lg:px-10 py-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-[10px] font-mono text-gray-600">
        <div class="flex items-center gap-4">
          <span>© {currentYear}</span>
          <span class="text-white font-semibold">Arij Hajjaji</span>
          <span class="hidden md:inline">•</span>
          <span class="hidden md:inline">All rights reserved</span>
        </div>

        <div class="flex items-center gap-6">
          <a href="#" class="hover:text-white transition-colors">Privacy</a>
          <a href="#" class="hover:text-white transition-colors">Terms</a>
          <div class="flex items-center gap-2">
            <div class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></div>
            <span class="text-purple-500">v2.0.1</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Marquee Animation */
  .marquee-track {
    animation: marquee 60s linear infinite;
    width: max-content;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-25%); }
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  /* Float Animations */
  @keyframes float-1 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(30px, -20px); }
  }

  @keyframes float-2 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-25px, 25px); }
  }

  @keyframes float-3 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50% { transform: translate(-50%, -50%) scale(1.1); }
  }

  .animate-float-1 { animation: float-1 12s ease-in-out infinite; }
  .animate-float-2 { animation: float-2 15s ease-in-out infinite; }
  .animate-float-3 { animation: float-3 20s ease-in-out infinite; }

  /* Line Animations */
  @keyframes line-move {
    0% { stroke-dashoffset: 2000; opacity: 0; }
    50% { opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }

  .animate-line-1, .animate-line-2, .animate-line-3 {
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
  }

  .animate-line-1 { animation: line-move 10s linear infinite; }
  .animate-line-2 { animation: line-move 10s linear infinite 3s; }
  .animate-line-3 { animation: line-move 10s linear infinite 6s; }

  /* Clock Font */
  #footer-clock {
    font-variant-numeric: tabular-nums;
  }
</style>

<script is:inline>
(function() {
  // Mesh Gradient Animation
  const meshCanvas = document.getElementById('footer-mesh');
  if (meshCanvas) {
    const ctx = meshCanvas.getContext('2d');
    let time = 0;

    function resize() {
      meshCanvas.width = meshCanvas.offsetWidth;
      meshCanvas.height = meshCanvas.offsetHeight;
    }

    function drawMesh() {
      ctx.clearRect(0, 0, meshCanvas.width, meshCanvas.height);

      const gradient = ctx.createRadialGradient(
        meshCanvas.width * (0.3 + Math.sin(time * 0.001) * 0.2),
        meshCanvas.height * (0.5 + Math.cos(time * 0.0015) * 0.2),
        0,
        meshCanvas.width / 2,
        meshCanvas.height / 2,
        meshCanvas.width * 0.8
      );

      gradient.addColorStop(0, 'rgba(123, 47, 247, 0.1)');
      gradient.addColorStop(0.5, 'rgba(59, 130, 246, 0.05)');
      gradient.addColorStop(1, 'transparent');

      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, meshCanvas.width, meshCanvas.height);

      time++;
      requestAnimationFrame(drawMesh);
    }

    resize();
    drawMesh();
    window.addEventListener('resize', resize);
  }

  // Footer Clock
  const clockEl = document.getElementById('footer-clock');
  if (clockEl) {
    function tick() {
      const time = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Africa/Tunis',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false
      }).format(new Date());
      
      clockEl.textContent = time;
    }

    setInterval(tick, 1000);
    tick();
  }
})();
</script>
