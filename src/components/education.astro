---
const education = [
  {
    year: "2021 – 2024",
    degree: "Software Engineering Degree",
    specialization: "Engineering Degree — Cycle d'Ingénieur",
    institution: "ESPRIT University",
    details: "Graduated with Highest Honors.",
    status: "COMPLETED",
    color: "#6366f1",
    delay: "0s"
  },
  {
    year: "2020 – 2021",
    degree: "Preparatory Cycle for Engineering",
    specialization: "MPSI — Mathematics, Physics & Engineering Sciences",
    institution: "ULT Preparatory School",
    details: "",
    status: "COMPLETED",
    color: "#3b82f6",
    delay: "0.12s"
  },
  {
    year: "2019",
    degree: "Technical Baccalaureate",
    specialization: "Technical Sciences",
    institution: "Technical High School of Médenine",
    details: "",
    status: "COMPLETED",
    color: "#a78bfa",
    delay: "0.24s"
  }
];
---

<section id="education" class="reveal-section py-24 bg-[#08080a] relative overflow-hidden">
  <!-- 3D BACKGROUND ENGINE -->
  <div id="edu-3d-bg" class="absolute inset-0 z-0 opacity-20 pointer-events-none"></div>

  <!-- Grid overlay -->
  <div class="absolute inset-0 z-0 pointer-events-none"
       style="background-image: linear-gradient(rgba(59,130,246,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(59,130,246,0.04) 1px, transparent 1px); background-size: 60px 60px;">
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl mx-auto">

      <!-- HEADER -->
      <div class="mb-20 reveal">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-px bg-blue-500/40"></div>
          <span class="font-mono text-[10px] uppercase tracking-[0.45em] text-blue-400 font-bold">
            Academic.Framework
          </span>
        </div>
        <h2 class="font-black font-outfit uppercase leading-[0.9] tracking-tight text-[clamp(2rem,5vw,56px)] mb-4">
          <span class="text-white">ACADEMIC</span><br />
          <span class="text-transparent" style="-webkit-text-stroke: 1.5px rgba(139,92,246,0.55)">MILESTONES</span>
        </h2>
        <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-white/20 max-w-md leading-relaxed">
          Official validation of engineering expertise
        </p>
      </div>

      <!-- TIMELINE -->
      <div class="relative">
        <div class="absolute left-[27px] top-6 bottom-6 w-px pointer-events-none"
             style="background: linear-gradient(to bottom, transparent, rgba(99,102,241,0.35) 15%, rgba(59,130,246,0.25) 70%, transparent)">
        </div>

        {education.map((edu, i) => (
          <div class="edu-card flex gap-6 mb-8 group reveal-zoom" style={`transition-delay: ${edu.delay}`}>
            <div class="flex flex-col items-center shrink-0 pt-1">
              <div class="node-ring relative w-[54px] h-[54px] rounded-full bg-[#0a0a14] flex items-center justify-center border border-white/[0.07] transition-all duration-500 group-hover:border-blue-500/50">
                <div class="node-pulse absolute inset-[-5px] rounded-full border border-blue-500/10"></div>
                <div class="w-6 h-6 flex items-center justify-center transition-transform duration-500 group-hover:scale-110 group-hover:rotate-12"
                     style={`color: ${edu.color}`}>
                  {i === 0 ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="drop-shadow-[0_0_8px_rgba(99,102,241,0.5)]"><path d="M22 10v6M2 10l10-5 10 5-10 5-10-5z"/><path d="M6 12v5c3.33 2 8.67 2 12 0v-5"/><path d="M12 22v-5" opacity="0.5"/><circle cx="12" cy="11.5" r="1.5" fill="currentColor" opacity="0.3"/></svg>
                  ) : i === 1 ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="drop-shadow-[0_0_8px_rgba(59,130,246,0.5)]"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5" opacity="0.6"/><path d="M2 12l10 5 10-5"/><path d="M12 22V17" opacity="0.4"/></svg>
                  ) : (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="drop-shadow-[0_0_8px_rgba(167,139,250,0.5)]"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/><path d="M9 8h6M12 5v6" opacity="0.4"/></svg>
                  )}
                </div>
              </div>
            </div>
            <div class="card-body relative flex-1 rounded-2xl overflow-hidden bg-white/[0.02] border border-white/[0.06] px-7 py-6 transition-all duration-500 group-hover:bg-blue-500/[0.04] group-hover:border-blue-500/20">
              <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
                <span class="font-mono text-[10px] font-bold tracking-widest text-blue-400 bg-blue-500/10 border border-blue-500/20 rounded-full px-3 py-1">{edu.year}</span>
                <span class="font-mono text-[8px] uppercase tracking-[0.16em] flex items-center gap-1.5 text-[#39ff14]/70 bg-[#39ff14]/5 border border-[#39ff14]/20 rounded-full px-3 py-1">
                  <span class="w-[5px] h-[5px] rounded-full bg-[#39ff14] animate-pulse"></span>
                  COMPLETED
                </span>
              </div>
              <h3 class="font-black font-outfit text-white text-xl md:text-2xl leading-tight tracking-tight mb-2 group-hover:text-blue-300 transition-colors">
                {edu.degree}
              </h3>
              <p class="font-mono text-[9px] uppercase tracking-[0.16em] text-purple-400/70 font-bold mb-4">
                {edu.specialization}
              </p>
              <div class="flex items-center gap-2 mb-4">
                <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/50 font-mono italic">{edu.institution}</span>
              </div>
              {edu.details && (
                <div class="flex items-start gap-3 bg-blue-500/[0.06] border border-blue-500/20 rounded-xl px-4 py-3">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <p class="text-[12px] text-blue-200/70 leading-relaxed font-mono">
                    {edu.details}
                  </p>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .reveal.active { opacity: 1; transform: translateY(0); }
  .node-pulse { animation: pulse-ring 3s ease-in-out infinite; }
  @keyframes pulse-ring {
    0%, 100% { transform: scale(1); opacity: 0.4; }
    50%       { transform: scale(1.15); opacity: 0; }
  }
  .edu-card:hover .card-body {
    box-shadow: 0 20px 40px rgba(0,0,0,0.4), 0 0 20px rgba(59,130,246,0.05);
  }
</style>

<script is:inline>
  (function() {
    /* Intersection Observer */
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('active'); });
    }, { threshold: 0.1 });
    document.querySelectorAll('#education .reveal').forEach(el => obs.observe(el));

    /* 3D Background Engine */
    const container = document.getElementById('edu-3d-bg');
    if (!container) return;

    function initScene() {
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(75, container.offsetWidth/container.offsetHeight, 0.1, 1000);
      const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
      renderer.setSize(container.offsetWidth, container.offsetHeight);
      container.appendChild(renderer.domElement);

      const grid = new THREE.GridHelper(100, 40, 0x3b82f6, 0x1e293b);
      grid.rotation.x = Math.PI / 2;
      scene.add(grid);

      const nodes = [];
      const geom = new THREE.IcosahedronGeometry(0.3, 0);
      const mat = new THREE.MeshBasicMaterial({ color: 0x6366f1, wireframe: true, transparent: true, opacity: 0.4 });
      for(let i=0; i<40; i++) {
        const node = new THREE.Mesh(geom, mat);
        node.position.set((Math.random()-0.5)*60, (Math.random()-0.5)*60, (Math.random()-0.5)*15);
        scene.add(node);
        nodes.push(node);
      }
      camera.position.z = 25;

      function animate() {
        requestAnimationFrame(animate);
        grid.position.y -= 0.015;
        if (grid.position.y < -2.5) grid.position.y = 0;
        nodes.forEach(n => {
          n.rotation.y += 0.01;
          n.position.y += 0.01;
          if (n.position.y > 30) n.position.y = -30;
        });
        renderer.render(scene, camera);
      }
      animate();

      window.addEventListener('resize', () => {
        camera.aspect = container.offsetWidth/container.offsetHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.offsetWidth, container.offsetHeight);
      });
    }

    if (typeof THREE === 'undefined') {
       const script = document.createElement('script');
       script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
       script.onload = initScene;
       document.head.appendChild(script);
    } else {
       initScene();
    }
  })();
</script>
