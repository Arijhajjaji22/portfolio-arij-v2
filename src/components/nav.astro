---
const sections = [
  { id: "home",       label: "Home",       num: "01" },
  { id: "about",      label: "About",      num: "02" },
  { id: "education",  label: "Education",  num: "03" },
  { id: "experience", label: "Experience",   num: "04" },
  { id: "projects",   label: "Projects",   num: "05" },
  { id: "contact",    label: "Contact",    num: "06" },
];
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!--  NAV WRAPPER                                               -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div
  id="nav-wrapper"
  class="fixed top-6 left-1/2 -translate-x-1/2 z-[9999]
         w-[95%] lg:w-[1200px]
         transition-all duration-700 pointer-events-none"
>
  <nav
    id="main-nav"
    class="pointer-events-auto w-full mx-auto
           bg-[#0d0d14]/60 backdrop-blur-3xl
           border border-white/10
           rounded-2xl lg:rounded-full
           shadow-[0_30px_60px_rgba(0,0,0,0.8),inset_0_1px_0_rgba(255,255,255,0.1)]
           transition-all duration-700
           flex items-center justify-between
           px-3 md:px-4 py-3
           relative overflow-hidden group/nav"
  >
    <!-- Animated underglow on hover -->
    <div class="absolute inset-x-20 bottom-0 h-[1px]
                bg-gradient-to-r from-transparent via-purple-500/50 to-transparent
                shadow-[0_0_15px_rgba(123,47,247,0.5)]
                opacity-0 group-hover/nav:opacity-100
                transition-opacity duration-1000 pointer-events-none"></div>

    <!-- Scroll progress bar inside nav -->
    <div id="scroll-progress-bar"
         class="absolute bottom-0 left-0 h-[2px] bg-purple-500 w-0
                shadow-[0_0_15px_rgba(123,47,247,0.5)] z-[5]
                transition-none pointer-events-none"></div>

    <!-- ── LOGO ── -->
    <a href="#home" class="flex items-center gap-3 group px-2 z-10" id="logo-link">
      <div class="relative w-10 h-10 rounded-full
                  bg-gradient-to-br from-[#0d0d14] to-[#1a1a24]
                  border border-purple-500/30
                  flex items-center justify-center overflow-hidden
                  transition-all duration-500
                  group-hover:scale-110
                  group-hover:border-purple-500
                  group-hover:shadow-[0_0_20px_rgba(123,47,247,0.4)]
                  shrink-0" id="logo-ring">
        <!-- Inner pulse ring -->
        <div class="absolute inset-0 rounded-full border border-purple-500/20
                    animate-ping opacity-30 pointer-events-none"></div>
        <span class="text-xl font-black font-outfit text-white relative z-10"
              id="logo-letter">A</span>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-black font-outfit uppercase tracking-tighter text-white leading-none mb-1">ARIJ</span>
        <span id="logo-sub" class="text-[8px] md:text-[9px] font-mono text-purple-500/60 uppercase tracking-[0.4em] font-black leading-none">CORE</span>
      </div>
    </a>

    <!-- ── DESKTOP NAV ── -->
    <div class="hidden lg:flex items-center gap-1
                absolute left-1/2 -translate-x-1/2 z-10
                bg-white/[0.02] border border-white/5
                p-1 rounded-full backdrop-blur-md"
         id="nav-pill-container">
      {sections.map((sec) => (
        <a
          href={`#${sec.id}`}
          data-section={sec.id}
          class="nav-link relative px-5 py-2.5
                 text-[10px] font-inter font-bold uppercase tracking-[0.2em]
                 text-gray-400 hover:text-white
                 transition-all duration-300 rounded-full overflow-hidden
                 group/nl"
        >
          <!-- Active blob (JS moves it) -->
          <span class="relative z-10 transition-transform duration-300 block
                       group-hover/nl:-translate-y-[2px]">
            {sec.label}
          </span>
          <div class="nav-glow absolute inset-0 bg-purple-500/10
                      opacity-0 transition-opacity rounded-full z-0"></div>
        </a>
      ))}

      <!-- Sliding active indicator -->
      <div id="nav-indicator"
           class="absolute h-[calc(100%-8px)] rounded-full
                  bg-purple-500/10 border border-purple-500/30
                  pointer-events-none
                  transition-all duration-400 ease-out z-0"
           style="opacity:0"></div>
    </div>

    <!-- ── RIGHT ACTIONS ── -->
    <div class="hidden lg:flex items-center gap-3 z-10">

      <!-- Availability dot -->
      <div class="flex items-center gap-2 px-3 py-1.5
                  bg-white/[0.03] border border-white/5 rounded-full">
        <div id="nav-status-dot"
             class="w-2 h-2 rounded-full bg-green-400
                    shadow-[0_0_8px_#4ade80] animate-pulse"></div>
        <span class="text-[8px] font-mono text-gray-500 uppercase tracking-widest"
              id="nav-status-text">Online</span>
      </div>

      <!-- CV Button -->
      <button
        id="cv-download-btn"
        class="magnetic group relative flex items-center justify-center gap-3
               px-6 py-3
               bg-white text-black
               font-black font-outfit text-[10px]
               uppercase tracking-[0.2em] rounded-full
               hover:bg-purple-600 hover:text-white
               transition-all duration-300
               shadow-xl hover:shadow-[0_0_30px_rgba(123,47,247,0.5)]
               overflow-hidden"
      >
        <!-- Wipe overlay -->
        <div class="absolute inset-0 bg-purple-600 translate-x-[-100%]
                    group-hover:translate-x-0 transition-transform duration-400
                    pointer-events-none"></div>
        <span id="cv-text" class="m-inner relative z-10 inline-block pointer-events-none">
          SYNC_DATA
        </span>
        <div id="cv-loader"
             class="hidden w-3.5 h-3.5 border-2 border-current
                    border-t-transparent rounded-full animate-spin relative z-10"></div>
      </button>
    </div>

    <!-- ── MOBILE HAMBURGER ── -->
    <button
      id="mobile-menu-btn"
      aria-label="Menu"
      class="lg:hidden w-10 h-10 flex flex-col items-center justify-center gap-1.5
             group hover:bg-white/5 rounded-full transition-all z-10"
    >
      <span class="ham-line w-5 h-[2px] bg-white rounded-full
                   transition-all duration-300"></span>
      <span class="ham-line w-6 h-[2px] bg-purple-500 rounded-full
                   transition-all duration-300"></span>
      <span class="ham-line w-4 h-[2px] bg-white rounded-full
                   transition-all duration-300"></span>
    </button>
  </nav>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!--  MOBILE OVERLAY                                            -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 bg-transparent/98 backdrop-blur-3xl
         z-[9990] flex flex-col items-center justify-center
         translate-x-full transition-transform duration-500 overflow-hidden"
>
  <div class="absolute inset-0 opacity-10 pointer-events-none
              bg-[radial-gradient(circle_at_center,var(--primary)_0%,transparent_70%)]"></div>
  <div class="flex flex-col gap-10 items-center text-center relative z-10">
    {sections.map((sec, i) => (
      <a
        href={`#${sec.id}`}
        class="mobile-nav-link
               text-4xl font-black font-outfit uppercase tracking-tighter
               text-white hover:text-purple-400
               transition-all hover:scale-110
               flex items-center gap-4"
        style={`transition-delay: ${i * 0.07}s`}
      >
        <span class="text-[10px] font-mono text-purple-500/40">{sec.num}</span>
        {sec.label}
      </a>
    ))}
    <a
      href="/CV/Arij_Hajjaji_CV.pdf"
      target="_blank"
      class="mt-16 px-10 py-5 bg-purple-600 text-white
             font-black font-outfit text-[10px]
             uppercase tracking-[0.3em] rounded-2xl
             shadow-[0_0_30px_rgba(123,47,247,0.4)] active:scale-95 transition-all"
    >
      DOWNLOAD_DOSSIER.PDF
    </a>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!--  STYLES                                                    -->
<!-- ═══════════════════════════════════════════════════════════ -->
<style>
  /* Scrolled state — island shrinks */
  .nav-scrolled {
    max-width: min(900px, 90%) !important;
    background: rgba(13, 13, 20, 0.9) !important;
    border-color: rgba(123, 47, 247, 0.2) !important;
    box-shadow:
      0 40px 80px rgba(0,0,0,0.9),
      0 0 30px rgba(123,47,247,0.08),
      inset 0 1px 0 rgba(255,255,255,0.08) !important;
  }
  @media (max-width: 1024px) {
    .nav-scrolled { border-radius: 2rem !important; }
  }

  /* Active nav pill */
  .nav-link.active {
    color: #fff !important;
    text-shadow: 0 0 12px rgba(123,47,247,0.6);
  }
  .nav-link:hover .nav-glow { opacity: 1; }

  /* Hamburger open state */
  .menu-open .ham-line:nth-child(1) { transform: translateY(6px) rotate(45deg); width: 24px; }
  .menu-open .ham-line:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .menu-open .ham-line:nth-child(3) { transform: translateY(-6px) rotate(-45deg); width: 24px; }

  /* Logo letter glitch on hover */
  @keyframes rgb-shift {
    0%   { text-shadow:  2px 0 #f00, -2px 0 #00f; }
    33%  { text-shadow: -2px 0 #f00,  2px 0 #0f0; }
    66%  { text-shadow:  2px 0 #00f, -2px 0 #0f0; }
    100% { text-shadow:  2px 0 #f00, -2px 0 #00f; }
  }
  #logo-link:hover #logo-letter { animation: rgb-shift 0.18s infinite linear; }
  #logo-link:not(:hover) #logo-letter { animation: none; }

  /* Logo sub typewriter pulse */
  @keyframes sub-blink { 50% { opacity: 0.3; } }
  #logo-sub { animation: sub-blink 2s ease-in-out infinite; }
</style>

<!-- ═══════════════════════════════════════════════════════════ -->
<!--  SCRIPT                                                    -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script is:inline>
(function () {
  'use strict';

  /* ── Elements ─────────────────────────────────────────────── */
  const wrapper   = document.getElementById('nav-wrapper');
  const pBar      = document.getElementById('scroll-progress-bar');
  const navLinks  = document.querySelectorAll('.nav-link');
  const mLinks    = document.querySelectorAll('.mobile-nav-link');
  const sections  = document.querySelectorAll('section[id]');
  const indicator = document.getElementById('nav-indicator');
  const container = document.getElementById('nav-pill-container');
  const mBtn      = document.getElementById('mobile-menu-btn');
  const overlay   = document.getElementById('mobile-menu-overlay');
  const statusDot = document.getElementById('nav-status-dot');
  const statusTxt = document.getElementById('nav-status-text');
  const cvBtn     = document.getElementById('cv-download-btn');
  const cvText    = document.getElementById('cv-text');
  const cvLoader  = document.getElementById('cv-loader');

  /* ── Scroll progress (RAF-throttled) ──────────────────────── */
  let rafPending = false;
  window.addEventListener('scroll', () => {
    if (rafPending) return;
    rafPending = true;
    requestAnimationFrame(() => {
      const max  = document.documentElement.scrollHeight - innerHeight;
      const pct  = max > 0 ? pageYOffset / max : 0;
      pBar.style.width = (pct * 100) + '%';

      /* Nav island shrink */
      if (pageYOffset > 80) wrapper.classList.add('nav-scrolled');
      else                   wrapper.classList.remove('nav-scrolled');

      /* Active section highlight */
      let current = '';
      sections.forEach(s => {
        if (pageYOffset >= s.offsetTop - 320) current = s.id;
      });
      setActive(current);

      rafPending = false;
    });
  }, { passive: true });

  /* ── Sliding indicator ────────────────────────────────────── */
  function setActive(id) {
    navLinks.forEach(a => {
      const isActive = a.dataset.section === id;
      a.classList.toggle('active', isActive);
      if (isActive) moveIndicator(a);
    });
  }

  function moveIndicator(el) {
    if (!indicator || !container) return;
    const cRect = container.getBoundingClientRect();
    const eRect = el.getBoundingClientRect();
    indicator.style.opacity  = '1';
    indicator.style.width    = eRect.width  + 'px';
    indicator.style.left     = (eRect.left - cRect.left) + 'px';
    indicator.style.top      = '4px';
  }

  /* ── Live Tunis availability clock ───────────────────────── */
  function updateStatus() {
    const h = parseInt(new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Africa/Tunis', hour: '2-digit', hour12: false
    }).format(new Date()));

    if (h >= 9 && h <= 18) {
      statusDot.style.background  = '#4ade80';
      statusDot.style.boxShadow   = '0 0 8px #4ade80';
      statusTxt.textContent        = 'Online';
    } else {
      statusDot.style.background  = '#7b2ff7';
      statusDot.style.boxShadow   = '0 0 8px #7b2ff7';
      statusTxt.textContent        = 'Coding';
    }
  }
  updateStatus();
  setInterval(updateStatus, 60_000);

  /* ── Mobile menu ──────────────────────────────────────────── */
  let menuOpen = false;
  mBtn.addEventListener('click', () => {
    menuOpen = !menuOpen;
    overlay.style.transform = menuOpen ? 'translateX(0)' : 'translateX(100%)';
    mBtn.classList.toggle('menu-open', menuOpen);
  });
  [...navLinks, ...mLinks].forEach(l => {
    l.addEventListener('click', () => {
      menuOpen = false;
      overlay.style.transform = 'translateX(100%)';
      mBtn.classList.remove('menu-open');
      if (window.playSystemSound) window.playSystemSound('click');
    });
  });
  navLinks.forEach(l => {
    l.addEventListener('mouseenter', () => {
      if (window.playSystemSound) window.playSystemSound('hover');
    });
  });

  /* ── CV Download with fake compile ───────────────────────── */
  if (cvBtn) {
    cvBtn.addEventListener('click', () => {
      if (cvBtn.disabled) return;
      cvBtn.disabled = true;
      cvLoader.classList.remove('hidden');

      const steps = ['COMPILING...', 'POLISHING...', 'DEPLOYING...'];
      let i = 0;
      cvText.textContent = steps[0];

      const iv = setInterval(() => {
        i++;
        if (i < steps.length) {
          cvText.textContent = steps[i];
        } else {
          clearInterval(iv);
          cvText.textContent  = '✓ READY';
          cvLoader.classList.add('hidden');
          setTimeout(() => {
            window.open('public/CV/Arij_Hajjaji_CV.pdf');
            cvText.textContent = 'SYNC_DATA';
            cvBtn.disabled     = false;
          }, 800);
        }
      }, 600);
    });
  }

  /* ── Logo 5-click → terminal ─────────────────────────────── */
  const logoLink = document.getElementById('logo-link');
  let logoClicks = 0, lastLogoClick = 0;
  if (logoLink) {
    logoLink.addEventListener('click', e => {
      const now = Date.now();
      logoClicks = now - lastLogoClick < 500 ? logoClicks + 1 : 1;
      lastLogoClick = now;
      if (logoClicks >= 5) {
        logoClicks = 0;
        e.preventDefault();
        const cli = document.getElementById('secret-cli');
        if (cli) {
          cli.classList.remove('translate-y-full');
          setTimeout(() => document.getElementById('cli-input')?.focus(), 200);
        }
      }
    });
  }
})();
</script>
