---
// Contact Component - Premium Animated Version
---

<section id="contact" class="reveal-section py-32 bg-[#08080a] relative overflow-hidden">
  <!-- ANIMATED BACKGROUND -->
  <div class="absolute inset-0 pointer-events-none">
    <!-- Floating Particles Canvas -->
    <canvas id="particles-canvas" class="absolute inset-0 w-full h-full"></canvas>
    
    <!-- Gradient Orbs -->
    <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-purple-500/[0.05] rounded-full blur-[120px] animate-orb-1"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-blue-500/[0.05] rounded-full blur-[100px] animate-orb-2"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-500/[0.03] rounded-full blur-[150px] animate-orb-3"></div>
    
    <!-- Animated Grid -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(123,47,247,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(123,47,247,0.03)_1px,transparent_1px)] bg-[size:60px_60px] [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_70%)] animate-grid-pulse"></div>
    
    <!-- Scanning Line -->
    <div class="absolute inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-purple-500/30 to-transparent animate-scan"></div>
    
    <!-- Corner Accents -->
    <div class="absolute top-0 left-0 w-32 h-32 border-l-2 border-t-2 border-purple-500/10"></div>
    <div class="absolute bottom-0 right-0 w-32 h-32 border-r-2 border-b-2 border-blue-500/10"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
    <!-- LEFT: Info Section -->
    <div class="reveal-section space-y-8">
      <!-- Header -->
      <div>
        <div class="text-[9px] font-mono text-purple-400/80 uppercase tracking-[0.4em] mb-6 flex items-center gap-2">
          <span class="w-8 h-[1px] bg-purple-500/50"></span>
          <span>// Connection.Protocol</span>
        </div>
        
        <h2 class="text-3xl md:text-5xl lg:text-5xl font-black font-outfit uppercase tracking-tighter mb-6 leading-[0.9]">
          INITIALIZE <span class="gradient-text-animated">CONNECTION</span>
        </h2>

        <p class="text-gray-400 text-sm md:text-base max-w-md leading-relaxed">
          Have a project in mind? Let's build something <span class="text-white font-semibold">extraordinary</span> together. I'm always open to discussing new opportunities.
        </p>
      </div>

      <!-- Clock Card -->
      <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/[0.06] backdrop-blur-sm relative overflow-hidden group hover:border-purple-500/20 transition-all duration-500">
        <!-- Animated border glow -->
        <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-purple-500/0 via-purple-500/10 to-purple-500/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        
        <div class="flex items-center gap-5 relative z-10">
          <div id="status-dot" class="w-14 h-14 rounded-xl bg-white/[0.03] border border-white/[0.08] flex items-center justify-center transition-all duration-500 group-hover:scale-105 group-hover:border-purple-500/30">
            <div class="w-3 h-3 rounded-full bg-purple-500 shadow-[0_0_20px_var(--primary-glow)] animate-pulse"></div>
          </div>
          
          <div class="flex-1">
            <div id="tunis-time" class="text-3xl md:text-4xl font-bold font-outfit text-white tracking-tight tabular-nums mb-1">--:--:--</div>
            <div class="text-[9px] font-mono text-gray-500 uppercase tracking-widest flex items-center gap-2">
              <span id="status-text" class="text-purple-400">Syncing...</span>
              <span class="text-gray-700">•</span>
              <span class="text-gray-600">Tunis, Tunisia</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Cards -->
      <div class="space-y-3">
        <!-- Email Card -->
        <a href="mailto:arijhajjaji2@gmail.com" class="group flex items-center gap-4 p-5 rounded-xl bg-white/[0.02] border border-white/[0.06] hover:border-purple-500/30 hover:bg-white/[0.04] transition-all duration-300 hover:translate-x-1">
          <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-purple-500/10 to-violet-500/10 border border-white/[0.08] flex items-center justify-center text-purple-400 group-hover:scale-110 group-hover:border-purple-500/30 transition-all">
            <i class="devicon-google-plain text-lg"></i>
          </div>
          
          <div class="flex-1 min-w-0">
            <div class="text-[9px] font-mono text-gray-600 uppercase tracking-widest mb-1">Email</div>
            <div class="text-sm font-medium text-white truncate group-hover:text-purple-400 transition-colors">arijhajjaji2@gmail.com</div>
          </div>
          
          <svg class="w-5 h-5 text-gray-600 group-hover:text-purple-400 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

        <!-- Social Links -->
        <div class="flex gap-3">
          <a href="https://github.com/Arijhajjaji22" target="_blank" class="group flex-1 flex items-center justify-center gap-2 p-4 rounded-xl bg-white/[0.02] border border-white/[0.06] hover:border-white/20 hover:bg-white/[0.04] transition-all duration-300 hover:-translate-y-1">
            <i class="devicon-github-original text-base text-gray-500 group-hover:text-white transition-colors"></i>
            <span class="text-[11px] font-mono text-gray-500 group-hover:text-white transition-colors">GitHub</span>
          </a>
          
          <a href="https://linkedin.com/in/arij-hajjaji" target="_blank" class="group flex-1 flex items-center justify-center gap-2 p-4 rounded-xl bg-white/[0.02] border border-white/[0.06] hover:border-[#0A66C2]/30 hover:bg-white/[0.04] transition-all duration-300 hover:-translate-y-1">
            <i class="devicon-linkedin-plain text-base text-gray-500 group-hover:text-[#0A66C2] transition-colors"></i>
            <span class="text-[11px] font-mono text-gray-500 group-hover:text-white transition-colors">LinkedIn</span>
          </a>
        </div>
      </div>

      <!-- Availability Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-green-500/10 border border-green-500/20">
        <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
        <span class="text-xs font-mono text-green-400">Available for new projects</span>
      </div>
    </div>

    <!-- RIGHT: Contact Form -->
    <div class="reveal">
      <div class="relative group">
        <!-- Form glow effect -->
        <div class="absolute -inset-1 bg-gradient-to-r from-purple-500/20 via-violet-500/20 to-blue-500/20 rounded-3xl blur-2xl opacity-0 group-hover:opacity-60 transition-opacity duration-700"></div>
        
        <div class="relative bg-[#0d0d14] p-8 md:p-10 rounded-3xl border border-white/[0.05] backdrop-blur-xl overflow-hidden shadow-2xl">
          <!-- Corner decorations -->
          <div class="absolute top-4 left-4 w-10 h-[1px] bg-gradient-to-r from-purple-500/30 to-transparent"></div>
          <div class="absolute top-4 left-4 w-[1px] h-10 bg-gradient-to-b from-purple-500/30 to-transparent"></div>
          
          <!-- Header -->
          <div class="mb-8">
            <div class="text-[9px] font-mono text-purple-500/60 uppercase tracking-[0.3em] mb-3 flex items-center gap-2 font-bold">
              <span>// Dispatch_Message</span>
            </div>
            <h3 class="text-2xl font-bold font-outfit text-white tracking-tight">Drop me a line</h3>
          </div>

          <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
            <!-- Web3Forms Config -->
            <input type="hidden" name="access_key" value="6720217e-98b9-4cee-a078-ec00e34681e1">
            <input type="hidden" name="subject" value="[PORTFOLIO CONTACT] New Message from Nexus Core">
            <input type="hidden" name="from_name" value="Portfolio Personal AI">
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
            <!-- Name Input -->
            <div class="relative group/input">
              <input
                name="name"
                id="name"
                required
                placeholder=" "
                class="peer w-full bg-white/[0.02] border border-white/[0.08] rounded-xl px-4 pt-6 pb-2 text-white text-sm focus:border-purple-500/50 focus:bg-white/[0.04] outline-none transition-all group-hover/input:border-white/[0.12]"
              />
              <label for="name" class="absolute left-4 top-4 text-xs font-mono text-gray-500 uppercase tracking-wider transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-sm peer-focus:top-2 peer-focus:text-[10px] peer-focus:text-purple-400 peer-valid:top-2 peer-valid:text-[10px]">
                Name
              </label>
              <div class="absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-purple-500/50 to-transparent scale-x-0 peer-focus:scale-x-100 transition-transform duration-300"></div>
            </div>

            <!-- Email Input -->
            <div class="relative group/input">
              <input
                type="email"
                name="email"
                id="email"
                required
                placeholder=" "
                class="peer w-full bg-white/[0.02] border border-white/[0.08] rounded-xl px-4 pt-6 pb-2 text-white text-sm focus:border-purple-500/50 focus:bg-white/[0.04] outline-none transition-all group-hover/input:border-white/[0.12]"
              />
              <label for="email" class="absolute left-4 top-4 text-xs font-mono text-gray-500 uppercase tracking-wider transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-sm peer-focus:top-2 peer-focus:text-[10px] peer-focus:text-purple-400 peer-valid:top-2 peer-valid:text-[10px]">
                Email
              </label>
              <div class="absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-purple-500/50 to-transparent scale-x-0 peer-focus:scale-x-100 transition-transform duration-300"></div>
            </div>

            <!-- Message Textarea -->
            <div class="relative group/input">
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder=" "
                class="peer w-full bg-white/[0.02] border border-white/[0.08] rounded-xl px-4 pt-6 pb-2 text-white text-sm focus:border-purple-500/50 focus:bg-white/[0.04] outline-none transition-all resize-none group-hover/input:border-white/[0.12]"
              ></textarea>
              <label for="message" class="absolute left-4 top-4 text-xs font-mono text-gray-500 uppercase tracking-wider transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-sm peer-focus:top-2 peer-focus:text-[10px] peer-focus:text-purple-400 peer-valid:top-2 peer-valid:text-[10px]">
                Message
              </label>
              <div class="absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-purple-500/50 to-transparent scale-x-0 peer-focus:scale-x-100 transition-transform duration-300"></div>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="submit-btn"
              class="w-full relative py-4 rounded-xl bg-gradient-to-r from-purple-600 to-blue-500 text-white text-sm font-bold font-outfit uppercase tracking-wider overflow-hidden group/btn hover:shadow-[0_0_40px_rgba(123,47,247,0.4)] transition-all duration-300 hover:scale-[1.02]"
            >
              <span id="btn-text" class="relative z-10 flex items-center justify-center gap-2">
                <span>Send Message</span>
                <svg class="w-5 h-5 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
              
              <!-- Progress Bar -->
              <div id="btn-progress" class="absolute inset-0 bg-white/30 -translate-x-full"></div>
              
              <!-- Shimmer Effect -->
              <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover/btn:translate-x-full transition-transform duration-1000"></div>
            </button>
          </form>

          <!-- Form Footer Info -->
          <div class="mt-6 pt-6 border-t border-white/[0.06]">
            <p class="text-[10px] font-mono text-gray-600 text-center">
              <span class="text-purple-500">⚡</span> Response time: Usually within 24 hours
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Animated Gradient Text */
  @keyframes gradient-x {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .animate-gradient-x {
    background-size: 200% auto;
    animation: gradient-x 3s ease infinite;
  }

  /* Orb Animations */
  @keyframes orb-1 {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.5; }
    25% { transform: translate(50px, -30px) scale(1.1); opacity: 0.7; }
    50% { transform: translate(20px, 50px) scale(0.9); opacity: 0.4; }
    75% { transform: translate(-30px, 20px) scale(1.05); opacity: 0.6; }
  }

  @keyframes orb-2 {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.4; }
    33% { transform: translate(-40px, 40px) scale(1.15); opacity: 0.6; }
    66% { transform: translate(30px, -20px) scale(0.85); opacity: 0.5; }
  }

  @keyframes orb-3 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.3; }
    50% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.5; }
  }

  .animate-orb-1 { animation: orb-1 15s ease-in-out infinite; }
  .animate-orb-2 { animation: orb-2 20s ease-in-out infinite; }
  .animate-orb-3 { animation: orb-3 25s ease-in-out infinite; }

  /* Grid Pulse */
  @keyframes grid-pulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.6; }
  }

  .animate-grid-pulse {
    animation: grid-pulse 4s ease-in-out infinite;
  }

  /* Scanning Line */
  @keyframes scan {
    0% { top: -2px; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  .animate-scan {
    animation: scan 8s linear infinite;
  }

  /* Clock styling */
  #tunis-time {
    font-variant-numeric: tabular-nums;
  }

  /* Reveal Animation */
  .reveal-section {
    animation: reveal 0.8s ease-out;
  }

  .reveal {
    animation: reveal 0.8s ease-out 0.2s both;
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script is:inline>
(function() {
  // Particles Animation
  const canvas = document.getElementById('particles-canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let particles = [];
    let animationId;

    function resize() {
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
    }

    function createParticles() {
      particles = [];
      const count = Math.floor((canvas.width * canvas.height) / 15000);
      
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
          size: Math.random() * 2 + 0.5,
          opacity: Math.random() * 0.5 + 0.3
        });
      }
    }

    function animate() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      particles.forEach((p, i) => {
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

        // Draw particle
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(123, 47, 247, ${p.opacity})`;
        ctx.fill();

        // Connect nearby particles
        particles.slice(i + 1).forEach(p2 => {
          const dx = p.x - p2.x;
          const dy = p.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 120) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = `rgba(123, 47, 247, ${0.1 * (1 - dist / 120)})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        });
      });

      animationId = requestAnimationFrame(animate);
    }

    resize();
    createParticles();
    animate();

    window.addEventListener('resize', () => {
      resize();
      createParticles();
    });
  }

  // Clock with Status
  const clockEl = document.getElementById('tunis-time');
  const statusDot = document.getElementById('status-dot');
  const statusTxt = document.getElementById('status-text');

  function updateTime() {
    const now = new Date();
    const tunis = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Africa/Tunis',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    }).format(now);

    if (clockEl) clockEl.textContent = tunis;

    const hour = parseInt(tunis.split(':')[0]);
    const isOnline = hour >= 9 && hour < 22;

    if (statusDot && statusTxt) {
      const dot = statusDot.querySelector('div');
      if (isOnline) {
        dot.style.background = '#10b981';
        dot.style.boxShadow = '0 0 20px #10b981';
        statusTxt.textContent = 'Online';
        statusTxt.style.color = '#10b981';
      } else {
        dot.style.background = '#a78bfa';
        dot.style.boxShadow = '0 0 20px #a78bfa';
        statusTxt.textContent = 'Away';
        statusTxt.style.color = '#a78bfa';
      }
    }
  }

  setInterval(updateTime, 1000);
  updateTime();

  // Enhanced Form Handler
  const form = document.getElementById('contact-form');
  const btn = document.getElementById('submit-btn');
  const prog = document.getElementById('btn-progress');
  const txt = document.getElementById('btn-text');

  if (form && btn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Disable button
      btn.disabled = true;

      // Start progress animation
      prog.style.transition = 'transform 1.5s ease';
      prog.style.transform = 'translateX(0)';

      // Show sending state
      txt.innerHTML = `
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Sending...</span>
        </span>
      `;

      // Real API call to Web3Forms
      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });
        const result = await response.json();
        
        if (!response.ok) throw new Error(result.message || 'Submission failed');
      } catch (err) {
        console.error(err);
        txt.innerHTML = '<span>Error Occurred</span>';
        btn.disabled = false;
        return;
      }

      // Success state
      txt.innerHTML = `
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>Message Sent!</span>
        </span>
      `;
      btn.classList.add('!from-green-500', '!to-emerald-500');

      // Reset after 3 seconds
      setTimeout(() => {
        btn.classList.remove('!from-green-500', '!to-emerald-500');
        txt.innerHTML = `
          <span>Send Message</span>
          <svg class="w-5 h-5 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        `;
        prog.style.transition = 'none';
        prog.style.transform = 'translateX(-100%)';
        form.reset();
        btn.disabled = false;
      }, 3000);
    });
  }
})();
</script>
