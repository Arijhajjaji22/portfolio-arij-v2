  .exp-card { position: relative; background: var(--bg-card); border-radius: var(--card-radius); padding: 1px; overflow: hidden; backdrop-filter: blur(30px); transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.6s ease; will-change: transform; }
