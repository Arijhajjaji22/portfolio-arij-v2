<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const section = document.getElementById('experience');
  if (!section) return;

  /* ═══════════════════════════════════════════════ */
  /*    INTERACTIVE PARTICLE NETWORK CANVAS          */
  /* ═══════════════════════════════════════════════ */
  const networkCanvas = document.getElementById('network-canvas');
  if (networkCanvas) {
    const ctx = networkCanvas.getContext('2d');
    let w, h;
    let mouseX = -1000, mouseY = -1000;
    const particles = [];
    const PARTICLE_COUNT = 60;
    const CONNECTION_DIST = 180;
    const MOUSE_RADIUS = 200;

    const colors = [
      { r: 123, g: 47, b: 247 }, // Primary
      { r: 0, g: 245, b: 212 },   // Accent
      { r: 192, g: 132, b: 252 }, // Purple
      { r: 45, g: 212, b: 191 },  // Teal
    ];

    function initNetwork() {
      w = networkCanvas.width = networkCanvas.offsetWidth;
      h = networkCanvas.height = networkCanvas.offsetHeight;
      particles.length = 0;
      for (let i = 0; i < PARTICLE_COUNT; i++) {
        const color = colors[Math.floor(Math.random() * colors.length)];
        particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.6,
          vy: (Math.random() - 0.5) * 0.6,
          size: 1.5 + Math.random() * 2,
          color,
          baseAlpha: 0.3 + Math.random() * 0.4,
          pulse: Math.random() * Math.PI * 2,
          pulseSpeed: 0.02 + Math.random() * 0.03,
        });
      }
    }

    initNetwork();

    // Mouse tracking relative to canvas
    section.addEventListener('mousemove', (e) => {
      const rect = networkCanvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;

      // Mouse glow
      const glow = document.getElementById('mouse-glow');
      if (glow) {
        glow.style.left = e.clientX - section.getBoundingClientRect().left + 'px';
        glow.style.top = e.clientY - section.getBoundingClientRect().top + 'px';
        glow.style.opacity = '1';
      }

      // Trail sparkles
      if (Math.random() > 0.7) {
        const trail = document.getElementById('mouse-trail');
        if (trail) {
          const sparkle = document.createElement('div');
          sparkle.className = 'trail-sparkle';
          const sc = colors[Math.floor(Math.random() * colors.length)];
          sparkle.style.cssText = `
            left: ${e.clientX - section.getBoundingClientRect().left}px;
            top: ${e.clientY - section.getBoundingClientRect().top}px;
            background: rgba(${sc.r}, ${sc.g}, ${sc.b}, 0.6);
            box-shadow: 0 0 6px rgba(${sc.r}, ${sc.g}, ${sc.b}, 0.4);
          `;
          trail.appendChild(sparkle);
          setTimeout(() => sparkle.remove(), 1000);
        }
      }
    }, { passive: true });

    section.addEventListener('mouseleave', () => {
      mouseX = -1000;
      mouseY = -1000;
      const glow = document.getElementById('mouse-glow');
      if (glow) glow.style.opacity = '0';
    });

    function drawNetwork() {
      ctx.clearRect(0, 0, w, h);

      particles.forEach(p => {
        p.pulse += p.pulseSpeed;
        const pulseFactor = 0.7 + Math.sin(p.pulse) * 0.3;

        // Mouse interaction: push particles away gently, or attract
        const dx = mouseX - p.x;
        const dy = mouseY - p.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < MOUSE_RADIUS && dist > 0) {
          const force = (MOUSE_RADIUS - dist) / MOUSE_RADIUS * 0.015;
          p.vx -= (dx / dist) * force;
          p.vy -= (dy / dist) * force;
        }

        p.x += p.vx;
        p.y += p.vy;

        // Bounce
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;
        p.x = Math.max(0, Math.min(w, p.x));
        p.y = Math.max(0, Math.min(h, p.y));

        // Friction
        p.vx *= 0.999;
        p.vy *= 0.999;

        // Draw particle
        const alpha = p.baseAlpha * pulseFactor;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * pulseFactor, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${p.color.r}, ${p.color.g}, ${p.color.b}, ${alpha})`;
        ctx.fill();

        // Glow
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * pulseFactor * 3, 0, Math.PI * 2);
        const grad = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size * pulseFactor * 3);
        grad.addColorStop(0, `rgba(${p.color.r}, ${p.color.g}, ${p.color.b}, ${alpha * 0.3})`);
        grad.addColorStop(1, `rgba(${p.color.r}, ${p.color.g}, ${p.color.b}, 0)`);
        ctx.fillStyle = grad;
        ctx.fill();
      });

      // Draw connections
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < CONNECTION_DIST) {
            const alpha = (1 - dist / CONNECTION_DIST) * 0.15;
            const ci = particles[i].color;
            const cj = particles[j].color;
            const mr = (ci.r + cj.r) / 2;
            const mg = (ci.g + cj.g) / 2;
            const mb = (ci.b + cj.b) / 2;

            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `rgba(${mr}, ${mg}, ${mb}, ${alpha})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }

        // Connection to mouse
        if (mouseX > 0) {
          const dx = particles[i].x - mouseX;
          const dy = particles[i].y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MOUSE_RADIUS) {
            const alpha = (1 - dist / MOUSE_RADIUS) * 0.25;
            const c = particles[i].color;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(mouseX, mouseY);
            ctx.strokeStyle = `rgba(${c.r}, ${c.g}, ${c.b}, ${alpha})`;
            ctx.lineWidth = 0.8;
            ctx.stroke();
          }
        }
      }

      networkAnimFrame = requestAnimationFrame(drawNetwork);
    }

    let networkAnimFrame = requestAnimationFrame(drawNetwork);

    // Visibility
    const netObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          if (!networkAnimFrame) networkAnimFrame = requestAnimationFrame(drawNetwork);
        } else {
          cancelAnimationFrame(networkAnimFrame);
          networkAnimFrame = null;
        }
      });
    }, { threshold: 0.05 });
    netObserver.observe(networkCanvas);

    let resizeT;
    window.addEventListener('resize', () => {
      clearTimeout(resizeT);
      resizeT = setTimeout(initNetwork, 250);
    }, { passive: true });
  }

  /* ═══════════════════════════════════════ */
  /*        MATRIX RAIN CANVAS               */
  /* ═══════════════════════════════════════ */
  const matrixCanvas = document.getElementById('matrix-canvas');
  if (matrixCanvas) {
    const ctx = matrixCanvas.getContext('2d');
    let w, h, columns, drops;
    const chars = '01アイウエオカキクケコ<>{}[]=/|;:+-*&#@ABCDEFGHIJKLMNOPQRSTUVWXYZabcdef0123456789';

    function initMatrix() {
      w = matrixCanvas.width = matrixCanvas.offsetWidth;
      h = matrixCanvas.height = matrixCanvas.offsetHeight;
      columns = Math.floor(w / 14);
      drops = Array.from({ length: columns }, () => Math.random() * -100);
    }
    initMatrix();

    function drawMatrix() {
      ctx.fillStyle = 'rgba(3, 3, 5, 0.06)';
      ctx.fillRect(0, 0, w, h);
      ctx.font = '14px "JetBrains Mono", monospace';

      for (let i = 0; i < drops.length; i++) {
        const char = chars[Math.floor(Math.random() * chars.length)];
        const x = i * 14;
        const y = drops[i] * 14;
        const r = Math.random();
        if (r < 0.35) ctx.fillStyle = `rgba(0, 229, 255, ${0.3 + Math.random() * 0.4})`;
        else if (r < 0.6) ctx.fillStyle = `rgba(139, 92, 246, ${0.25 + Math.random() * 0.35})`;
        else if (r < 0.82) ctx.fillStyle = `rgba(16, 185, 129, ${0.2 + Math.random() * 0.3})`;
        else ctx.fillStyle = `rgba(245, 158, 11, ${0.2 + Math.random() * 0.25})`;
        ctx.fillText(char, x, y);
        if (y > h && Math.random() > 0.975) drops[i] = 0;
        drops[i] += 0.3 + Math.random() * 0.2;
      }
    }

    let matrixInt = setInterval(drawMatrix, 70);
    const matObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) { if (!matrixInt) matrixInt = setInterval(drawMatrix, 70); }
        else { clearInterval(matrixInt); matrixInt = null; }
      });
    }, { threshold: 0.05 });
    matObserver.observe(matrixCanvas);
    window.addEventListener('resize', () => { clearTimeout(window._matResize); window._matResize = setTimeout(initMatrix, 250); }, { passive: true });
  }

  /* ═══════════════════════════════════════ */
  /*        WAVEFORM CANVAS                  */
  /* ═══════════════════════════════════════ */
  const waveCanvas = document.getElementById('wave-canvas');
  if (waveCanvas) {
    const ctx = waveCanvas.getContext('2d');
    let w, h, time = 0;

    function initWave() {
      w = waveCanvas.width = waveCanvas.offsetWidth;
      h = waveCanvas.height = waveCanvas.offsetHeight;
    }
    initWave();

    function drawWaves() {
      ctx.clearRect(0, 0, w, h);
      time += 0.008;

      const waves = [
        { y: h * 0.25, amp: 30, freq: 0.008, speed: 1, color: '0, 229, 255', alpha: 0.3 },
        { y: h * 0.45, amp: 25, freq: 0.006, speed: 0.7, color: '139, 92, 246', alpha: 0.25 },
        { y: h * 0.65, amp: 20, freq: 0.01, speed: 1.3, color: '16, 185, 129', alpha: 0.2 },
        { y: h * 0.82, amp: 15, freq: 0.012, speed: 0.9, color: '245, 158, 11', alpha: 0.18 },
      ];

      waves.forEach(wave => {
        ctx.beginPath();
        ctx.moveTo(0, wave.y);
        for (let x = 0; x <= w; x += 3) {
          const y = wave.y + Math.sin(x * wave.freq + time * wave.speed) * wave.amp
            + Math.sin(x * wave.freq * 2.1 + time * wave.speed * 1.5) * wave.amp * 0.3;
          ctx.lineTo(x, y);
        }
        ctx.strokeStyle = `rgba(${wave.color}, ${wave.alpha})`;
        ctx.lineWidth = 1;
        ctx.stroke();

        // Glow
        ctx.strokeStyle = `rgba(${wave.color}, ${wave.alpha * 0.3})`;
        ctx.lineWidth = 4;
        ctx.filter = 'blur(3px)';
        ctx.beginPath();
        ctx.moveTo(0, wave.y);
        for (let x = 0; x <= w; x += 3) {
          const y = wave.y + Math.sin(x * wave.freq + time * wave.speed) * wave.amp
            + Math.sin(x * wave.freq * 2.1 + time * wave.speed * 1.5) * wave.amp * 0.3;
          ctx.lineTo(x, y);
        }
        ctx.stroke();
        ctx.filter = 'none';
      });

      waveFrame = requestAnimationFrame(drawWaves);
    }

    let waveFrame = requestAnimationFrame(drawWaves);
    const waveObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) { if (!waveFrame) waveFrame = requestAnimationFrame(drawWaves); }
        else { cancelAnimationFrame(waveFrame); waveFrame = null; }
      });
    }, { threshold: 0.05 });
    waveObserver.observe(waveCanvas);
    window.addEventListener('resize', () => { clearTimeout(window._waveResize); window._waveResize = setTimeout(initWave, 250); }, { passive: true });
  }

  /* ═══════════════════════════════════════ */
  /*        TYPING TERMINAL EFFECT           */
  /* ═══════════════════════════════════════ */
  const terminalEl = document.querySelector('#typing-terminal-1 .terminal-text');
  if (terminalEl) {
    const commands = [
      'docker compose up --build -d',
      'npm run build && npm run deploy',
      'git push origin main --force',
      'dotnet publish -c Release',
      'kubectl apply -f deployment.yml',
      'terraform plan -out=tfplan',
      'mvn clean package -DskipTests',
      'ng serve --port 4200 --open',
    ];
    let cmdIndex = 0, charIndex = 0, isDeleting = false;

    function typeCommand() {
      const cmd = commands[cmdIndex];
      if (!isDeleting) {
        terminalEl.textContent = cmd.substring(0, charIndex + 1);
        charIndex++;
        if (charIndex >= cmd.length) {
          setTimeout(() => { isDeleting = true; typeCommand(); }, 2000);
          return;
        }
        setTimeout(typeCommand, 40 + Math.random() * 80);
      } else {
        terminalEl.textContent = cmd.substring(0, charIndex);
        charIndex--;
        if (charIndex < 0) {
          isDeleting = false;
          charIndex = 0;
          cmdIndex = (cmdIndex + 1) % commands.length;
          setTimeout(typeCommand, 500);
          return;
        }
        setTimeout(typeCommand, 20 + Math.random() * 30);
      }
    }
    setTimeout(typeCommand, 2000);
  }

  /* ═══════════════════════════════════════ */
  /*          FLOATING PARTICLES             */
  /* ═══════════════════════════════════════ */
  const particleContainer = document.getElementById('exp-particles');
  if (particleContainer) {
    const createParticle = () => {
      const p = document.createElement('div');
      p.className = 'exp-particle';
      const x = Math.random() * 100;
      const dur = 18 + Math.random() * 28;
      const size = 1 + Math.random() * 1.5;
      const drift = -25 + Math.random() * 50;
      p.style.cssText = `left:${x}%;bottom:-10px;width:${size}px;height:${size}px;animation-duration:${dur}s;animation-delay:${Math.random()*12}s;--drift-x:${drift}px;background:rgba(255,255,255,${0.04+Math.random()*0.1});`;
      particleContainer.appendChild(p);
      setTimeout(() => p.remove(), (dur + 12) * 1000);
    };
    for (let i = 0; i < 15; i++) setTimeout(createParticle, i * 500);
    setInterval(createParticle, 2500);
  }

  /* ═══════════════════════════════════════ */
  /*           SCROLL REVEAL                 */
  /* ═══════════════════════════════════════ */
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('in-view'); });
  }, { rootMargin: '0px 0px -60px 0px', threshold: 0.1 });
  document.querySelectorAll('#experience .fade-up-element').forEach(el => observer.observe(el));

  /* ═══════════════════════════════════════ */
  /*     INTERACTIVE CARD SPOTLIGHT + TILT   */
  /* ═══════════════════════════════════════ */
  document.querySelectorAll('#experience .interactive-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const cx = rect.width / 2;
      const cy = rect.height / 2;
      const rx = ((y - cy) / rect.height) * -2.5;
      const ry = ((x - cx) / rect.width) * 2.5;
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
      card.style.transform = `translateY(-10px) scale(1.01) perspective(1000px) rotateX(${rx}deg) rotateY(${ry}deg)`;
    });
    card.addEventListener('mouseleave', () => { card.style.transform = ''; });
  });

  /* ═══════════════════════════════════════ */
  /*        TIMELINE SCROLL PROGRESS         */
  /* ═══════════════════════════════════════ */
  const progressLine = document.getElementById('exp-progress-line');
  const timelineWrapper = document.querySelector('.exp-timeline-wrapper');
  const updateProgress = () => {
    if (!timelineWrapper || !progressLine) return;
    const rect = timelineWrapper.getBoundingClientRect();
    const sp = window.innerHeight * 0.5;
    if (rect.top > sp) progressLine.style.height = '0%';
    else if (rect.bottom < sp) progressLine.style.height = '100%';
    else { const pct = ((sp - rect.top) / rect.height) * 100; progressLine.style.height = `${Math.min(Math.max(pct, 0), 100)}%`; }
  };
  let ticking = false;
  window.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(() => { updateProgress(); ticking = false; }); ticking = true; } }, { passive: true });
  window.addEventListener('resize', updateProgress, { passive: true });
  updateProgress();

  /* ═══════════════════════════════════════ */
  /*         MAGNETIC HOVER ON NODES         */
  /* ═══════════════════════════════════════ */
  document.querySelectorAll('#experience .exp-node').forEach(node => {
    node.addEventListener('mousemove', (e) => {
      const rect = node.getBoundingClientRect();
      const dx = (e.clientX - (rect.left + rect.width / 2)) * 0.25;
      const dy = (e.clientY - (rect.top + rect.height / 2)) * 0.25;
      const core = node.querySelector('.exp-node-core');
      if (core) core.style.transform = `translate(${dx}px, ${dy}px) scale(1.5)`;
    });
    node.addEventListener('mouseleave', () => {
      const core = node.querySelector('.exp-node-core');
      if (core) core.style.transform = '';
    });
  });
});
</script>
