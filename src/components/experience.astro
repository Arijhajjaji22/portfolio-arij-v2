  @keyframes particleDrift { 0% { transform: translateY(0) translateX(0) scale(1); opacity: 0; } 8% { opacity: 1; } 92% { opacity: 1; } 100% { transform: translateY(-100vh) translateX(var(--drift-x, 20px)) scale(0.4); opacity: 0; } }

