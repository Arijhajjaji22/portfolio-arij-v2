---
const experiences = [
  {
    company: "Hosinox Company",
    role: "Full Stack Engineer (Spring & Angular)",
    date: "January 2026 – Present",
    bullets: [
      "Working on an enterprise ERP system with Spring Boot and Angular, optimizing core internal business modules.",
      "Transforming functional requirements into scalable technical solutions in direct collaboration with product teams.",
    ],
    tech: ["Spring Boot", "Angular", "SQL Server", "JWT", "WebSockets", "Elasticsearch", "Liquibase", "SonarQube", "Docker", "Git"],
    current: true,
    icon: "⚡",
    tag: "ACTIVE",
  },
  {
    company: "Biram Group",
    role: "Full Stack .NET Engineer",
    date: "March 2025 – July 2025",
    bullets: [
      "Architected a full-featured school management system with an integrated online payment gateway for parents.",
      "Automated attendance tracking and grade management, vastly reducing manual administrative overhead.",
    ],
    tech: [".NET 8", "C#", "Blazor", "GraphQL", "MediatR", "EF Core", "SignalR", "SQL Server", "Stripe", "Docker", "Git"],
    current: false,
    icon: "🏗️",
    tag: "COMPLETED",
  },
  {
    company: "Innov-Alliance-Tech",
    role: "Graduation Project Internship (PFE)",
    date: "February 2024 – August 2024",
    bullets: [
      "Built an end-to-end recruitment platform, allowing seamless application submissions, automated tests, and instant results.",
      "Automated application processing workflows, significantly reducing manual HR effort and boosting efficiency.",
    ],
    tech: [".NET 8", "C#", "Razor", "REST API", "EF Core", "SignalR", "MySQL", "XUnit", "Jenkins", "Docker", "Prometheus", "Grafana", "Git"],
    current: false,
    icon: "🎓",
    tag: "COMPLETED",
  },
  {
    company: "PROXI WEB",
    role: "Software Engineer Internship",
    date: "July 2023 – September 2023",
    bullets: [
      "Developed a modern CRM web application, streamlining customer data management and internal operational efficiency.",
      "Integrated Ethereum Smart Contracts to build an automated Escrow payment system with on-chain verification.",
    ],
    tech: ["Solidity", "Hardhat", "Ethers.js", "MetaMask", "React", "Tailwind CSS", "Node.js", "Express", "MongoDB", "JWT"],
    current: false,
    icon: "🔗",
    tag: "COMPLETED",
  }
];

const accentColors = [
  { color: "#7b2ff7", rgb: "123, 47, 247" },
  { color: "#3b82f6", rgb: "59, 130, 246" },
  { color: "#c084fc", rgb: "192, 132, 252" },
  { color: "#2dd4bf", rgb: "45, 212, 191" },
];
---

<section id="experience" class="reveal-section exp-section">
  <!-- ═══════════════════════════════════════════════ -->
  <!--    ULTRA ANIMATED IT BACKGROUND (FULL PAGE)     -->
  <!-- ═══════════════════════════════════════════════ -->
  <div class="it-animated-bg" aria-hidden="true">
    <!-- Primary interactive canvas: particles + connections + mouse reactive -->
    <canvas id="network-canvas" class="network-canvas"></canvas>



    <!-- Circuit board SVG patterns with animated pulse -->
    <div class="circuit-layer">
      <svg class="circuit-svg circuit-svg-1" viewBox="0 0 300 300" fill="none">
        <path d="M10 150 H80 V60 H160 V150 H240 V220 H290" stroke="currentColor" stroke-width="0.6" stroke-dasharray="4 6">
          <animate attributeName="stroke-dashoffset" from="0" to="-40" dur="4s" repeatCount="indefinite"/>
        </path>
        <circle cx="80" cy="150" r="4" fill="currentColor" opacity="0.6">
          <animate attributeName="r" values="3;5;3" dur="2s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.4;1;0.4" dur="2s" repeatCount="indefinite"/>
        </circle>
        <circle cx="160" cy="60" r="4" fill="currentColor" opacity="0.6">
          <animate attributeName="r" values="3;5;3" dur="2.5s" repeatCount="indefinite"/>
        </circle>
        <circle cx="160" cy="150" r="4" fill="currentColor" opacity="0.6">
          <animate attributeName="r" values="3;6;3" dur="3s" repeatCount="indefinite"/>
        </circle>
        <circle cx="240" cy="220" r="4" fill="currentColor" opacity="0.6">
          <animate attributeName="r" values="4;6;4" dur="2.2s" repeatCount="indefinite"/>
        </circle>
        <rect x="73" y="53" width="14" height="14" rx="2" stroke="currentColor" stroke-width="0.5" fill="none" opacity="0.4">
          <animate attributeName="opacity" values="0.2;0.8;0.2" dur="3s" repeatCount="indefinite"/>
        </rect>
        <rect x="233" y="213" width="14" height="14" rx="2" stroke="currentColor" stroke-width="0.5" fill="none" opacity="0.4">
          <animate attributeName="opacity" values="0.3;0.7;0.3" dur="2.5s" repeatCount="indefinite"/>
        </rect>
        <!-- Data pulse traveling along path -->
        <circle r="2" fill="currentColor" opacity="0.9">
          <animateMotion dur="4s" repeatCount="indefinite" path="M10,150 L80,150 L80,60 L160,60 L160,150 L240,150 L240,220 L290,220"/>
        </circle>
      </svg>

      <svg class="circuit-svg circuit-svg-2" viewBox="0 0 300 300" fill="none">
        <path d="M150 10 V80 H240 V160 H150 V240 H60 V290" stroke="currentColor" stroke-width="0.6" stroke-dasharray="4 6">
          <animate attributeName="stroke-dashoffset" from="0" to="-40" dur="5s" repeatCount="indefinite"/>
        </path>
        <circle cx="150" cy="80" r="4" fill="currentColor" opacity="0.5">
          <animate attributeName="r" values="3;5;3" dur="2.8s" repeatCount="indefinite"/>
        </circle>
        <circle cx="240" cy="160" r="4" fill="currentColor" opacity="0.5">
          <animate attributeName="r" values="3;6;3" dur="2.3s" repeatCount="indefinite"/>
        </circle>
        <circle cx="60" cy="240" r="4" fill="currentColor" opacity="0.5">
          <animate attributeName="r" values="4;6;4" dur="3.2s" repeatCount="indefinite"/>
        </circle>
        <circle r="2" fill="currentColor" opacity="0.9">
          <animateMotion dur="5s" repeatCount="indefinite" path="M150,10 L150,80 L240,80 L240,160 L150,160 L150,240 L60,240 L60,290"/>
        </circle>
      </svg>

      <svg class="circuit-svg circuit-svg-3" viewBox="0 0 300 300" fill="none">
        <path d="M20 280 H100 V180 H200 V100 H280 V20" stroke="currentColor" stroke-width="0.6" stroke-dasharray="4 6">
          <animate attributeName="stroke-dashoffset" from="0" to="-40" dur="4.5s" repeatCount="indefinite"/>
        </path>
        <circle cx="100" cy="280" r="4" fill="currentColor" opacity="0.5">
          <animate attributeName="r" values="3;5;3" dur="2.6s" repeatCount="indefinite"/>
        </circle>
        <circle cx="200" cy="180" r="4" fill="currentColor" opacity="0.5">
          <animate attributeName="r" values="4;6;4" dur="2.1s" repeatCount="indefinite"/>
        </circle>
        <circle r="2" fill="currentColor" opacity="0.9">
          <animateMotion dur="4.5s" repeatCount="indefinite" path="M20,280 L100,280 L100,180 L200,180 L200,100 L280,100 L280,20"/>
        </circle>
      </svg>

      <svg class="circuit-svg circuit-svg-4" viewBox="0 0 300 300" fill="none">
        <path d="M290 150 H220 V80 H140 V150 H60 V250 H10" stroke="currentColor" stroke-width="0.5" stroke-dasharray="3 5">
          <animate attributeName="stroke-dashoffset" from="0" to="-32" dur="3.8s" repeatCount="indefinite"/>
        </path>
        <circle r="1.8" fill="currentColor" opacity="0.8">
          <animateMotion dur="3.8s" repeatCount="indefinite" path="M290,150 L220,150 L220,80 L140,80 L140,150 L60,150 L60,250 L10,250"/>
        </circle>
      </svg>
    </div>

    <!-- Floating code snippets with typewriter effect -->
    <div class="code-snippets-layer">
      <div class="code-snippet snippet-1">
        <div class="snippet-header">
          <span class="snippet-dot snippet-dot-r"></span>
          <span class="snippet-dot snippet-dot-y"></span>
          <span class="snippet-dot snippet-dot-g"></span>
          <span class="snippet-filename">deploy.ts</span>
        </div>
        <div class="snippet-body">
          <span class="code-keyword">const</span> <span class="code-var">deploy</span> = <span class="code-keyword">async</span> () =&gt; {'{'}<br/>
          &nbsp;&nbsp;<span class="code-keyword">await</span> <span class="code-func">build</span>();<br/>
          &nbsp;&nbsp;<span class="code-keyword">await</span> <span class="code-func">push</span>(<span class="code-string">'prod'</span>);<br/>
          {'}'};
        </div>
      </div>
      <div class="code-snippet snippet-2">
        <div class="snippet-header">
          <span class="snippet-dot snippet-dot-r"></span>
          <span class="snippet-dot snippet-dot-y"></span>
          <span class="snippet-dot snippet-dot-g"></span>
          <span class="snippet-filename">AppService.java</span>
        </div>
        <div class="snippet-body">
          <span class="code-keyword">@Service</span><br/>
          <span class="code-keyword">public class</span> <span class="code-var">AppService</span> {'{'}<br/>
          &nbsp;&nbsp;<span class="code-keyword">@Autowired</span><br/>
          &nbsp;&nbsp;<span class="code-var">Repository</span> repo;<br/>
          {'}'}
        </div>
      </div>
      <div class="code-snippet snippet-3">
        <div class="snippet-header">
          <span class="snippet-dot snippet-dot-r"></span>
          <span class="snippet-dot snippet-dot-y"></span>
          <span class="snippet-dot snippet-dot-g"></span>
          <span class="snippet-filename">query.sql</span>
        </div>
        <div class="snippet-body">
          <span class="code-keyword">SELECT</span> * <span class="code-keyword">FROM</span><br/>
          &nbsp;&nbsp;<span class="code-var">projects</span> p<br/>
          <span class="code-keyword">JOIN</span> <span class="code-var">teams</span> t<br/>
          <span class="code-keyword">ON</span> p.id = t.project_id<br/>
          <span class="code-keyword">WHERE</span> p.status = <span class="code-string">'active'</span>;
        </div>
      </div>
      <div class="code-snippet snippet-4">
        <div class="snippet-header">
          <span class="snippet-dot snippet-dot-r"></span>
          <span class="snippet-dot snippet-dot-y"></span>
          <span class="snippet-dot snippet-dot-g"></span>
          <span class="snippet-filename">terminal</span>
        </div>
        <div class="snippet-body snippet-terminal" id="typing-terminal-1">
          <span class="code-func">$</span> <span class="terminal-text"></span><span class="terminal-cursor-inline">▌</span>
        </div>
      </div>
      <div class="code-snippet snippet-5">
        <div class="snippet-header">
          <span class="snippet-dot snippet-dot-r"></span>
          <span class="snippet-dot snippet-dot-y"></span>
          <span class="snippet-dot snippet-dot-g"></span>
          <span class="snippet-filename">pipeline.yml</span>
        </div>
        <div class="snippet-body">
          <span class="code-keyword">stages:</span><br/>
          &nbsp;&nbsp;- <span class="code-var">build</span><br/>
          &nbsp;&nbsp;- <span class="code-var">test</span><br/>
          &nbsp;&nbsp;- <span class="code-func">deploy</span>
        </div>
      </div>
      <div class="code-snippet snippet-6">
        <div class="snippet-header">
          <span class="snippet-dot snippet-dot-r"></span>
          <span class="snippet-dot snippet-dot-y"></span>
          <span class="snippet-dot snippet-dot-g"></span>
          <span class="snippet-filename">Component.tsx</span>
        </div>
        <div class="snippet-body">
          <span class="code-keyword">export</span> <span class="code-keyword">const</span> <span class="code-var">App</span> = () =&gt; {'{'}<br/>
          &nbsp;&nbsp;<span class="code-keyword">return</span> &lt;<span class="code-func">Layout</span>&gt;<br/>
          &nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class="code-func">Dashboard</span> /&gt;<br/>
          &nbsp;&nbsp;&lt;/<span class="code-func">Layout</span>&gt;<br/>
          {'}'};
        </div>
      </div>
    </div>

    <!-- Binary data rain streams -->
    <div class="binary-streams">
      <div class="binary-stream stream-1">01001011 10110010 01101001 11010100</div>
      <div class="binary-stream stream-2">11010011 01001110 10101100 01110101</div>
      <div class="binary-stream stream-3">00110101 11001010 01010111 10011010</div>
      <div class="binary-stream stream-4">10100110 01110001 11001011 00101110</div>
      <div class="binary-stream stream-5">11100010 00111001 10110110 01001101</div>
      <div class="binary-stream stream-6">01011100 10000111 11010010 10110001</div>
    </div>

    <!-- Floating tech symbols with glow -->
    <div class="floating-symbols">
      <div class="float-symbol symbol-1">{'{ }'}</div>
      <div class="float-symbol symbol-2">{'</>'}</div>
      <div class="float-symbol symbol-3">{'#!'}</div>
      <div class="float-symbol symbol-4">{'λ'}</div>
      <div class="float-symbol symbol-5">{'∞'}</div>
      <div class="float-symbol symbol-6">{'>>>'}</div>
      <div class="float-symbol symbol-7">{'&&'}</div>
      <div class="float-symbol symbol-8">{'[ ]'}</div>
      <div class="float-symbol symbol-9">{'=>'}</div>
      <div class="float-symbol symbol-10">{'|>'}</div>
      <div class="float-symbol symbol-11">{'/**/'}</div>
      <div class="float-symbol symbol-12">{':::'}</div>
      <div class="float-symbol symbol-13">{'0x'}</div>
      <div class="float-symbol symbol-14">{'fn()'}</div>
      <div class="float-symbol symbol-15">{'~/.'}</div>
      <div class="float-symbol symbol-16">{'<<'}</div>
    </div>

    <!-- Orbiting satellites around data nodes -->
    <div class="orbit-container">
      <div class="orbit-system orbit-1">
        <div class="orbit-ring orbit-ring-1">
          <div class="orbit-satellite sat-1"></div>
          <div class="orbit-satellite sat-2"></div>
        </div>
        <div class="orbit-ring orbit-ring-2">
          <div class="orbit-satellite sat-3"></div>
        </div>
        <div class="orbit-core"></div>
      </div>
      <div class="orbit-system orbit-2">
        <div class="orbit-ring orbit-ring-1">
          <div class="orbit-satellite sat-1"></div>
        </div>
        <div class="orbit-ring orbit-ring-2">
          <div class="orbit-satellite sat-2"></div>
          <div class="orbit-satellite sat-3"></div>
        </div>
        <div class="orbit-core"></div>
      </div>
      <div class="orbit-system orbit-3">
        <div class="orbit-ring orbit-ring-1">
          <div class="orbit-satellite sat-1"></div>
          <div class="orbit-satellite sat-2"></div>
        </div>
        <div class="orbit-core"></div>
      </div>
    </div>

    <!-- Energy beam / laser lines shooting across -->
    <div class="energy-beams">
      <div class="energy-beam beam-1"></div>
      <div class="energy-beam beam-2"></div>
      <div class="energy-beam beam-3"></div>
      <div class="energy-beam beam-4"></div>
      <div class="energy-beam beam-5"></div>
    </div>

    <!-- Glitch bars that flash occasionally -->
    <div class="glitch-layer">
      <div class="glitch-bar glitch-bar-1"></div>
      <div class="glitch-bar glitch-bar-2"></div>
      <div class="glitch-bar glitch-bar-3"></div>
    </div>

    <!-- DNA Helix / double helix data structure -->
    <div class="helix-container">
      <div class="helix-strand helix-left"></div>
      <div class="helix-strand helix-right"></div>
    </div>

    <!-- Pulsing data nodes with connection lines -->
    <div class="data-nodes">
      <div class="data-node node-pos-1">
        <div class="node-center"></div>
        <div class="node-ring node-ring-1"></div>
        <div class="node-ring node-ring-2"></div>
        <div class="node-ring node-ring-3"></div>
      </div>
      <div class="data-node node-pos-2">
        <div class="node-center"></div>
        <div class="node-ring node-ring-1"></div>
        <div class="node-ring node-ring-2"></div>
        <div class="node-ring node-ring-3"></div>
      </div>
      <div class="data-node node-pos-3">
        <div class="node-center"></div>
        <div class="node-ring node-ring-1"></div>
        <div class="node-ring node-ring-2"></div>
      </div>
      <div class="data-node node-pos-4">
        <div class="node-center"></div>
        <div class="node-ring node-ring-1"></div>
        <div class="node-ring node-ring-2"></div>
      </div>
      <div class="data-node node-pos-5">
        <div class="node-center"></div>
        <div class="node-ring node-ring-1"></div>
        <div class="node-ring node-ring-2"></div>
        <div class="node-ring node-ring-3"></div>
      </div>
      <div class="data-node node-pos-6">
        <div class="node-center"></div>
        <div class="node-ring node-ring-1"></div>
        <div class="node-ring node-ring-2"></div>
      </div>
      <div class="data-node node-pos-7">
        <div class="node-center"></div>
        <div class="node-ring node-ring-1"></div>
      </div>
    </div>

    <!-- Glowing orbs -->
    <div class="exp-orb exp-orb-1"></div>
    <div class="exp-orb exp-orb-2"></div>
    <div class="exp-orb exp-orb-3"></div>
    <div class="exp-orb exp-orb-4"></div>

    <!-- Gradient mesh -->
    <div class="exp-mesh-gradient"></div>

    <!-- Grid overlay -->
    <div class="exp-grid-overlay"></div>

    <!-- Hexagonal grid -->
    <div class="hex-grid-layer"><div class="hex-grid"></div></div>

    <!-- Noise -->
    <div class="exp-noise-overlay"></div>

    <!-- Scanlines -->
    <div class="exp-scanline"></div>

    <!-- Floating particles -->
    <div class="exp-particles" id="exp-particles"></div>

    <!-- Mouse follower glow -->
    <div class="mouse-glow" id="mouse-glow"></div>

    <!-- Mouse trail sparkles container -->
    <div class="mouse-trail" id="mouse-trail"></div>
  </div>

  <div class="exp-container">
    <header class="exp-header fade-up-element">
      <div class="exp-header-deco" aria-hidden="true">
        <div class="exp-deco-wing exp-deco-wing-left">
          <div class="exp-deco-line"></div>
          <div class="exp-deco-dot"></div>
        </div>
        <div class="exp-deco-center">
          <div class="exp-deco-hexagon">
            <svg width="18" height="20" viewBox="0 0 18 20" fill="none">
              <path d="M9 1L16.7 5.5V14.5L9 19L1.3 14.5V5.5L9 1Z" stroke="currentColor" stroke-width="1.2"/>
            </svg>
          </div>
        </div>
        <div class="exp-deco-wing exp-deco-wing-right">
          <div class="exp-deco-dot"></div>
          <div class="exp-deco-line"></div>
        </div>
      </div>

      <div class="exp-badge">
        <span class="exp-badge-dot"></span>
        <span class="exp-badge-text">CAREER PATH</span>
      </div>

      <h2 class="exp-title">
        <span class="exp-title-line exp-title-line-1">
          Professional
        </span>
        <span class="exp-title-line exp-title-line-2">
          Experience
        </span>
      </h2>

      <p class="exp-subtitle">
        Building high-performance systems and modern digital experiences.
      </p>

      <div class="exp-scroll-hint" aria-hidden="true">
        <div class="exp-scroll-line">
          <div class="exp-scroll-dot"></div>
        </div>
      </div>
    </header>

    <div class="exp-timeline-wrapper">
      <div class="exp-timeline-track" aria-hidden="true">
        <div class="exp-timeline-progress" id="exp-progress-line">
          <div class="exp-timeline-glow"></div>
        </div>
      </div>

      <div class="exp-timeline">
        {experiences.map((exp, i) => (
          <div
            class={`exp-item ${i % 2 === 0 ? 'exp-left' : 'exp-right'} fade-up-element`}
            style={`--theme-color: ${accentColors[i].color}; --theme-rgb: ${accentColors[i].rgb}; --item-index: ${i};`}
            data-index={i}
          >
            <div class="exp-node">
              <div class="exp-node-ring"></div>
              <div class="exp-node-core">
                {exp.current && <div class="exp-node-ping"></div>}
                {exp.current && <div class="exp-node-ping exp-node-ping-2"></div>}
              </div>
            </div>

            <div class="exp-connector">
              <div class="exp-connector-line"></div>
              <div class="exp-connector-dot"></div>
            </div>

            <div class="exp-card-wrapper">
              <div class="exp-date-float desktop-date">
                <div class="exp-date-float-inner">
                  <svg class="exp-date-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                  <span class="exp-date-text">{exp.date}</span>
                </div>
              </div>

              <div class="exp-card interactive-card">
                <div class="exp-card-spotlight"></div>
                <div class="exp-card-border-spotlight"></div>
                <div class="exp-card-corner exp-card-corner-tl"></div>
                <div class="exp-card-corner exp-card-corner-br"></div>
                <div class="exp-card-shimmer"></div>

                <div class="exp-card-inner">
                  <div class="exp-card-pattern" aria-hidden="true"></div>

                <div class="exp-card-header">
  <div class="exp-icon-box">
    <span class="exp-icon">{exp.icon}</span>
    <div class="exp-icon-glow"></div>
  </div>
  <div class="exp-title-box">
    <h3 class="exp-company-name">{exp.company}</h3>
    <h4 class="exp-role-name">{exp.role}</h4>
    
    <!-- DATE NOW ALWAYS VISIBLE INSIDE CARD -->
    <div class="exp-date-inline">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" 
           stroke="currentColor" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      <span>{exp.date}</span>
    </div>
  </div>
  <div class="exp-tag-group">
    {exp.tag && (
      <div class={`exp-tag ${exp.current ? 'exp-tag-active' : ''}`}>
        {exp.current && <span class="exp-tag-pulse"></span>}
        {exp.tag}
      </div>
    )}
  </div>
</div>

                  <div class="exp-card-separator">
                    <div class="exp-separator-line"></div>
                  </div>

                  <ul class="exp-bullets">
                    {exp.bullets.map((bullet, bi) => (
                      <li class="exp-bullet-item" style={`--bullet-index: ${bi}`}>
                        <div class="exp-bullet-marker">
                          <svg class="exp-bullet-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                          </svg>
                        </div>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="exp-tech-stack">
                    <div class="exp-tech-header">
                      <div class="exp-tech-header-line"></div>
                      <div class="exp-tech-header-label">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="16,18 22,12 16,6"/>
