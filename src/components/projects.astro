      { key: "Runtime", val: "Node.js (VS Code Extension API)", icon: "🟢" },
      { key: "AI Engine", val: "Google Gemini API, RAG Engine", icon: "🤖" },
      { key: "Parsing", val: "Tree-sitter (JS, TS, Python, Java grammars)", icon: "🌳" },
      { key: "Languages", val: "16+ (JS, TS, Java, Python, Go, Rust, C++, etc.)", icon: "💻" },
    ]
  }
];

function hexToRgb(hex) {
  if (!hex || hex.includes('var')) return '59, 130, 246';
  const h = hex.startsWith('#') ? hex : '#3b82f6';
  const r = parseInt(h.slice(1, 3), 16);
  const g = parseInt(h.slice(3, 5), 16);
  const b = parseInt(h.slice(5, 7), 16);
  return `${r}, ${g}, ${b}`;
}

const GH_ICON = `<svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`;
---


<section id="projects" class="reveal-section ps">
  <div id="projects-background-3d" class="absolute inset-0 z-0 pointer-events-none opacity-40"></div>
  <div id="projects-bg-3d" class="absolute inset-0 z-0 pointer-events-none opacity-50"></div>
  
  <div class="ps-noise"></div>
  <div class="ps-grid-bg"></div>
  <div class="ps-orb ps-orb-1"></div>
  <div class="ps-orb ps-orb-2"></div>

  <div class="ps-inner">
    <!-- Header -->
    <div class="ps-hdr reveal">
      <div class="ps-sys">
        <span class="ps-sys-line"></span>
        <span class="ps-sys-txt">System_Lab</span>
        <span class="ps-sys-line r"></span>
      </div>
      <h2 class="ps-h1">Featured <span class="ps-accent-txt">Projects</span></h2>
      <p class="ps-sub">Production-grade systems built with modern architecture. Click any project to explore.</p>
    </div>

    <!-- Cards Grid -->
    <div class="ps-cards">
      {projects.map((p, i) => (
        <article
          class="pc reveal-blur glass-tilt"
          data-id={p.id}
          style={`--acc:${p.accent}; --acc-rgb:${p.accent.startsWith('#') ? hexToRgb(p.accent) : ''}; --delay:${i * 0.15}s`}
        >
          <!-- Screenshot -->
          <div class="pc-img">
            <img src={p.images[0]} alt={p.title} loading="lazy" />
            <div class="pc-img-fade"></div>
            <div class="pc-overlay">
              <div class="pc-view-btn magnetic">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
                </svg>
                View details
              </div>
            </div>
            <div
              class="pc-status"
              style={`border-color:var(--accent)33;background:var(--accent)0d;color:var(--accent);box-shadow:0 0 15px var(--accent)1a`}
            >
              <span class="pc-dot" style={`background:${p.statusColor};box-shadow:0 0 10px ${p.statusColor}`}></span>
              {p.status}
            </div>
          </div>

          <!-- Body -->
          <div class="pc-body">
            <div class="pc-name">{p.title}</div>
            <span class="pc-sub-txt">{p.subtitle}</span>
            <p class="pc-desc">{p.shortDesc}</p>
            <div class="pc-tags">
              {p.tags.slice(0, 5).map(t => <span class="pc-tag">{t}</span>)}
              {p.tags.length > 5 && <span class="pc-tag more">+{p.tags.length - 5}</span>}
            </div>
            <div class="pc-foot">
              <a
                href={p.github}
                target="_blank"
                rel="noopener"
                class="pc-gh magnetic"
                onclick="event.stopPropagation()"
                style={`border-color: ${p.accent}20; background: ${p.accent}0a`}
                set:html={GH_ICON + " <span>Source</span>"}
              />
              <span class="pc-num">0{i + 1}</span>
            </div>
          </div>

          <!-- Hover accent bar -->
          <div class="pc-bar" style={`background:linear-gradient(90deg,transparent,${p.accent},transparent); height: 3px; box-shadow: 0 0 15px ${p.accent}`}></div>
        </article>
      ))}
    </div>

    <!-- CTA -->
    <div class="ps-cta reveal">
      <a href="https://github.com/Arijhajjaji22" target="_blank" rel="noopener" class="ps-cta-btn">
        <span>View all projects</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- ═══ PREMIUM TWO-COLUMN MODAL ═══ -->
  <div id="proj-modal" class="pm-wrap">
    <div class="pm-backdrop" id="pm-backdrop"></div>
    <div class="pm-box">
      <div class="pm-content">
        <button id="pm-close" class="pm-close" aria-label="Close">✕</button>
        
        <!-- Left: Visual Hero -->
        <div class="pm-left">
          <div class="pm-hero" id="pm-hero-container">
            <div id="pm-imgs" class="pm-imgs-track"></div>
            <div class="pm-hero-fade"></div>
            <div id="pm-dots" class="pm-dots"></div>
          </div>
        </div>

        <!-- Right: Text & Details -->
        <div class="pm-right">
          <div class="pm-scroll">
            <div class="pm-body">
              <div class="pm-header-left">
                <div id="pm-status" class="pm-sbadge"></div>
                <h3 id="pm-title" class="pm-title"></h3>
                <div id="pm-subtitle" class="pm-subtitle"></div>
              </div>
              
              <div class="pm-desc-left">
                <p id="pm-desc" class="pm-desc"></p>
              </div>

              <div class="pm-section-label">HIGHLIGHTS</div>
              <div id="pm-highlights" class="pm-hl-grid"></div>

              <div class="pm-section-label">STACK_ANALYSIS</div>
              <div id="pm-tech" class="pm-tech-grid"></div>

              <div class="pm-section-label">CORE_MODULES</div>
              <div id="pm-tags" class="pm-taglist"></div>

              <div class="pm-footer">
                <a id="pm-gh" href="#" target="_blank" rel="noopener" class="pm-gh-modern">
                   <Fragment set:html={GH_ICON} />
                   <span>INITIALIZE SOURCE REPOSITORY</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
/* ═══ SECTION ═══ */
.ps {
  position: relative;
  padding: 8rem 0 10rem;
  background: #08080a;
  overflow: hidden;
  font-family: 'Inter', sans-serif;
}
.ps-inner {
  position: relative;
  z-index: 10;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* Background layers */
.ps-noise {
  position: absolute; inset: 0; pointer-events: none; opacity: .025;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 200px;
}
.ps-grid-bg {
  position: absolute; inset: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
  background-size: 60px 60px;
}
.ps-orb {
  position: absolute; border-radius: 50%; pointer-events: none;
}
.ps-orb-1 {
  width: 600px; height: 600px; top: -200px; left: -200px;
  background: radial-gradient(circle, rgba(123,47,247,.06) 0%, transparent 70%);
  animation: orbfloat 8s ease-in-out infinite;
}
.ps-orb-2 {
  width: 500px; height: 500px; bottom: -150px; right: -100px;
  background: radial-gradient(circle, rgba(59,130,246,0.06) 0%, transparent 70%);
  animation: orbfloat 10s ease-in-out infinite reverse;
}
@keyframes orbfloat {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-30px); }
}

/* ═══ HEADER ═══ */
.ps-hdr { text-align: center; margin-bottom: 4rem; }
.ps-sys {
  display: inline-flex; align-items: center; gap: 10px; margin-bottom: 1.2rem;
}
.ps-sys-line {
  width: 32px; height: 1px;
  background: linear-gradient(90deg, transparent, var(--primary));
}
.ps-sys-line.r { background: linear-gradient(90deg, var(--primary), transparent); }
.ps-sys-txt {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px; letter-spacing: .4em; color: var(--primary);
  font-weight: 700; text-transform: uppercase;
}
.ps-h1 {
  font-family: 'Outfit', sans-serif;
  font-size: clamp(2rem, 4.5vw, 3.2rem);
  font-weight: 900; color: #fff;
  letter-spacing: -.04em; line-height: 1; margin-bottom: 1rem;
  text-transform: uppercase;
}
.ps-accent-txt {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.ps-sub {
  font-size: 13px; color: rgba(255,255,255,.3);
  max-width: 440px; margin: 0 auto;
}

/* ═══ CARDS GRID ═══ */
.ps-cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.25rem;
}
@media (max-width: 720px) { .ps-cards { grid-template-columns: 1fr; } }

/* ═══ CARD ═══ */
.pc {
  position: relative; cursor: pointer;
  background: rgba(13, 13, 20, 0.4);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 28px; overflow: hidden;
  transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  transition-delay: var(--delay, 0s);
}
.pc::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at 50% 0%, rgba(var(--acc-rgb), 0.1), transparent 70%);
  opacity: 0; transition: opacity 0.5s;
}
.pc:hover {
  transform: translateY(-12px) scale(1.02);
  border-color: rgba(var(--acc-rgb), 0.4);
  background: rgba(13, 13, 20, 0.6);
  box-shadow: 
    0 40px 100px -20px rgba(0,0,0,0.8),
    0 0 40px -5px rgba(var(--acc-rgb), 0.25);
}
.pc:hover::before { opacity: 1; }

/* Card image */
.pc-img {
  position: relative; width: 100%; aspect-ratio: 16/9;
  overflow: hidden; background: #000;
}
.pc-img img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: top center;
  display: block;
  transition: transform .7s cubic-bezier(.16,1,.3,1);
}
.pc:hover .pc-img img { transform: scale(1.06); }
.pc-img-fade {
  position: absolute; bottom: 0; left: 0; right: 0; height: 60%;
  background: linear-gradient(to top, rgba(8,8,14,.95), transparent);
  pointer-events: none;
}
.pc-overlay {
  position: absolute; inset: 0;
  background: rgba(4,4,10,.6);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; transition: opacity .3s;
  backdrop-filter: blur(2px);
}
.pc:hover .pc-overlay { opacity: 1; }
.pc-view-btn {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 22px; border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.1); color: #fff;
  font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .1em;
}
.pc-status {
  position: absolute; top: 10px; right: 10px;
  display: flex; align-items: center; gap: 5px;
  padding: 4px 10px; border-radius: 999px; border: 1px solid;
  font-family: 'JetBrains Mono', monospace; font-size: 8px;
  font-weight: 700; letter-spacing: .12em;
  backdrop-filter: blur(8px);
}
.pc-dot {
  width: 5px; height: 5px; border-radius: 50%;
  animation: pulse 2s infinite;
}
@keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:.3; } }

/* Card body */
.pc-body { padding: 1.25rem 1.4rem 1.3rem; }
.pc-name {
  font-family: 'Outfit', sans-serif;
  font-size: 1.15rem; font-weight: 900; color: #fff;
  margin: 0 0 3px; letter-spacing: -.02em;
  transition: color .3s;
}
.pc:hover .pc-name { color: var(--accent); }
.pc-sub-txt {
  font-size: 11px; color: rgba(255,255,255,.3);
  display: block; margin-bottom: 10px; font-weight: 500;
}
.pc-desc {
  font-size: 12.5px; line-height: 1.65;
  color: rgba(255,255,255,.4); margin-bottom: 12px;
}
.pc-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 14px; }
.pc-tag {
  padding: 5px 12px; border-radius: 8px;
  background: rgba(var(--acc-rgb), 0.03);
  border: 1px solid rgba(var(--acc-rgb), 0.12);
  font-family: 'JetBrains Mono', monospace; font-size: 9px;
  color: var(--acc); font-weight: 750;
  transition: all .25s;
}
.pc-tag:hover { 
  background: var(--acc); color: #000; 
  box-shadow: 0 0 15px rgba(var(--acc-rgb), 0.3);
}
.pc-tag.more { opacity: 0.6; color: var(--accent); }
.pc-foot {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 12px; border-top: 1px solid rgba(255,255,255,.05);
}
.pc-gh {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 13px; border-radius: 8px;
  background: rgba(255,255,255,.03);
  border: 1px solid rgba(255,255,255,.07);
  font-size: 11px; font-weight: 600;
  color: rgba(255,255,255,.38);
  text-decoration: none; transition: all .3s;
}
.pc-gh:hover { color: #fff; border-color: rgba(255,255,255,.2); background: rgba(255,255,255,.06); }
.pc-num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; color: rgba(255,255,255,.1); font-weight: 700;
}
.pc-bar {
  position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
  transform: scaleX(0);
  transition: transform .5s cubic-bezier(.16,1,.3,1);
  transform-origin: left;
}
.pc:hover .pc-bar { transform: scaleX(1); opacity: 0.8; }

/* ═══ CTA ═══ */
.ps-cta { text-align: center; margin-top: 3rem; }
.ps-cta-btn {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 11px 24px; border-radius: 12px;
  background: rgba(255,255,255,.03);
  border: 1px solid rgba(255,255,255,.08);
  font-size: 13px; font-weight: 600;
  color: rgba(255,255,255,.45);
  text-decoration: none; transition: all .3s;
}
.ps-cta-btn:hover { color: #fff; border-color: rgba(255,255,255,.2); background: rgba(255,255,255,.05); }
.ps-cta-btn svg { color: var(--accent); transition: transform .3s; }
.ps-cta-btn:hover svg { transform: translateX(4px); }

/* ═══ REVEAL ANIMATION ═══ */
.reveal {
  opacity: 0; transform: translateY(36px);
  transition: opacity .65s cubic-bezier(.4,0,.2,1), transform .65s cubic-bezier(.4,0,.2,1);
  transition-delay: var(--delay, 0s);
}
.reveal.in-view { opacity: 1; transform: translateY(0); }

/* ═══ MODAL ═══ */
.pm-wrap {
  position: fixed; inset: 0; z-index: 100000;
  opacity: 0; pointer-events: none;
  transition: opacity .5s cubic-bezier(0.16, 1, 0.3, 1);
}
.pm-wrap.active { opacity: 1; pointer-events: auto; }
.pm-backdrop {
  position: absolute; inset: 0;
  background: rgba(4, 4, 8, 0.95);
  backdrop-filter: blur(20px);
}
.pm-box {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  padding: 2rem; pointer-events: none;
}
.pm-wrap.active .pm-box {
  pointer-events: auto;
}

.pm-content {
  position: relative;
  width: 100%; max-width: 1400px; height: 90vh;
  display: flex; flex-direction: column; overflow-y: auto;
  background: #08080a;
  border: 1px solid rgba(255,255,255,.08); border-radius: 24px;
  box-shadow: 0 50px 100px rgba(0,0,0,.9);
  transform: scale(.95) translateY(20px);
  opacity: 0; pointer-events: none;
  transition: transform .6s cubic-bezier(.16,1,.3,1), opacity .6s ease;
}
.pm-wrap.active .pm-content { 
  transform: scale(1) translateY(0); 
  opacity: 1; pointer-events: auto; 
}

.pm-left {
  width: 100%; height: auto; min-height: 400px; position: relative; background: #000;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}
.pm-right {
  width: 100%; height: auto; position: relative;
}

.pm-scroll {
  width: 100%; height: auto; overflow: visible;
}
.pm-scroll::-webkit-scrollbar { width: 5px; }
.pm-scroll::-webkit-scrollbar-thumb { background: var(--acc); border-radius: 10px; }

.pm-close {
  position: absolute; top: 24px; right: 24px;
  width: 48px; height: 48px; border-radius: 50%;
  background: rgba(255,255,255,0.05); border: 1px solid rgba(255, 255, 255, 0.1);
  color: #fff; font-size: 18px; display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1); 
  z-index: 110; backdrop-filter: blur(12px);
}
.pm-close:hover { background: var(--acc); color: #000; border-color: var(--acc); transform: scale(1.1) rotate(90deg); }

.pm-hero {
  position: relative; height: 100%; width: 100%; overflow: hidden;
  background: #030305; display: none;
  border-radius: 24px 0 0 24px;
}
.pm-hero.has-imgs { display: block; }
.pm-imgs-track { display: flex; height: 100%; transition: transform .6s cubic-bezier(.16,1,.3,1); }
.pm-imgs-track img {
  min-width: 100%; height: 100%;
  object-fit: contain; /* Show the entire image without cropping! */
  object-position: center; 
  flex-shrink: 0; background: transparent;
  padding: 2rem; /* Give the image some elegant breathing room */
}
/* A subtle gradient behind the contained image */
.pm-hero::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at center, rgba(255,255,255,0.03), transparent 70%);
  pointer-events: none;
}
.pm-hero-fade { display: none; }
.pm-dots {
  position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%);
  display: flex; gap: 10px; z-index: 5;
}
.pm-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: rgba(255,255,255,.25); cursor: pointer; transition: all .3s;
}
.pm-dot.active { background: var(--acc); box-shadow: 0 0 15px var(--acc); width: 28px; border-radius: 4px; }

/* ── MODAL BODY ── */
.pm-body { padding: 4rem 3.5rem; }

.pm-header-left { text-align: left; margin-bottom: 2rem; }
.pm-sbadge {
  display: inline-flex; align-items: center; gap: 10px; padding: 6px 16px; border-radius: 99px;
  background: rgba(var(--acc-rgb), 0.1); color: var(--acc); border: 1px solid rgba(var(--acc-rgb), 0.3);
  font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 850; letter-spacing: 0.2em; 
  text-transform: uppercase; margin-bottom: 1.5rem; box-shadow: 0 0 30px rgba(var(--acc-rgb), 0.15);
}
.pm-title {
  font-family: 'Outfit', sans-serif !important; font-size: 2.2rem !important; 
  font-weight: 900 !important; letter-spacing: -0.03em !important; line-height: 1.1 !important;
  text-transform: uppercase; margin: 0 0 0.5rem 0 !important; color: #fff;
}
.pm-subtitle {
  font-family: 'Inter', sans-serif !important; font-size: 0.85rem !important; 
  font-weight: 800 !important; color: var(--acc) !important; letter-spacing: 0.35em !important;
  text-transform: uppercase; text-shadow: 0 0 25px rgba(var(--acc-rgb), 0.4);
}

.pm-desc-left {
  max-width: 100%; margin: 0 0 2.5rem; text-align: left;
}
.pm-desc { font-size: 1rem !important; line-height: 1.75 !important; color: rgba(255,255,255,0.6); font-weight: 400; }

/* ── MOBILE MODAL OVERRIDES ── */
@media (max-width: 1024px) {
  .pm-content { 
    flex-direction: column !important; 
    overflow-y: auto !important; 
    height: 94vh !important; 
    width: 94% !important; 
    max-width: 700px !important; 
    border-radius: 20px !important; 
  }
  .pm-left { 
    width: 100% !important; 
    height: auto !important; 
    min-height: 280px !important; 
    max-height: 45vh !important;
    aspect-ratio: auto !important; 
    border-right: none !important; 
    border-bottom: 1px solid rgba(255,255,255,0.08) !important; 
  }
  .pm-hero { border-radius: 20px 20px 0 0 !important; }
  .pm-imgs-track img { padding: 1rem !important; }
  .pm-right { width: 100% !important; height: auto !important; overflow: visible !important; }
  .pm-scroll { overflow: visible !important; height: auto !important; }
  .pm-body { padding: 2.5rem 1.75rem !important; }
  .pm-title { font-size: 1.8rem !important; }
  .pm-close { top: 16px; right: 16px; width: 40px; height: 40px; font-size: 16px; }
}

@media (max-width: 480px) {
  .pm-left { min-height: 220px !important; }
  .pm-body { padding: 2rem 1.25rem !important; }
  .pm-title { font-size: 1.6rem !important; }
  .pm-subtitle { font-size: 0.75rem !important; letter-spacing: 0.2em !important; }
  .pm-gh-modern { width: 100%; text-align: center; }
}

.pm-section-label {
  font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--acc);
  letter-spacing: 0.5em; text-transform: uppercase; margin-bottom: 1.5rem;
  display: flex; align-items: center; gap: 1.5rem; opacity: 0.9;
}
.pm-section-label::after { content:''; flex:1; height:1px; background: linear-gradient(90deg, rgba(var(--acc-rgb), 0.4), transparent); }

.pm-hl-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-bottom: 3.5rem; }
.pm-hl {
  background: rgba(255,255,255, 0.012) !important; backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255, 0.04) !important; border-radius: 16px !important;
  padding: 1.5rem !important; transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1) !important;
  position: relative; overflow: hidden;
}
.pm-hl::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(var(--acc-rgb), 0.1), transparent 70%);
  opacity: 0; transition: opacity 0.5s; pointer-events: none;
}
.pm-hl:hover::after { opacity: 1; }
.pm-hl:hover { 
  border-color: rgba(var(--acc-rgb), 0.5) !important; 
  transform: translateY(-8px) scale(1.02);
  background: rgba(var(--acc-rgb), 0.03) !important;
  box-shadow: 0 40px 80px rgba(0,0,0,0.6), 0 0 30px rgba(var(--acc-rgb), 0.1);
}
.pm-hl-title { font-family: 'Outfit', sans-serif; font-size: 0.95rem; color: #fff; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px; }
.pm-hl-text { font-size: 0.95rem; color: rgba(255,255,255,0.5); line-height: 1.7; }

.pm-tech-grid { display: grid; grid-template-columns: 1fr; gap: 0.75rem; margin-bottom: 3rem; }
.pm-tech-item {
  background: rgba(255,255,255,0.01) !important; border: 1px solid rgba(255,255,255,0.04) !important;
  border-radius: 12px !important; padding: 1rem !important; display: flex; align-items: center; gap: 1rem;
  transition: all 0.4s ease;
}
.pm-tech-item:hover { 
  border-color: rgba(var(--acc-rgb), 0.6) !important; 
  background: rgba(var(--acc-rgb), 0.05) !important; 
  transform: scale(1.03);
  box-shadow: 0 20px 40px rgba(0,0,0,0.4), 0 0 25px rgba(var(--acc-rgb), 0.15);
}
.pm-tech-icon { 
  width: 62px; height: 62px; border-radius: 16px; 
  background: rgba(0,0,0,0.6); 
  display: flex; align-items: center; justify-content: center; font-size: 26px; 
  border: 1px solid rgba(255,255,255,0.1);
  transition: all 0.4s ease;
}
.pm-tech-item:hover .pm-tech-icon { border-color: var(--acc); transform: rotate(-5deg) scale(1.1); box-shadow: 0 0 15px rgba(var(--acc-rgb), 0.3); }
.pm-tech-key { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--acc); font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 4px; }
.pm-tech-val { font-size: 0.9rem; color: rgba(255,255,255,0.6); }

.pm-taglist { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 4rem; }
.pm-tag-item {
  background: rgba(var(--acc-rgb), 0.08) !important; color: var(--acc) !important;
  border: 1px solid rgba(var(--acc-rgb), 0.25) !important; padding: 10px 24px !important; 
  border-radius: 12px !important; font-family: 'JetBrains Mono', monospace !important; 
  font-size: 0.75rem !important; font-weight: 800 !important; letter-spacing: 0.05em;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}
.pm-tag-item:hover { background: var(--acc) !important; color: #000 !important; transform: translateY(-5px); box-shadow: 0 15px 30px rgba(var(--acc-rgb), 0.3); }

.pm-footer { padding-top: 3rem; border-top: 1px solid rgba(255,255,255,0.06); }
.pm-gh-modern {
  display: inline-flex; align-items: center; justify-content: center; gap: 1rem;
  padding: 1rem 1.75rem; background: var(--acc); color: #000; border-radius: 12px;
  font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; font-weight: 950; 
  letter-spacing: 0.15em; text-decoration: none; transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}
.pm-gh-modern:hover { transform: translateY(-8px); box-shadow: 0 25px 50px rgba(var(--acc-rgb), 0.4); }

/* Removed buggy child staggering that caused invisible modal text on older renderers */
.pm-body { opacity: 1 !important; transform: none !important; }
</style>


<script define:vars={{ projects }}>
(function () {

  /* ── Hex to RGB Helper for Dynamic Vars ── */
  function hexToRgb(hex) {
    if (!hex || hex.includes('var')) return '59, 130, 246';
    const h = hex.startsWith('#') ? hex : '#3b82f6';
    const r = parseInt(h.slice(1, 3), 16);
    const g = parseInt(h.slice(3, 5), 16);
    const b = parseInt(h.slice(5, 7), 16);
    return `${r}, ${g}, ${b}`;
  }

  /* ── Reveal on scroll ── */
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in-view'); });
  }, { threshold: 0.1, rootMargin: '-20px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  /* ── 3-D tilt on cards ── */
  if (matchMedia('(hover:hover)').matches) {
    document.querySelectorAll('.pc').forEach(card => {
      card.addEventListener('mousemove', e => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top)  / r.height - 0.5;
        card.style.transform = `perspective(800px) rotateX(${y * -4}deg) rotateY(${x * 4}deg) translateY(-8px) scale(1.01)`;
      });
      card.addEventListener('mouseleave', () => { card.style.transform = ''; });
    });
  }

  /* ── Modal ── */
  const modal    = document.getElementById('proj-modal');
  const backdrop = document.getElementById('pm-backdrop');
  if (!modal) return;

  function openModal(id) {
    const p = projects.find(x => x.id === id);
    if (!p) return;

    document.body.style.overflow = 'hidden';
    modal.classList.add('active');
    modal.querySelector('.pm-content').scrollTop = 0; // Reset scroll to top!

    /* ── FIX: inject --acc and --acc-rgb onto the modal content box ── */
    const contentBox = modal.querySelector('.pm-content');
    contentBox.style.setProperty('--acc', p.accent);
    contentBox.style.setProperty('--acc-rgb', hexToRgb(p.accent));

    /* status badge */
    const sb = document.getElementById('pm-status');
    const accentCol = p.statusColor || '#3b82f6';
    sb.style.color = accentCol;
    sb.style.borderColor = accentCol + '40';
    sb.style.background = accentCol + '10';
    sb.innerHTML = `<span style="width:7px;height:7px;border-radius:50%;background:${accentCol};display:inline-block;box-shadow:0 0 10px ${accentCol}"></span> ${p.status}`;

    /* title & desc */
    document.getElementById('pm-title').textContent = p.title;
    const sub = document.getElementById('pm-subtitle');
    if (sub) {
      sub.textContent = p.subtitle;
      sub.style.color = p.accent;
    }
    document.getElementById('pm-desc').textContent = p.fullDesc || p.shortDesc;

    /* hero images */
    const hero  = document.getElementById('pm-hero-container');
    const track = document.getElementById('pm-imgs');
    const dots  = document.getElementById('pm-dots');
    
    if (p.images && p.images.length > 0) {
      hero.classList.add('has-imgs');
      track.innerHTML = p.images.map(src => `<img src="${src}" alt="${p.title}" />`).join('');
      track.style.transform = 'translateX(0)';
      if (p.images.length > 1) {
        dots.innerHTML = p.images.map((_, i) => `<div class="pm-dot${i===0?' active':''}" data-s="${i}"></div>`).join('');
        dots.querySelectorAll('.pm-dot').forEach(d => {
          d.onclick = () => {
            const cur = +d.dataset.s;
            track.style.transform = `translateX(-${cur * 100}%)`;
            dots.querySelectorAll('.pm-dot').forEach((x, i) => x.classList.toggle('active', i === cur));
          };
        });
      } else {
        dots.innerHTML = '';
      }
    } else {
      hero.classList.remove('has-imgs');
    }

    /* highlights */
    document.getElementById('pm-highlights').innerHTML = p.highlights.map(h => `
      <div class="pm-hl">
        <div class="pm-hl-icon">${h.icon}</div>
        <div>
          <div class="pm-hl-title">${h.title}</div>
          <p class="pm-hl-text">${h.text}</p>
        </div>
      </div>`).join('');

    /* tech stack */
    document.getElementById('pm-tech').innerHTML = p.techStack.map(t => `
      <div class="pm-tech-item">
        <div class="pm-tech-icon">${t.icon}</div>
        <div>
          <span class="pm-tech-key">${t.key}</span>
          <span class="pm-tech-val">${t.val}</span>
        </div>
      </div>`).join('');

    /* tags */
    document.getElementById('pm-tags').innerHTML = p.tags.map(t => `<span class="pm-tag-item">${t}</span>`).join('');

    /* github link */
    const gh = document.getElementById('pm-gh');
    gh.href = p.github;
    gh.querySelector('span').style.color = accentCol;

    /* Mouse interaction for highlights & tech items */
    document.querySelectorAll('.pm-hl, .pm-tech-item').forEach(card => {
      card.onmousemove = e => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      };
    });

    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  /* ── Events ── */
  document.querySelectorAll('.pc').forEach(card => {
    card.onclick = () => openModal(card.dataset.id);
  });
  document.getElementById('pm-close').onclick = closeModal;
  backdrop.onclick = closeModal;
  document.getElementById('pm-backdrop').onclick = closeModal;
  modal.querySelector('.pm-box').onclick = e => {
    // Only close if clicking directly on the box (the empty space), not the inner content
    if (e.target === modal.querySelector('.pm-box')) closeModal();
  };
  
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
})();
</script>

<script is:inline>
window.addEventListener('load', function initProjects3D() {
  const container = document.getElementById('projects-bg-3d');
  if (!container || typeof THREE === 'undefined') return;

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  const group = new THREE.Group();
  scene.add(group);

  const geo = new THREE.BoxGeometry(1.5, 1.5, 1.5);
  const mat = new THREE.MeshBasicMaterial({ color: 0x7b2ff7, wireframe: true, transparent: true, opacity: 0.12 });
  const mat2 = new THREE.MeshBasicMaterial({ color: 0x3b82f6, wireframe: true, transparent: true, opacity: 0.08 });

  const modules = [];
  for(let i = 0; i < 15; i++) {
     const mesh = new THREE.Mesh(geo, Math.random() > 0.5 ? mat : mat2);
     mesh.position.set(
        (Math.random() - 0.5) * 45,
        (Math.random() - 0.5) * 45,
        -Math.random() * 25
     );
     mesh.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
     mesh.scale.setScalar(1 + Math.random() * 3);
     group.add(mesh);
     modules.push({ mesh, speed: 0.005 + Math.random() * 0.02 });
  }

  camera.position.z = 18;

  function animate() {
    requestAnimationFrame(animate);
    modules.forEach(m => {
       m.mesh.rotation.y += m.speed;
       m.mesh.rotation.x += m.speed * 0.5;
       m.mesh.position.y += Math.sin(Date.now() * 0.001 + m.mesh.position.x) * 0.005;
    });
    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
     camera.aspect = window.innerWidth / window.innerHeight;
     camera.updateProjectionMatrix();
     renderer.setSize(window.innerWidth, window.innerHeight);
  });
});
</script>
