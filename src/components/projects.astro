      { key: "Backend", val: "Spring Boot 3, Spring Security, Spring AI, Gateway, Eureka", icon: "🌿" },
      { key: "AI / ML", val: "OpenRouter API, PGVector, RAG, Jsoup (scraping)", icon: "🤖" },
      { key: "Frontend", val: "Angular, TypeScript, Tailwind CSS", icon: "🅰️" },
      { key: "Infra", val: "Docker, Docker Compose, PostgreSQL 16, Nginx", icon: "🐳" },
    ]
  },
  {
    id: "taskflow",
    title: "TaskFlow",
    subtitle: "Enterprise Kanban & Automation Platform",
    shortDesc: "A collaborative Kanban platform maximizing team productivity through an event-driven architecture and a low-code automation engine.",
    accent: "#3b82f6",
    statusColor: "#3b82f6",
    tags: ["Spring Boot 3", "GraphQL", "Kafka", "Keycloak", "Angular", "n8n", "WebSocket", "Redis"],
    status: "COMPLETED",
    github: "https://github.com/Arijhajjaji22/Taskflow-n8n",
    images: ["/images/taskflow1.PNG"],
