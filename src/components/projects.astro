      { icon: "🧩", title: "Context Engine", text: "Detects frameworks, intent, and file types locally to avoid generic suggestions and save quota." },
      { icon: "⚡", title: "AI Brain", text: "Uses Gemini for surgical fixes with engineered prompts. Context-aware refactoring and logic review." },
      { icon: "🛠️", title: "Fix Applicator", text: "Inline one-click fixes for code actions (💡) with Tree-sitter AST validation to prevent corruption." },
      { icon: "🔒", title: "Security Audit", text: "Vulnerability scanner for SQL injection, XSS, and hardcoded secrets. Specialized Java security analyzer." },
    ],
