      { key: "Backend", val: "Java, Spring Boot 3, Hibernate, Spring Data JPA", icon: "☕" },
      { key: "Events", val: "Apache Kafka, Zookeeper, Redis", icon: "📨" },
      { key: "Orchestration", val: "9 Docker containers (Keycloak, n8n, Kafka, Redis, Postgres)", icon: "🐳" },
    ]
  },
  {
    id: "devops",
    title: "Jenkins DevOps",
    subtitle: "End-to-End Enterprise CI/CD Pipeline",
    shortDesc: "An enterprise Jenkins pipeline with 11 automated stages, integrating strict code quality gates, artifact management, and secure Docker containerization.",
    accent: "#7b2ff7",
    statusColor: "#3b82f6",
    tags: ["Jenkins", "SonarQube", "JaCoCo", "Nexus", "Docker Hub", "Prometheus", "Grafana"],
    status: "COMPLETED",
    github: "https://github.com/Arijhajjaji22/Devops_Arij", // FIXED LINK
    images: ["/images/Devops.jpeg"],
    fullDesc: "This is a comprehensive Jenkins Pipeline for enterprise Java projects. It fully automates the Build → Test → Analyze → Package → Deploy system, ensuring consistent code quality and highly reliable continuous delivery.",
