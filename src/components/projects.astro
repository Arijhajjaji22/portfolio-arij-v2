    accent: "#7b2ff7",
    statusColor: "#3b82f6",
    tags: ["Spring Boot 3", "Spring AI", "Angular", "PGVector", "Redis", "Docker", "Eureka", "JWT RSA"],
    status: "COMPLETED",
    github: "https://github.com/Arijhajjaji22/aura-chatbot",
    images: ["/images/Aura.PNG", "/images/aura2.PNG"],
    fullDesc: "Aura is an intelligent conversational assistant built from scratch to handle multimodal interactions. Users can chat, upload and analyze PDF documents via Retrieval-Augmented Generation (RAG), and continuously fetch real-time data from external APIs.",
