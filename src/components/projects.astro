      { icon: "🚀", title: "Deployment", text: "Automated deployment using Docker Compose with real-time health monitoring and email alerts." },
    ],
    techStack: [
      { key: "Core", val: "Jenkins, Maven, Java, Git", icon: "⚙️" },
      { key: "Quality", val: "SonarQube, JaCoCo, JUnit", icon: "🧪" },
      { key: "Platform", val: "Docker, Docker Compose, Nexus, Docker Hub", icon: "🐳" },
      { key: "Alerting", val: "Email Notification System, Stage View Monitoring", icon: "📧" },
    ]
  },
  {
    id: "aigenius",
    title: "AI Genius",
    subtitle: "Smart Code Doctor — VS Code Extension",
    shortDesc: "A VS Code extension providing intelligent, context-aware code analysis via Google Gemini AI, delivering precise and surgical code fixes.",
    accent: "#c084fc",
    statusColor: "#3b82f6",
    tags: ["Node.js", "Gemini AI", "Tree-sitter", "VS Code API", "RAG", "AST Analysis"],
    status: "COMPLETED",
    github: "https://github.com/Arijhajjaji22/AI-Assistant-Pro", // FIXED LINK
    images: ["/images/plugin.PNG"],
    fullDesc: "AI Genius is an intelligent VS Code extension that reimagines AI-assisted code review. It builds a deep understanding of your codebase's purpose and developer intent before requesting AI analysis, yielding incredibly precise fixes and actionable refactoring suggestions.",
