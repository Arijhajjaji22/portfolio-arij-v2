      { icon: "🔄", title: "11-Stage Flow", text: "Automated stages: Checkout, Maven Clean, Compile, Unit Tests, JaCoCo, SonarQube, Nexus, Docker Build/Push, Deploy." },
      { icon: "📈", title: "Quality Gates", text: "SonarQube & JaCoCo integrated to ensure code quality and over 80% test coverage." },
