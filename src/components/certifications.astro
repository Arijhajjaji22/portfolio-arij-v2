---
const certifications = [
  {
    id: "spring-angular",
    title: "Spring Boot & Angular",
    issuer: "CrocoCoder Academy",
    date: "2024",
    duration: "Full Stack Specialization",
    image: "/images/springangularcertif1.jpg",
    tags: ["Spring", "Angular", "Scale"],
  },
  {
    id: "ai-predictive",
    title: "AI for Predictive Maintenance",
    issuer: "NVIDIA DLI — ESPRIT",
    date: "2023",
    duration: "Competency Node",
    image: "/images/applicationsofai.jpeg",
    tags: ["Deep Learning", "NVIDIA"],
  },
  {
    id: "ai-anomaly",
    title: "AI for Anomaly Detection",
    issuer: "NVIDIA DLI — ESPRIT",
    date: "2023",
    duration: "Competency Node",
    image: "/images/anomalydetection.jpeg",
    tags: ["Neural Nets", "AI"],
  },
];
---

<section id="certifications" class="reveal-section py-20 md:py-32 bg-[#050508] relative min-h-screen overflow-hidden flex flex-col items-center">
  <!-- 3D BACKGROUND -->
  <div id="certs-3d-bg" class="absolute inset-0 z-0 opacity-40 pointer-events-none"></div>
  
  <div class="container mx-auto px-6 relative z-10">
    <!-- Header -->
    <div class="flex flex-col items-center text-center mb-16 md:mb-24">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-[1px] bg-blue-500/50"></div>
        <span class="text-[10px] font-mono text-blue-400 uppercase tracking-[0.4em] font-bold">Verified Expertise</span>
        <div class="w-10 h-[1px] bg-blue-500/50"></div>
      </div>
      <h2 class="text-4xl md:text-6xl font-black font-outfit uppercase tracking-tighter italic text-white leading-none">
        MY <span class="gradient-text-animated not-italic">Certifications</span>
      </h2>
    </div>

    <!-- RESPONSIVE GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
      {certifications.map((cert, i) => (
        <div class="cert-card-new group relative bg-[#0d0d14]/80 backdrop-blur-xl border border-white/5 rounded-2xl overflow-hidden hover:border-blue-500/40 transition-all duration-500 cursor-pointer" 
             data-cert-img={cert.image}
             style={`transition-delay: ${i * 0.1}s`}>
          
          <!-- Image Container (fixed aspect ratio for grid) -->
          <div class="relative aspect-[4/3] w-full bg-black/40 overflow-hidden flex items-center justify-center p-3">
            <img src={cert.image} alt={cert.title} class="max-w-full max-h-full object-contain grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0d0d14] via-transparent to-transparent"></div>
          </div>

          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
               <span class="text-[9px] font-mono text-blue-400 font-black uppercase tracking-widest">{cert.issuer}</span>
               <span class="text-[10px] font-mono text-gray-500 italic">{cert.date}</span>
            </div>
            <h3 class="text-lg font-black font-outfit text-white mb-4 group-hover:text-blue-400 transition-colors uppercase leading-tight">{cert.title}</h3>
            
            <div class="flex items-center justify-between pt-4 border-t border-white/5">
              <span class="text-[9px] font-mono text-gray-500 uppercase">{cert.duration}</span>
              <div class="flex items-center gap-2">
                 <span class="text-[9px] font-bold font-mono text-blue-400 uppercase tracking-widest">EXPAND</span>
                 <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="text-blue-400"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ── VIEWER OVERLAY (FIXED WITH TOP GAP) ── -->
  <div id="cert-viewer" class="fixed inset-0 z-[9999999] opacity-0 pointer-events-none transition-all duration-300">
    <!-- Clickable Background Overlay -->
    <div id="cert-viewer-bg" class="absolute inset-0 bg-black/98 backdrop-blur-2xl cursor-zoom-out"></div>
    
    <!-- Content Scrollable Area -->
    <div id="cert-viewer-scroll" class="absolute inset-0 overflow-y-auto flex flex-col items-center pt-32 pb-20 px-4">
      
      <!-- Close Button (Fixed positioning relative to screen) -->
      <button id="cert-viewer-close" class="fixed top-8 right-8 text-white/50 hover:text-white text-4xl p-2 z-[10000000] transition-colors">✕</button>
      
      <!-- The Certificate Box -->
      <div id="cert-viewer-box" class="relative z-10 w-full max-w-4xl flex flex-col items-center transition-all duration-500 transform scale-95 opacity-0">
        
        <!-- Image display - object-contain ensures no cropping -->
        <div class="bg-black/50 p-2 rounded-xl border border-white/10 shadow-[0_0_80px_rgba(0,0,0,1)] overflow-hidden">
          <img id="cert-viewer-img" src="" class="w-full h-auto max-h-[60vh] object-contain rounded-lg block" alt="Certificate"/>
        </div>
        
        <!-- Download Link -->
        <div class="mt-12">
          <a id="cert-viewer-link" href="#" target="_blank" download class="px-12 py-5 bg-blue-600 hover:bg-blue-500 text-white font-mono text-[12px] font-black uppercase tracking-[0.3em] rounded-full flex items-center gap-4 transition-all shadow-2xl active:scale-95">
             <span>DOWNLOAD CERTIFICATE</span>
             <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .gradient-text-animated {
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #3b82f6);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 3s linear infinite;
  }
  @keyframes shine { to { background-position: 200% center; } }

  /* Modal States */
  #cert-viewer.visible { opacity: 1; pointer-events: auto; }
  #cert-viewer.visible #cert-viewer-box { transform: scale(1); opacity: 1; }
  
  /* Lock body scroll */
  body.viewer-open { overflow: hidden !important; }
</style>

<script is:inline>
  function runCertKit() {
    const viewer = document.getElementById('cert-viewer');
    const vImg = document.getElementById('cert-viewer-img');
    const vLink = document.getElementById('cert-viewer-link');
    const vClose = document.getElementById('cert-viewer-close');
    const vBg = document.getElementById('cert-viewer-bg');
    const vScroll = document.getElementById('cert-viewer-scroll');
    const cards = document.querySelectorAll('[data-cert-img]');

    if (!viewer) return;

    function openViewer(src) {
      vImg.src = src;
      vLink.href = src;
      viewer.classList.add('visible');
      document.body.classList.add('viewer-open');
      if (vScroll) vScroll.scrollTop = 0;
    }

    function closeViewer() {
      viewer.classList.remove('visible');
      document.body.classList.remove('viewer-open');
    }

    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        e.preventDefault();
        openViewer(card.getAttribute('data-cert-img'));
      });
    });

    // EXIT LOGIC
    if (vBg) vBg.onclick = closeViewer;
    if (vClose) vClose.onclick = closeViewer;
    
    // Close if user clicks the scroll background (not the image box)
    if (vScroll) {
      vScroll.onclick = (e) => {
        if (e.target === vScroll) closeViewer();
      };
    }

    document.onkeydown = (e) => {
      if (e.key === 'Escape') closeViewer();
    };
  }

  function initCert3D() {
    const container = document.getElementById('certs-3d-bg');
    if (!container || container.dataset.init === 'true') return;
    container.dataset.init = 'true';

    if (typeof THREE === 'undefined') {
       const script = document.createElement('script');
       script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
       script.onload = () => buildParticles(container);
       document.head.appendChild(script);
    } else {
       buildParticles(container);
    }
  }

  function buildParticles(container) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, container.offsetWidth / container.offsetHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(container.offsetWidth, container.offsetHeight);
    container.appendChild(renderer.domElement);

    const geo = new THREE.BufferGeometry();
    const pos = new Float32Array(800 * 3);
    for(let i=0; i<800*3; i++) pos[i] = (Math.random() - 0.5) * 50;
    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    const mat = new THREE.PointsMaterial({ size: 0.1, color: 0x3b82f6, transparent: true, opacity: 0.3 });
    const pts = new THREE.Points(geo, mat);
    scene.add(pts);
    camera.position.z = 25;

    function anim() {
      requestAnimationFrame(anim);
      pts.rotation.y += 0.0005;
      renderer.render(scene, camera);
    }
    anim();
  }

  document.addEventListener('DOMContentLoaded', runCertKit);
  document.addEventListener('astro:page-load', runCertKit);
  initCert3D();
</script>