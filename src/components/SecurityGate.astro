---
// SecurityGate.astro
---

<div id="security-gate" class="fixed inset-0 z-[200000] font-mono select-none hidden">

  <!-- SOLID BASE -->
  <div class="absolute inset-0 z-10" style="background:#03030a;"></div>

  <!-- GRID -->
  <div class="absolute inset-0 z-10 pointer-events-none" style="
    background-image:
      linear-gradient(rgba(99,102,241,0.05) 1px,transparent 1px),
      linear-gradient(90deg,rgba(99,102,241,0.05) 1px,transparent 1px);
    background-size:48px 48px;
    mask-image:radial-gradient(ellipse 90% 70% at 50% 50%,black 30%,transparent 80%);
  "></div>

  <!-- AMBIENT ORBS -->
  <div class="absolute z-10 pointer-events-none" style="
    top:-15%;left:-10%;width:700px;height:700px;border-radius:50%;
    background:radial-gradient(circle,rgba(99,102,241,0.10) 0%,transparent 65%);
    filter:blur(80px);animation:orbA 20s ease-in-out infinite;
  "></div>
  <div class="absolute z-10 pointer-events-none" style="
    bottom:-15%;right:-10%;width:600px;height:600px;border-radius:50%;
    background:radial-gradient(circle,rgba(139,92,246,0.09) 0%,transparent 65%);
    filter:blur(80px);animation:orbB 25s ease-in-out infinite;
  "></div>
  <div class="absolute z-10 pointer-events-none" style="
    top:40%;left:50%;transform:translateX(-50%);width:400px;height:400px;border-radius:50%;
    background:radial-gradient(circle,rgba(59,130,246,0.06) 0%,transparent 65%);
    filter:blur(60px);animation:orbC 15s ease-in-out infinite;
  "></div>

  <!-- SCANLINES -->
  <div class="absolute inset-0 z-10 pointer-events-none" style="
    background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.18) 2px,rgba(0,0,0,0.18) 4px);
    opacity:0.4;
  "></div>

  <!-- MOVING SCAN BEAM -->
  <div id="global-scan" class="absolute left-0 right-0 z-10 pointer-events-none" style="
    height:1px;
    background:linear-gradient(90deg,transparent 0%,rgba(99,102,241,0.0) 20%,rgba(99,102,241,0.5) 50%,rgba(139,92,246,0.5) 60%,transparent 100%);
    animation:globalScan 6s linear infinite;
    box-shadow:0 0 8px rgba(99,102,241,0.3);
  "></div>

  <!-- DOOR PANELS -->
  <div id="gate-l" class="absolute inset-y-0 left-0 w-1/2 z-20" style="
    background:#03030a;
    border-right:1px solid rgba(99,102,241,0.08);
    transition:transform 1.2s cubic-bezier(0.76,0,0.24,1);
  "></div>
  <div id="gate-r" class="absolute inset-y-0 right-0 w-1/2 z-20" style="
    background:#03030a;
    border-left:1px solid rgba(99,102,241,0.08);
    transition:transform 1.2s cubic-bezier(0.76,0,0.24,1);
  "></div>

  <!-- MAIN CARD -->
  <div class="absolute inset-0 flex items-center justify-center p-4 z-30">
    <div id="gate-screen" class="w-full max-w-xl relative transition-opacity duration-700" style="
      background:rgba(6,6,16,0.92);
      backdrop-filter:blur(48px);
      border:1px solid rgba(99,102,241,0.18);
      border-radius:28px;
      padding:48px 44px;
      box-shadow:
        0 0 0 1px rgba(99,102,241,0.06),
        0 0 60px rgba(99,102,241,0.08),
        0 40px 80px rgba(0,0,0,0.6),
        inset 0 1px 0 rgba(255,255,255,0.04);
    ">

      <!-- TOP SHIMMER LINE -->
      <div class="absolute top-0 left-8 right-8 h-px pointer-events-none" style="
        background:linear-gradient(90deg,transparent,rgba(99,102,241,0.7),rgba(139,92,246,0.7),rgba(59,130,246,0.5),transparent);
        border-radius:1px;
        animation:topShimmer 4s ease-in-out infinite;
      "></div>

      <!-- CORNER BRACKETS -->
      <div class="absolute pointer-events-none" style="top:18px;left:18px;width:20px;height:20px;border-top:1px solid rgba(99,102,241,0.6);border-left:1px solid rgba(99,102,241,0.6);border-radius:6px 0 0 0;"></div>
      <div class="absolute pointer-events-none" style="top:18px;right:18px;width:20px;height:20px;border-top:1px solid rgba(99,102,241,0.6);border-right:1px solid rgba(99,102,241,0.6);border-radius:0 6px 0 0;"></div>
      <div class="absolute pointer-events-none" style="bottom:18px;left:18px;width:20px;height:20px;border-bottom:1px solid rgba(99,102,241,0.6);border-left:1px solid rgba(99,102,241,0.6);border-radius:0 0 0 6px;"></div>
      <div class="absolute pointer-events-none" style="bottom:18px;right:18px;width:20px;height:20px;border-bottom:1px solid rgba(99,102,241,0.6);border-right:1px solid rgba(99,102,241,0.6);border-radius:0 0 6px 0;"></div>

      <!-- STATUS DOTS top right -->
      <div class="absolute flex gap-2 pointer-events-none" style="top:20px;right:52px;">
        <div style="width:6px;height:6px;border-radius:50%;background:#ef4444;box-shadow:0 0 6px #ef4444;animation:statusPulse 2s ease-in-out infinite;"></div>
        <div style="width:6px;height:6px;border-radius:50%;background:#f59e0b;box-shadow:0 0 6px #f59e0b;animation:statusPulse 2s ease-in-out infinite 0.3s;"></div>
        <div style="width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 6px #22c55e;animation:statusPulse 2s ease-in-out infinite 0.6s;"></div>
      </div>

      <!-- HEADER -->
      <div class="text-center" style="margin-bottom:36px;">

        <!-- System label -->
        <div style="display:inline-flex;align-items:center;gap:10px;margin-bottom:20px;">
          <div style="width:24px;height:1px;background:rgba(99,102,241,0.5);"></div>
          <span id="sys-label" style="font-size:8px;color:#6366f1;letter-spacing:0.5em;text-transform:uppercase;font-weight:700;"></span>
          <div style="width:24px;height:1px;background:rgba(99,102,241,0.5);"></div>
        </div>

        <!-- TITLE — big, clean, layered -->
        <div style="position:relative;display:inline-block;margin-bottom:8px;">

          <!-- Glow behind title -->
          <div style="
            position:absolute;inset:-20px -40px;
            background:radial-gradient(ellipse,rgba(99,102,241,0.12) 0%,transparent 70%);
            pointer-events:none;filter:blur(12px);
          "></div>

          <!-- Name line -->
          <div id="gate-name" style="
            font-family:'Outfit',sans-serif;
            font-size:clamp(26px,5vw,40px);
            font-weight:900;
            letter-spacing:-0.03em;
            text-transform:uppercase;
            line-height:1;
            color:#fff;
            position:relative;
            text-shadow:0 0 40px rgba(99,102,241,0.4);
          ">ARIJ HAJJAJI</div>

          <!-- Separator -->
          <div style="
            width:100%;height:1px;margin:10px 0;
            background:linear-gradient(90deg,transparent,rgba(99,102,241,0.5),rgba(139,92,246,0.5),transparent);
          "></div>

          <!-- Subtitle line -->
          <div style="
            font-size:10px;
            letter-spacing:0.45em;
            text-transform:uppercase;
            font-weight:700;
            background:linear-gradient(90deg,#6366f1,#8b5cf6,#3b82f6);
            -webkit-background-clip:text;-webkit-text-fill-color:transparent;
            animation:subtitleShimmer 4s linear infinite;
            background-size:200% auto;
          ">SECURITY PORTAL // FIREWALL.04</div>
        </div>

        <!-- Live status pill -->
        <div style="display:inline-flex;align-items:center;gap:8px;margin-top:14px;padding:5px 14px;background:rgba(34,197,94,0.06);border:1px solid rgba(34,197,94,0.2);border-radius:100px;">
          <div style="width:5px;height:5px;border-radius:50%;background:#22c55e;box-shadow:0 0 8px #22c55e;animation:statusPulse 1.5s ease-in-out infinite;"></div>
          <span id="live-status" style="font-size:8px;color:#22c55e;letter-spacing:0.3em;text-transform:uppercase;font-weight:700;">SYSTEM ONLINE</span>
        </div>
      </div>

      <!-- ── PHASE 0: START ── -->
      <div id="p0-start" style="display:flex;flex-direction:column;align-items:center;padding:24px 0 8px;">
        <div style="font-size:9px;color:#4f46e5;margin-bottom:28px;letter-spacing:0.3em;text-transform:uppercase;animation:blinkText 2s step-end infinite;">
          ▸ AWAITING BIOMETRIC INPUT
        </div>

        <button id="gate-start-btn" style="
          display:flex;flex-direction:column;align-items:center;gap:16px;
          padding:28px 52px;
          background:rgba(99,102,241,0.04);
          border:1px solid rgba(99,102,241,0.25);
          border-radius:20px;
          cursor:pointer;
          transition:all 0.4s cubic-bezier(0.16,1,0.3,1);
          position:relative;overflow:hidden;
        ">
          <!-- Button shimmer -->
          <div id="btn-shimmer" style="
            position:absolute;top:0;left:-100%;width:60%;height:100%;
            background:linear-gradient(90deg,transparent,rgba(99,102,241,0.08),transparent);
            transition:left 0.6s ease;pointer-events:none;
          "></div>

          <!-- Radar animation -->
          <div style="position:relative;width:68px;height:68px;">
            <div style="position:absolute;inset:0;border-radius:50%;border:1px solid rgba(99,102,241,0.3);animation:radarPing 2s ease-out infinite;"></div>
            <div style="position:absolute;inset:8px;border-radius:50%;border:1px solid rgba(99,102,241,0.2);animation:radarPing 2s ease-out infinite 0.7s;"></div>
            <div style="
              position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
              width:68px;height:68px;border-radius:50%;
              border:1px solid rgba(99,102,241,0.4);
              background:rgba(99,102,241,0.06);
            ">
              <div id="start-core" style="
                width:18px;height:18px;border-radius:50%;
                background:radial-gradient(circle,#818cf8,#6366f1);
                box-shadow:0 0 16px rgba(99,102,241,0.8),0 0 32px rgba(99,102,241,0.3);
                transition:all 0.3s;
              "></div>
            </div>
          </div>

          <span style="font-size:9px;font-weight:700;letter-spacing:0.5em;color:#818cf8;text-transform:uppercase;">INITIATE_CONTACT</span>
        </button>

        <button id="bypass-gate" style="
          margin-top:24px;font-size:8px;color:#1e1b4b;
          letter-spacing:0.3em;text-transform:uppercase;
          background:none;border:none;cursor:pointer;transition:color 0.3s;
        ">bypass_security.exe</button>
      </div>

      <!-- ── PHASE 1: BOOT ── -->
      <div id="p1-boot" style="display:none;padding:20px 0;">
        <div style="
          font-size:9px;color:#4f46e5;letter-spacing:0.3em;text-transform:uppercase;
          margin-bottom:16px;
        ">// SYSTEM BOOT SEQUENCE</div>
        <div id="boot-log" style="font-size:11px;color:#818cf8;line-height:2;min-height:120px;"></div>
        <div style="width:100%;height:2px;background:rgba(255,255,255,0.04);border-radius:2px;margin-top:20px;overflow:hidden;">
          <div id="boot-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#6366f1,#8b5cf6,#3b82f6);border-radius:2px;transition:width 0.25s ease;box-shadow:0 0 8px rgba(99,102,241,0.5);"></div>
        </div>
        <div id="boot-pct" style="font-size:9px;color:#4338ca;text-align:right;margin-top:6px;letter-spacing:0.1em;">0%</div>
      </div>

      <!-- ── PHASE 2: SCAN ── -->
      <div id="p2-scan" style="display:none;flex-direction:column;align-items:center;">
        <!-- Scanner box -->
        <div style="
          width:200px;height:200px;
          border:1px solid rgba(59,130,246,0.25);
          border-radius:20px;
          position:relative;overflow:hidden;
          margin-bottom:28px;
          background:rgba(0,0,12,0.6);
        ">
          <!-- Scan beam -->
          <div class="scan-line-anim" style="
            position:absolute;left:0;right:0;height:2px;
            background:linear-gradient(90deg,transparent,rgba(99,102,241,0.8),rgba(139,92,246,1),rgba(59,130,246,0.8),transparent);
            box-shadow:0 0 12px rgba(99,102,241,0.6),0 0 24px rgba(99,102,241,0.2);
          "></div>
          <!-- Corner marks -->
          <div style="position:absolute;top:10px;left:10px;width:14px;height:14px;border-top:1px solid rgba(99,102,241,0.6);border-left:1px solid rgba(99,102,241,0.6);"></div>
          <div style="position:absolute;top:10px;right:10px;width:14px;height:14px;border-top:1px solid rgba(99,102,241,0.6);border-right:1px solid rgba(99,102,241,0.6);"></div>
          <div style="position:absolute;bottom:10px;left:10px;width:14px;height:14px;border-bottom:1px solid rgba(99,102,241,0.6);border-left:1px solid rgba(99,102,241,0.6);"></div>
          <div style="position:absolute;bottom:10px;right:10px;width:14px;height:14px;border-bottom:1px solid rgba(99,102,241,0.6);border-right:1px solid rgba(99,102,241,0.6);"></div>
          <!-- Target reticle -->
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
            <div style="position:relative;width:60px;height:60px;">
              <div style="position:absolute;inset:0;border:1px solid rgba(99,102,241,0.15);border-radius:50%;"></div>
              <div style="position:absolute;inset:8px;border:1px solid rgba(99,102,241,0.1);border-radius:50%;"></div>
              <div style="position:absolute;top:50%;left:0;right:0;height:1px;background:rgba(99,102,241,0.12);"></div>
              <div style="position:absolute;left:50%;top:0;bottom:0;width:1px;background:rgba(99,102,241,0.12);"></div>
              <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
                <div style="width:6px;height:6px;border-radius:50%;background:#6366f1;box-shadow:0 0 8px #6366f1;"></div>
              </div>
            </div>
          </div>
        </div>
        <div id="scan-log" style="width:100%;text-align:left;font-size:11px;color:#475569;line-height:2;padding:0 8px;"></div>
      </div>

      <!-- ── PHASE 3: CHALLENGE ── -->
      <div id="p3-challenge" style="display:none;text-align:center;">
        <div style="font-size:9px;letter-spacing:0.4em;color:rgba(255,255,255,0.3);text-transform:uppercase;margin-bottom:28px;">
          ▸ IDENTITY VERIFICATION REQUIRED
        </div>

        <!-- Challenge A -->
        <div id="ch-a" style="display:none;flex-direction:column;align-items:center;gap:20px;">
          <p style="font-size:13px;color:#94a3b8;">Tap exactly <span style="color:#818cf8;font-weight:700;">3 times</span></p>
          <button id="ch-tap-btn" style="
            width:110px;height:110px;border-radius:50%;
            border:1.5px solid rgba(99,102,241,0.4);
            font-size:40px;font-weight:900;color:#fff;
            background:rgba(99,102,241,0.04);
            cursor:pointer;transition:all 0.2s;
            box-shadow:0 0 0 0 rgba(99,102,241,0);
          ">0</button>
          <div id="ch-msg-a" style="font-size:10px;color:#ef4444;height:14px;letter-spacing:0.1em;"></div>
        </div>

        <!-- Challenge B -->
        <div id="ch-b" style="display:none;flex-direction:column;align-items:center;gap:20px;">
          <p style="font-size:13px;color:#94a3b8;">Click exactly <span style="color:#818cf8;font-weight:700;">7 times</span></p>
          <button id="ch-btn" style="
            width:110px;height:110px;border-radius:50%;
            border:1.5px solid rgba(99,102,241,0.6);
            font-size:40px;font-weight:900;color:#fff;
            background:rgba(99,102,241,0.06);
            cursor:pointer;transition:all 0.15s;
          ">0</button>
          <div id="ch-msg-b" style="font-size:10px;color:#ef4444;height:14px;letter-spacing:0.1em;"></div>
        </div>

        <!-- Challenge C -->
        <div id="ch-c" style="display:none;flex-direction:column;align-items:center;gap:20px;">
          <p style="font-size:13px;color:#94a3b8;">Set to exactly <span style="color:#818cf8;font-weight:700;">42%</span></p>
          <div style="position:relative;width:260px;padding-top:28px;">
            <div id="ch-val" style="
              position:absolute;top:0;left:50%;transform:translateX(-50%);
              font-size:13px;color:#818cf8;font-weight:700;letter-spacing:0.05em;
              transition:left 0.05s;
            ">0%</div>
            <input type="range" id="ch-slider" min="0" max="100" value="0" style="
              width:100%;height:3px;appearance:none;
              background:rgba(255,255,255,0.06);
              border-radius:4px;outline:none;cursor:pointer;
            "/>
          </div>
          <div id="ch-hint-c" style="font-size:9px;color:rgba(255,255,255,0.15);opacity:0;transition:opacity 0.8s;letter-spacing:0.1em;">
            (hint: the slider drifts — stop it at the right moment)
          </div>
        </div>

        <button id="ch-submit" style="
          margin-top:32px;padding:12px 36px;
          border:1px solid rgba(99,102,241,0.5);
          color:#818cf8;font-size:9px;font-weight:700;
          letter-spacing:0.4em;text-transform:uppercase;
          background:transparent;border-radius:10px;cursor:pointer;
          transition:all 0.3s;
        ">VERIFY HANDSHAKE</button>
      </div>

      <!-- ── PHASE 4: RESULT ── -->
      <div id="p4-result" style="display:none;text-align:center;padding:20px 0;">
        <!-- Classified stamp -->
        <div style="
          position:absolute;top:20px;right:20px;
          border:2.5px solid rgba(239,68,68,0.3);color:rgba(239,68,68,0.3);
          padding:4px 12px;border-radius:6px;
          transform:rotate(10deg);
          font-size:18px;font-weight:900;pointer-events:none;letter-spacing:0.08em;
          font-family:'Outfit',sans-serif;
        ">CLASSIFIED</div>

        <div style="margin-bottom:20px;">
          <div style="font-size:9px;color:#4338ca;letter-spacing:0.4em;text-transform:uppercase;margin-bottom:16px;">// ACCESS GRANTED — IDENTITY RESOLVED</div>
          <div style="position:relative;display:inline-block;">
            <div style="
              position:absolute;inset:-12px;
              border:1px solid rgba(99,102,241,0.12);border-radius:14px;
            "></div>
            <div id="res-type" style="
              font-family:'Outfit',sans-serif;
              font-size:clamp(26px,5vw,40px);
              font-weight:900;text-transform:uppercase;letter-spacing:-0.02em;
              background:linear-gradient(135deg,#fff 0%,#a5b4fc 40%,#818cf8 70%,#c4b5fd 100%);
              background-size:200% auto;
              -webkit-background-clip:text;-webkit-text-fill-color:transparent;
              animation:shine 3s linear infinite;
            ">--</div>
          </div>
        </div>

        <p id="res-msg" style="
          font-size:12px;color:#475569;
          max-width:340px;margin:0 auto 32px;
          line-height:1.9;letter-spacing:0.02em;
        "></p>

        <button id="enter-nexus" style="
          width:100%;padding:18px;
          background:linear-gradient(90deg,#4f46e5,#7c3aed,#6366f1);
          background-size:200% auto;
          color:#fff;font-weight:900;font-size:11px;
          letter-spacing:0.45em;text-transform:uppercase;
          border:none;border-radius:14px;cursor:pointer;
          box-shadow:0 0 30px rgba(99,102,241,0.3),0 0 60px rgba(99,102,241,0.1),inset 0 1px 0 rgba(255,255,255,0.1);
          transition:all 0.3s;
          animation:enterPulse 2.5s ease-in-out infinite;
        ">ENTER THE NEXUS →</button>
      </div>

    </div>
  </div>
</div>

<style>
  @keyframes orbA { 0%,100%{transform:translate(0,0);} 50%{transform:translate(50px,30px);} }
  @keyframes orbB { 0%,100%{transform:translate(0,0);} 50%{transform:translate(-40px,-35px);} }
  @keyframes orbC { 0%,100%{transform:translateX(-50%) scale(1);} 50%{transform:translateX(-50%) scale(1.2);} }
  @keyframes globalScan { 0%{top:-2px;opacity:0;} 3%{opacity:1;} 97%{opacity:0.6;} 100%{top:100%;opacity:0;} }
  @keyframes topShimmer { 0%,100%{opacity:0.4;} 50%{opacity:1;} }
  @keyframes subtitleShimmer { to{background-position:200% center;} }
  @keyframes shine { to{background-position:200% center;} }
  @keyframes radarPing { 0%{transform:scale(0.8);opacity:0.5;} 100%{transform:scale(2.2);opacity:0;} }
  @keyframes statusPulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }
  @keyframes blinkText { 0%,100%{opacity:1;} 50%{opacity:0;} }
  @keyframes enterPulse {
    0%,100%{box-shadow:0 0 30px rgba(99,102,241,0.3),0 0 60px rgba(99,102,241,0.1),inset 0 1px 0 rgba(255,255,255,0.1);}
    50%{box-shadow:0 0 50px rgba(99,102,241,0.5),0 0 100px rgba(99,102,241,0.2),inset 0 1px 0 rgba(255,255,255,0.15);}
  }

  .scan-line-anim { animation:scan-v 2.8s linear infinite; }
  @keyframes scan-v { from{top:0;} to{top:100%;} }

  #ch-slider::-webkit-slider-thumb {
    appearance:none; width:16px; height:16px; border-radius:50%;
    background:radial-gradient(circle,#a5b4fc,#6366f1);
    box-shadow:0 0 10px rgba(99,102,241,0.8); cursor:pointer;
    border:2px solid rgba(255,255,255,0.2);
  }
  #ch-slider::-moz-range-thumb {
    width:16px; height:16px; border-radius:50%;
    background:radial-gradient(circle,#a5b4fc,#6366f1);
    box-shadow:0 0 10px rgba(99,102,241,0.8); cursor:pointer;
    border:2px solid rgba(255,255,255,0.2);
  }

  #gate-start-btn:hover { background:rgba(99,102,241,0.1) !important; border-color:rgba(99,102,241,0.5) !important; }
  #gate-start-btn:hover #start-core { transform:scale(1.5); box-shadow:0 0 24px rgba(99,102,241,1),0 0 48px rgba(99,102,241,0.4) !important; }
  #gate-start-btn:hover #btn-shimmer { left:150% !important; }

  #ch-submit:hover { background:rgba(99,102,241,0.1) !important; border-color:rgba(99,102,241,0.8) !important; color:#a5b4fc !important; }
  #enter-nexus:hover { transform:scale(1.02); background-position:right center !important; }
  #bypass-gate:hover { color:rgba(99,102,241,0.35) !important; }

  #ch-tap-btn:active, #ch-btn:active {
    transform:scale(0.92);
    box-shadow:0 0 24px rgba(99,102,241,0.4) !important;
    border-color:rgba(99,102,241,0.9) !important;
  }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script is:inline>
(function(){
  const gate    = document.getElementById('security-gate');
  const p0      = document.getElementById('p0-start');
  const p1      = document.getElementById('p1-boot');
  const p2      = document.getElementById('p2-scan');
  const p3      = document.getElementById('p3-challenge');
  const p4      = document.getElementById('p4-result');
  const bootLog = document.getElementById('boot-log');
  const bootBar = document.getElementById('boot-bar');
  const bootPct = document.getElementById('boot-pct');
  const scanLog = document.getElementById('scan-log');

  if (localStorage.getItem('nexus_gate_passed')) {
    gate.style.display = 'none'; return;
  }

  gate.classList.remove('hidden');
  document.body.style.overflow = 'hidden';

  /* Typewriter system label */
  const sysLabel = document.getElementById('sys-label');
  const sysText = 'NEXUS.SECURITY // FIREWALL.LEVEL.04';
  let si = 0;
  const typeLabel = () => {
    if (si < sysText.length) {
      sysLabel.textContent += sysText[si++];
      setTimeout(typeLabel, 40 + Math.random() * 30);
    }
  };
  setTimeout(typeLabel, 300);

  /* Voice */
  const voice = (txt) => {
    try { const u=new SpeechSynthesisUtterance(txt); u.rate=1.1; u.pitch=0.8; window.speechSynthesis.speak(u); } catch(e){}
  };

  /* Bypass */
  document.getElementById('bypass-gate').addEventListener('click', () => {
    p0.style.display='none'; finishGate();
  });

  /* START */
  document.getElementById('gate-start-btn').addEventListener('click', () => {
    p0.style.display='none';
    p1.style.display='block';
    voice("Intruder detected. Please verify identity.");
    runBoot();
  });

  /* BOOT */
  const bootLines = [
    "NEXUS v2.026 INITIALIZING...",
    "CPU cores: [ 16 ] .............. OK",
    "Memory allocation: 32GB ........ OK",
    "Biometric scanner: ACTIVE ...... OK",
    "Network: ENCRYPTED ............. OK",
    "Threat level: ELEVATED ......... WARN",
    "Visual inspection: REQUIRED .... INIT",
  ];
  let bIdx=0;
  function runBoot(){
    if(bIdx < bootLines.length){
      const d=document.createElement('div');
      d.style.cssText='opacity:0;transition:opacity 0.2s;';
      d.innerHTML = '> ' + bootLines[bIdx++];
      bootLog.appendChild(d);
      requestAnimationFrame(()=>requestAnimationFrame(()=>d.style.opacity='1'));
      const pct = Math.round(bIdx/bootLines.length*100);
      bootBar.style.width = pct+'%';
      if(bootPct) bootPct.textContent = pct+'%';
      setTimeout(runBoot, 200 + Math.random()*120);
    } else {
      setTimeout(()=>{
        p1.style.display='none';
        p2.style.display='flex';
        p2.style.flexDirection='column';
        p2.style.alignItems='center';
        runScan();
      },400);
    }
  }

  /* SCAN */
  const scanLines = [
    { txt:"Detecting carbon-based lifeform...", result:"✓ CONFIRMED" },
    { txt:"Checking GitHub activity...",        result:"✓ ACTIVE" },
    { txt:"Measuring caffeine dependency...",   result:"⚠ CRITICAL" },
    { txt:"Verifying developer mindset...",     result:"✓ 98%" },
    { txt:"Analyzing browser history...",       result:"✗ REDACTED" },
  ];
  let sIdx2=0;
  function runScan(){
    if(sIdx2 < scanLines.length){
      const d=document.createElement('div');
      d.style.cssText='display:flex;justify-content:space-between;align-items:center;padding:2px 0;opacity:0;transition:opacity 0.25s;';
      const l=scanLines[sIdx2];
      const col = l.result.startsWith('✓')?'#22c55e':l.result.startsWith('⚠')?'#f59e0b':'#94a3b8';
      d.innerHTML=`<span style="color:#475569;">${l.txt}</span><span style="color:${col};font-weight:700;font-size:10px;">${l.result}</span>`;
      scanLog.appendChild(d);
      requestAnimationFrame(()=>requestAnimationFrame(()=>d.style.opacity='1'));
      sIdx2++;
      setTimeout(runScan, 300);
    } else {
      const d=document.createElement('div');
      d.style.cssText='margin-top:14px;font-weight:700;letter-spacing:0.2em;color:#818cf8;font-size:11px;text-align:center;border-top:1px solid rgba(99,102,241,0.12);padding-top:14px;';
      d.textContent='// IDENTITY SCAN COMPLETE — HUMAN CONFIRMED';
      scanLog.appendChild(d);
      setTimeout(()=>{
        p2.style.display='none';
        p3.style.display='block';
        setupChallenge();
      },900);
    }
  }

  /* CHALLENGE */
  const challenges=['a','b','c'];
  const chosen=challenges[Math.floor(Math.random()*challenges.length)];

  function setupChallenge(){
    const el=document.getElementById('ch-'+chosen);
    el.style.display='flex'; el.style.flexDirection='column'; el.style.alignItems='center';

    if(chosen==='a'){
      const btn=document.getElementById('ch-tap-btn');
      const msg=document.getElementById('ch-msg-a');
      let count=0;
      btn.onclick=()=>{
        count++; btn.textContent=count;
        btn.style.borderColor='rgba(99,102,241,0.9)';
        btn.style.boxShadow='0 0 24px rgba(99,102,241,0.4)';
        if(count>3){
          count=0; btn.textContent=0;
          msg.textContent='We said 3. Starting over.';
          btn.style.borderColor='rgba(239,68,68,0.6)';
          btn.style.boxShadow='0 0 20px rgba(239,68,68,0.2)';
          setTimeout(()=>{ msg.textContent=''; btn.style.borderColor='rgba(99,102,241,0.4)'; btn.style.boxShadow='none'; },1500);
        }
      };
      document.getElementById('ch-submit').onclick=()=>{
        if(count===3) finishGate(); else msg.textContent='Exactly 3 taps required.';
      };
    }

    if(chosen==='b'){
      const btn=document.getElementById('ch-btn');
      const msg=document.getElementById('ch-msg-b');
      let count=0;
      btn.onclick=()=>{
        count++; btn.textContent=count;
        btn.style.transform='scale(0.92)';
        btn.style.boxShadow='0 0 24px rgba(99,102,241,0.5)';
        setTimeout(()=>{ btn.style.transform='scale(1)'; btn.style.boxShadow='none'; },120);
        if(count>7){
          count=0; btn.textContent=0;
          msg.textContent='We said 7. Starting over.';
          setTimeout(()=>msg.textContent='',1500);
        }
      };
      document.getElementById('ch-submit').onclick=()=>{
        if(count===7) finishGate(); else msg.textContent='Identity mismatch. Need exactly 7.';
      };
    }

    if(chosen==='c'){
      const s=document.getElementById('ch-slider');
      const v=document.getElementById('ch-val');
      const hint=document.getElementById('ch-hint-c');
      setTimeout(()=>hint.style.opacity='1',5000);
      s.oninput=()=>{
        const pct=parseInt(s.value);
        v.textContent=pct+'%';
        v.style.left=pct+'%';
        v.style.transform=`translateX(-${pct}%)`;
        v.style.color=pct===42?'#22c55e':'#818cf8';
      };
      s.onmousemove=()=>{
        if(parseInt(s.value)!==42 && Math.random()>0.78){
          s.value=Math.max(0,Math.min(100,parseInt(s.value)+(Math.random()-0.5)*8));
          v.textContent=s.value+'%';
        }
      };
      document.getElementById('ch-submit').onclick=()=>{
        if(parseInt(s.value)===42) finishGate();
        else { s.style.outline='1px solid rgba(239,68,68,0.4)'; setTimeout(()=>s.style.outline='none',1000); }
      };
    }
  }

  /* RESULT */
  const personTypes=[
    { t:'RECRUITER',      m:'Welcome. Please find my skills more impressive than my social life.' },
    { t:'DEVELOPER',      m:'Checking the console? I see you. Stay for a while.' },
    { t:'LOST PERSON',    m:"The exit is not here. But stay — it's cozy in the nexus." },
    { t:'COFFEE ENJOYER', m:"I have a few pods left. Let's look at some code together." },
  ];

  function finishGate(){
    p3.style.display='none';
    p4.style.display='block';
    const res=personTypes[Math.floor(Math.random()*personTypes.length)];
    document.getElementById('res-type').textContent=res.t;
    document.getElementById('res-msg').textContent=res.m;
    if(typeof confetti!=='undefined'){
      confetti({particleCount:180,spread:75,origin:{y:0.6},colors:['#6366f1','#8b5cf6','#a5b4fc','#3b82f6']});
    }
    document.getElementById('enter-nexus').onclick=()=>{
      document.getElementById('gate-l').style.transform='translateX(-100%)';
      document.getElementById('gate-r').style.transform='translateX(100%)';
      document.getElementById('gate-screen').style.opacity='0';
      localStorage.setItem('nexus_gate_passed','true');
      setTimeout(()=>{ gate.style.display='none'; document.body.style.overflow='auto'; },1200);
    };
  }
})();
</script>