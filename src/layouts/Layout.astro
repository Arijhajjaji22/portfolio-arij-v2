---
interface Props {
	title: string;
}

const { title } = Astro.props;
import SecurityGate from '../components/SecurityGate.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
    
    <!-- FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Inter:wght@100..900&family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet">
    
    <!-- DEVICON -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">
    
    <!-- THREE.JS GLOBAL -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
	</head>
	<body class="bg-[#08080a] text-[#f0f0f0] selection:bg-purple-500/30 overflow-x-hidden">
    <div class="scanline-wipe"></div>
    

    <!-- GLOBAL AMBIENT GLOWS -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
       <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-indigo-600/10 blur-[120px] rounded-full"></div>
       <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-blue-500/10 blur-[120px] rounded-full"></div>
       
       <!-- Technical Grid Overlay -->
       <div class="absolute inset-0 opacity-[0.03] bg-[linear-gradient(90deg,rgba(255,255,255,.1)_1px,transparent_1px),linear-gradient(rgba(255,255,255,.1)_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
    </div>

    <!-- GLOBAL HUD SYSTEM -->
    <div class="fixed top-0 left-0 w-full h-full pointer-events-none z-[100] p-8 hidden lg:flex flex-col justify-between mix-blend-overlay opacity-30">
        <div class="flex justify-between items-start">
            <div class="font-mono text-[10px] uppercase tracking-widest leading-loose text-white">
                <span class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse shadow-[0_0_8px_rgba(59,130,246,1)]"></span>
                    SYSTEM_STATUS: ACTIVE
                </span>
                CORE_LOAD: 23%<br/>
                NETWORK: <span class="text-blue-400">ENCRYPTED</span>
            </div>
            <div class="font-mono text-[10px] uppercase tracking-widest text-right text-white">
                MODULE: PORTFOLIO_V2.26<br/>
                ENGINE: NEXUS_CORE_V1<br/>
                BUILD_HASH: <span class="font-bold opacity-60">X-0410</span>
            </div>
        </div>
        <div class="flex justify-between items-end">
            <div class="w-24 h-px bg-white/20"></div>
            <div class="w-24 h-px bg-white/20"></div>
        </div>
    </div>

    <!-- SPOTLIGHT -->
    <div id="global-spotlight" class="pointer-events-none fixed inset-0 z-50 mix-blend-overlay transition-opacity duration-500 opacity-0 hidden md:block"></div>

    <!-- 1. SECURITY GATE INTRO -->
    <SecurityGate />

    <!-- 2. PREMIUM CUSTOM CURSOR -->
    <div id="cursor-core" class="fixed w-1.5 h-1.5 rounded-full bg-white pointer-events-none z-[300000] opacity-0 mix-blend-difference hidden md:block"></div>
    <div id="cursor-aura" class="fixed w-10 h-10 rounded-full border border-white/40 pointer-events-none z-[300000] opacity-0 mix-blend-difference hidden md:block transition-transform duration-500 ease-out">
        <div class="absolute inset-[-4px] border border-white/10 rounded-full scale-125"></div>
    </div>

    <!-- 3. SECRET CLI -->
    <div id="secret-cli" class="fixed bottom-0 left-0 w-full h-[380px] md:h-[420px] bg-[#050508] border-t border-purple-500/30 z-[90000] translate-y-full transition-transform duration-500 font-mono flex flex-col shadow-[0_-20px_50px_rgba(0,0,0,0.8)] backdrop-blur-xl">
       <div class="px-6 py-3 flex items-center justify-between border-b border-white/5 bg-white/[0.02]">
          <div class="flex gap-2">
             <div class="w-2.5 h-2.5 rounded-full bg-red-500/30"></div>
             <div class="w-2.5 h-2.5 rounded-full bg-amber-500/30"></div>
             <div class="w-2.5 h-2.5 rounded-full bg-green-500/30"></div>
             <span class="ml-4 text-[8px] text-gray-600 uppercase tracking-widest font-black hidden sm:inline">Nexus Shell — arij@nexus-core_</span>
          </div>
          <button id="cli-close" class="text-gray-600 hover:text-white transition-colors p-2">✕</button>
       </div>
       <div id="cli-output" class="flex-1 p-6 md:p-8 overflow-y-auto space-y-2 text-xs md:text-sm text-purple-400/80 scrollbar-hide"></div>
       <div class="px-6 md:px-8 py-4 border-t border-white/5 flex items-center gap-3">
          <span class="text-xs md:text-sm text-purple-500">arij@portfolio:~$</span>
          <input type="text" id="cli-input" class="bg-transparent border-none outline-none flex-1 text-white lowercase text-xs md:text-sm" autofocus spellcheck="false" autocomplete="off" />
       </div>
    </div>

    <!-- 4. CUSTOM CONTEXT MENU -->
    <div id="context-menu" class="fixed z-[100001] bg-[#0d0d14] border border-white/10 rounded-xl p-2 w-64 hidden md:block shadow-2xl scale-[0.95] opacity-0 transition-all pointer-events-auto">
       <div class="p-3 text-[10px] font-mono uppercase tracking-widest text-gray-600 cursor-not-allowed flex justify-between">
          <span>Inspect Element</span>
          <span>Nice Try</span>
       </div>
       <hr class="border-white/5 my-1" />
       <div id="m-email" class="p-3 text-[10px] font-mono uppercase tracking-widest hover:bg-purple-500/10 hover:text-purple-400 rounded-lg cursor-pointer transition-all flex items-center gap-3">
          <span class="text-lg">📧</span> Copy Email Address
       </div>
       <div id="m-cv" class="p-3 text-[10px] font-mono uppercase tracking-widest hover:bg-purple-500/10 hover:text-purple-400 rounded-lg cursor-pointer transition-all flex items-center gap-3">
          <span class="text-lg">📄</span> Download Dossier
       </div>
    </div>

    <!-- 5. SCROLL HUD -->
    <div id="scroll-hud" class="fixed bottom-8 left-1/2 -translate-x-1/2 z-[80000] px-6 py-2.5 bg-[#0d0d14]/60 backdrop-blur-2xl border border-white/10 rounded-full font-mono text-[8px] md:text-[9px] text-gray-500 uppercase tracking-[0.3em] pointer-events-none transition-all duration-700 opacity-0 translate-y-10 scale-90 w-[90%] md:w-auto text-center">
       <span class="text-purple-500 mr-2 md:mr-3">></span><span id="hud-content">Initializing...</span>
    </div>

    <!-- GLOBAL PROGRESS -->
    <div id="scroll-progress" class="fixed top-0 left-0 h-1 bg-purple-500 z-[100003] w-full origin-left scale-x-0 transition-transform duration-100 shadow-[0_0_15px_rgba(123,47,247,0.8)] will-change-transform"></div>

    <!-- BACK TO TOP -->
    <div id="back-to-top" role="button" aria-label="Back to Top">
       <div class="b2t-inner magnetic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
             <path d="M12 19V5M5 12l7-7 7 7"/>
          </svg>
       </div>
    </div>

    <!-- TOASTS CONTAINER -->
    <div id="toast-root" class="fixed top-20 md:top-8 right-4 md:right-8 z-[110000] flex flex-col gap-4 pointer-events-none max-w-[calc(100vw-2rem)]"></div>

    <!-- RPG CHARACTER SHEET -->
    <div id="rpg-sheet" class="fixed inset-0 z-[120000] hidden pointer-events-auto" aria-hidden="true">
      <div class="absolute inset-0 bg-black/70 backdrop-blur-[2px]"></div>
      <div class="relative w-full h-full flex items-center justify-center p-6">
        <div class="rpg-panel">
          <div class="rpg-panel__frame"></div>
          <div class="relative z-10 p-6 md:p-10">
            <div class="flex items-start justify-between gap-4 mb-6">
              <div>
                <div class="rpg-kicker text-[10px] md:text-[11px] font-mono uppercase tracking-[0.5em] text-purple-500">Character Sheet</div>
                <div class="rpg-title mt-3 text-2xl md:text-4xl font-black font-outfit uppercase tracking-tighter">Senior Engineer Lv.2</div>
                <div class="mt-3 flex flex-wrap gap-3 text-[10px] md:text-[11px] font-mono uppercase tracking-widest text-gray-400">
                  <span>Race: Full Stack Human</span>
                  <span>Guild: Hosinox</span>
                </div>
              </div>
              <button id="rpg-close" class="rpg-close-btn border border-white/10 rounded-lg px-3 py-2 text-[11px] font-mono uppercase tracking-widest text-gray-500 hover:text-white hover:border-blue-500/40 transition-colors">ESC</button>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <div>
                <div class="rpg-section-title text-[10px] md:text-[11px] font-mono uppercase tracking-[0.35em] text-blue-400 mb-3">Stats</div>
                <div class="space-y-4">
                  <div class="rpg-bar-row">
                    <div class="rpg-bar-label">STR (Problem Solving) <span class="rpg-bar-value">92/100</span></div>
                    <div class="rpg-bar-track"><div class="rpg-bar-fill" data-stat="92"></div></div>
                  </div>
                  <div class="rpg-bar-row">
                    <div class="rpg-bar-label">INT (Architecture) <span class="rpg-bar-value">95/100</span></div>
                    <div class="rpg-bar-track"><div class="rpg-bar-fill" data-stat="95"></div></div>
                  </div>
                  <div class="rpg-bar-row">
                    <div class="rpg-bar-label">DEX (Frontend) <span class="rpg-bar-value">85/100</span></div>
                    <div class="rpg-bar-track"><div class="rpg-bar-fill" data-stat="85"></div></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Matrix rain overlay -->
    <div id="matrix-overlay" class="fixed inset-0 z-[130000] hidden pointer-events-none opacity-0 transition-opacity duration-500 bg-black/90">
      <canvas id="matrix-canvas" class="w-full h-full"></canvas>
    </div>

    <!-- ASCII overlay -->
    <div id="ascii-overlay" class="fixed inset-0 z-[130001] hidden pointer-events-none opacity-0 transition-opacity duration-300 bg-black/75">
      <pre id="ascii-arij" class="absolute inset-0 flex items-center justify-center m-0 p-6 text-blue-400 font-mono text-[10px] md:text-[14px] leading-none text-center whitespace-pre-wrap"></pre>
    </div>

    <!-- Coffee rain overlay -->
    <div id="coffee-rain" class="fixed inset-0 z-[130002] hidden pointer-events-none"></div>

		<slot />

		<style is:global>
			:root { 
        --primary: #7b2ff7; 
        --primary-glow: rgba(123, 47, 247, 0.5);
        --accent: #3b82f6; 
        --bg: #08080a; 
        --card: rgba(255, 255, 255, 0.03); 
        --text: #f0f0f0; 
        --text-muted: rgba(240, 240, 240, 0.5);
      }
      
      @media (min-width: 768px) {
        html, body, a, button, section, div { cursor: none !important; }
      }

      * { scrollbar-width: thin; scrollbar-color: var(--primary) transparent; }
      ::-webkit-scrollbar { width: 5px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 10px; }

      /* MICRO-INTERACTIONS */
      .hover-underline-lr { position: relative; }
      .hover-underline-lr::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 1px; background: currentColor; transition: width 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94); }
      .hover-underline-lr:hover::after { width: 100%; }

      .btn-hover-y { transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
      .btn-hover-y:hover { transform: translateY(-2px); }
      .btn-hover-y:active { transform: translateY(1px); }

      .icon-rotate { transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
      .icon-rotate:hover { transform: rotate(10deg); }

      .nav-pill { position: relative; transition: color 0.3s ease; }
      .nav-pill::before { content: ''; position: absolute; inset: -4px -12px; border-radius: 99px; background: rgba(123,47,247,0.05); transform: scale(0.5); opacity: 0; transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); z-index: -1; }
      .nav-pill:hover::before { transform: scale(1); opacity: 1; }

      .card-border-fade { border-color: rgba(255,255,255,0.05); transition: border-color 0.5s ease; }
      .card-border-fade:hover { border-color: rgba(255,255,255,0.3); }

      .img-scale { transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
      .img-scale:hover { transform: scale(1.03); }

      .tag-float { transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
      .tag-float:hover { transform: translateY(-3px); }

      .focus-border-grow { position: relative; }
      .focus-border-grow-line { position: absolute; left: 0; top: 0; width: 2px; height: 0; background: var(--primary); transition: height 0.4s ease; transition-delay: 0.1s; pointer-events: none; }
      .focus-border-grow input:focus ~ .focus-border-grow-line, .focus-border-grow textarea:focus ~ .focus-border-grow-line { height: 100%; }

      /* GLITCH TEXT EFFECT */
      .glitch-text { position: relative; display: inline-block; }
      .glitch-text::before, .glitch-text::after {
        content: attr(data-text); position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        opacity: 0.8; z-index: -1; pointer-events: none;
      }
      .glitch-text:hover::before, .glitch-text.auto-glitch::before {
        animation: glitch-1 0.4s cubic-bezier(.25, .46, .45, .94) both infinite;
        color: #ff0040; text-shadow: 2px 0 #ff0040; clip-path: polygon(0 0, 100% 0, 100% 45%, 0 45%); transform: translateX(-3px);
      }
      .glitch-text:hover::after, .glitch-text.auto-glitch::after {
        animation: glitch-2 0.4s cubic-bezier(.25, .46, .45, .94) reverse both infinite;
        color: var(--accent); text-shadow: -2px 0 var(--accent); clip-path: polygon(0 80%, 100% 80%, 100% 100%, 0 100%); transform: translateX(3px);
      }
      .glitch-text:hover { animation: glitch-flicker 0.4s linear infinite; }

      @keyframes glitch-1 {
        0% { clip-path: polygon(0 2%, 100% 2%, 100% 5%, 0 5%); }
        20% { clip-path: polygon(0 15%, 100% 15%, 100% 15%, 0 15%); }
        40% { clip-path: polygon(0 10%, 100% 10%, 100% 20%, 0 20%); }
        60% { clip-path: polygon(0 1%, 100% 1%, 100% 2%, 0 2%); }
        80% { clip-path: polygon(0 33%, 100% 33%, 100% 33%, 0 33%); }
        100% { clip-path: polygon(0 44%, 100% 44%, 100% 44%, 0 44%); }
      }
      @keyframes glitch-2 {
        0% { clip-path: polygon(0 80%, 100% 80%, 100% 100%, 0 100%); }
        30% { clip-path: polygon(0 50%, 100% 50%, 100% 51%, 0 51%); }
        50% { clip-path: polygon(0 70%, 100% 70%, 100% 75%, 0 75%); }
        70% { clip-path: polygon(0 80%, 100% 80%, 100% 90%, 0 90%); }
        90% { clip-path: polygon(0 50%, 100% 50%, 100% 55%, 0 55%); }
        100% { clip-path: polygon(0 60%, 100% 60%, 100% 70%, 0 70%); }
      }
      @keyframes glitch-flicker { 0% { opacity: 1; } 50% { opacity: 0.8; } 100% { opacity: 1; } }

      /* ANIMATED GRADIENT TEXT */
      .gradient-text-animated {
        background: linear-gradient(135deg, var(--accent) 0%, var(--primary) 35%, #ffffff 50%, var(--primary) 65%, var(--accent) 100%);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: move-gradient 4s ease infinite, shadow-glow 4s ease infinite;
      }
      .gradient-text-animated:hover { animation-duration: 0.8s; }

      @keyframes move-gradient { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
      @keyframes shadow-glow { 0%, 100% { filter: drop-shadow(0 0 10px rgba(59, 130, 246, 0.3)); } 50% { filter: drop-shadow(0 0 25px rgba(59, 130, 246, 0.5)); } }

      /* ── CINEMATIC ENTRANCE SYSTEM ── */
      [class*="reveal"] { opacity: 0; will-change: transform, opacity, filter; }

      .reveal { 
        transform: translateY(30px); 
        transition: opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1), transform 1.2s cubic-bezier(0.22, 1, 0.36, 1); 
      }
      .reveal.in-view { opacity: 1; transform: translateY(0); }

      /* Slide from Left */
      .reveal-left {
        transform: translateX(-50px);
        transition: opacity 1.4s cubic-bezier(0.22, 1, 0.36, 1), transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .reveal-left.in-view { opacity: 1; transform: translateX(0); }

      /* Slide from Right */
      .reveal-right {
        transform: translateX(50px);
        transition: opacity 1.4s cubic-bezier(0.22, 1, 0.36, 1), transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .reveal-right.in-view { opacity: 1; transform: translateX(0); }

      /* Zoom In */
      .reveal-zoom {
        transform: scale(0.85);
        transition: opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1), transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .reveal-zoom.in-view { opacity: 1; transform: scale(1); }

      /* Blur In */
      .reveal-blur {
        filter: blur(15px);
        transform: translateY(20px);
        transition: opacity 1.2s ease, filter 1.2s ease, transform 1.2s ease;
      }
      .reveal-blur.in-view { opacity: 1; filter: blur(0); transform: translateY(0); }

      /* Sections entrance (CINEMATIC) */
      .reveal-section { 
        opacity: 0; 
        transform: scale(0.98) translateY(20px);
        filter: blur(4px);
        transition: opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1), 
                    transform 1.2s cubic-bezier(0.22, 1, 0.36, 1), 
                    filter 1.2s cubic-bezier(0.22, 1, 0.36, 1);
        pointer-events: none; 
      }
      .reveal-section.visible { 
        opacity: 1; 
        transform: scale(1) translateY(0); 
        filter: blur(0); 
        pointer-events: auto; 
      }

      .reveal-label { transform: translateX(-50px); opacity: 0; transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94); }
      .visible .reveal-label { transform: translateX(0); opacity: 1; }

      .reveal-title-word { display: inline-block; transform: translateY(-30px) rotate(-5deg); opacity: 0; transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1); white-space: pre; }
      .visible .reveal-title-word { transform: translateY(0) rotate(0deg); opacity: 1; transition-delay: var(--delay); }

      .reveal-body { transform: translateY(20px); opacity: 0; transition: all 0.8s ease; transition-delay: 0.3s; }
      .visible .reveal-body { transform: translateY(0); opacity: 1; }

      .reveal-cta { transform: scale(0.8); opacity: 0; transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); transition-delay: 0.5s; }
      .visible .reveal-cta { transform: scale(1); opacity: 1; }

      .reveal-card { transform: translateY(40px) scale(0.95); opacity: 0; transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); transition-delay: var(--delay); }
      .visible .reveal-card { transform: translateY(0) scale(1); opacity: 1; }

      @media (prefers-reduced-motion: reduce) {
        .glitch-text::before, .glitch-text::after, .reveal-title-word, .reveal-card { transition: none !important; animation: none !important; transform: none !important; opacity: 1 !important; }
      }
			html { 
        scroll-behavior: smooth; 
        background: var(--bg); 
        height: 100%; 
      }
			body { 
        font-family: 'Inter', sans-serif; 
        overflow-x: hidden; 
        background: var(--bg); 
        min-height: 100vh; 
        -webkit-font-smoothing: antialiased; 
        -moz-osx-font-smoothing: grayscale; 
        color: var(--text); 
      }
      .section-layout-fix {
        width: 100%;
        position: relative;
      }
			.font-outfit { font-family: 'Outfit', sans-serif; }
			.font-inter { font-family: 'Inter', sans-serif; }
			.font-mono { font-family: 'JetBrains Mono', monospace; }
			.gradient-text { background: linear-gradient(to right, var(--primary), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
			h1, h2, h3 { font-family: 'Outfit', sans-serif; letter-spacing: -0.03em; font-weight: 800; }
			p, span, div { letter-spacing: -0.01em; }
			.reveal { opacity: 0; transform: translateY(30px); transition: all 1.2s cubic-bezier(0.22, 1, 0.36, 1); }
			.reveal.in-view { opacity: 1; transform: translateY(0); }
      .container { width: 100%; max-width: 1400px; margin: 0 auto; padding: 0 1rem; }
      @media (min-width: 768px) { .container { padding: 0 1.5rem; } }
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      
      /* ACHIEVEMENT TOAST */
      .achieve-card { 
         background: #0d0d14; border: 1px solid rgba(59, 130, 246, 0.3); padding: 14px 20px; border-radius: 16px; box-shadow: 0 30px 60px rgba(0,0,0,0.8);
         display: flex; align-items: center; gap: 1rem; min-width: 280px;
         animation: ach-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }
      @media (min-width: 768px) {
         .achieve-card { padding: 18px 24px; border-radius: 20px; gap: 1.2rem; min-width: 320px; }
      }
      @keyframes ach-in { from { transform: translateX(100%) scale(0.9); opacity: 0; } to { transform: translateX(0) scale(1); opacity: 1; } }

      /* CYBER RIPPLE */
      .cyber-ripple { position: absolute; pointer-events: none; border-radius: 50%; border: 2px solid rgba(59,130,246,0.5); transform: translate(-50%, -50%) scale(0); animation: ripple-anim 0.6s cubic-bezier(0.1, 0.8, 0.3, 1) forwards; z-index: 999999; }
      .cyber-ripple-inner { position: absolute; pointer-events: none; border-radius: 50%; border: 1px solid rgba(255,255,255,0.3); transform: translate(-50%, -50%) scale(0); animation: ripple-anim-inner 0.4s cubic-bezier(0.1, 0.8, 0.3, 1) forwards; z-index: 999999; }
      @keyframes ripple-anim { to { transform: translate(-50%, -50%) scale(4); opacity: 0; width: 60px; height: 60px; } }
      @keyframes ripple-anim-inner { 0% { transform: translate(-50%, -50%) scale(0); opacity: 1; width: 20px; height: 20px; } 100% { transform: translate(-50%, -50%) scale(8); opacity: 0; width: 20px; height: 20px; border-width: 0; } }

      .glass-card { 
        position: relative;
        background: rgba(255, 255, 255, 0.01);
