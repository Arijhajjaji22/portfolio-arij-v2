           if (godmodeBusy) return;
           godmodeBusy = true;
           const titles = document.querySelectorAll('section[id] h1, section[id] h2');
           titles.forEach((t) => {
             t.classList.add('godmode-title');
             // Ensure nested gradient spans don't override the effect.
             t.querySelectorAll('span').forEach((s) => s.classList.add('godmode-title'));
           });
           window.setTimeout(() => {
             titles.forEach((t) => {
               t.classList.remove('godmode-title');
               t.querySelectorAll('span').forEach((s) => s.classList.remove('godmode-title'));
             });
             godmodeBusy = false;
           }, 3000);
         }

         // Big ASCII ARIJ (cyan) - brief flash
         let asciiBusy = false;
         function triggerArijAscii() {
           if (asciiBusy || !asciiOverlay || !asciiEl) return;
           asciiBusy = true;
           const art = [
             ' ██████╗  ██████╗  ███╗   ███╗  ██████╗ ',
             '██╔════╝ ██╔═══██╗ ████╗ ████║ ██╔════╝ ',
             '██║  ███╗██║   ██║ ██╔████╔██║ ██║  ███╗',
             '██║   ██║██║   ██║ ██║╚██╔╝██║ ██║   ██║',
             '╚██╗  ██║██║   ██║ ██║ ╚═╝ ██║ ╚██╗  ██║',
             ' ╚█████╔╝╚██████╔╝ ██║     ██║  ╚█████╔╝',
             '  ╚════╝  ╚═════╝  ╚═╝     ╚═╝   ╚════╝ ',
           ].join('\n');

           asciiEl.textContent = art;

           asciiOverlay.classList.remove('hidden');
           asciiOverlay.classList.add('ascii-show');

           window.setTimeout(() => {
             asciiOverlay.classList.remove('ascii-show');
             window.setTimeout(() => {
               asciiOverlay.classList.add('hidden');
               asciiBusy = false;
             }, 320);
           }, 900);
         }

         // SYSTEM OVERRIDE typing in HUD
         let nexusBusy = false;
         function triggerNexusOverride() {
           if (nexusBusy || !hud || !hudContent) return;
           nexusBusy = true;

           const prevText = hudContent.textContent;
           const seq = ['SYSTEM OVERRIDE', 'ACCESS: ADMIN', 'STATUS: OVERRIDDEN', 'OK'];

           hudContent.textContent = '';
           hud.style.opacity = '1';
           hud.style.transform = 'translateX(-50%) translateY(0) scale(1)';

           let p = 0;
           const full = seq.join(' | ');

           // Typewriter effect across the combined sequence
           const start = () => {
             if (p <= full.length) {
               hudContent.textContent = full.substring(0, p);
               p++;
               window.setTimeout(start, 18);
             } else {
              // Sequence finished; keep it visible briefly before restoring HUD.
              window.setTimeout(() => {
                hudContent.textContent = prevText;
                nexusBusy = false;
              }, 650);
             }
           };
           window.setTimeout(start, 50);
         }

         // Coffee rain (20 ☕) - ~2.6 seconds
         let coffeeBusy = false;
         function triggerCoffeeRain() {
           if (coffeeBusy || !coffeeRain) return;
           coffeeBusy = true;
           coffeeRain.innerHTML = '';
           coffeeRain.classList.remove('hidden');
           const count = 20;
           for (let i = 0; i < count; i++) {
             const el = document.createElement('span');
             el.className = 'coffee-drop';
             el.textContent = '☕';
             el.style.left = `${Math.random() * 100}vw`;
             el.style.setProperty('--dur', `${2.0 + Math.random() * 1.2}s`);
             el.style.animationDelay = `${Math.random() * 0.25}s`;
             coffeeRain.appendChild(el);
           }
           window.setTimeout(() => {
             coffeeRain.classList.add('hidden');
             coffeeRain.innerHTML = '';
             coffeeBusy = false;
           }, 2700);
         }

         document.onkeydown = e => {
           // Ignore typing inside inputs (CLI / forms).
           const target = e.target;
           const tag = (target && target.tagName) ? target.tagName.toUpperCase() : '';
           if (tag === 'INPUT' || tag === 'TEXTAREA' || (target && target.isContentEditable)) return;

           // ESC closes RPG sheet.
           if (e.key === 'Escape') {
             if (isRpgOpen()) {
               e.preventDefault();
               closeRpg();
               return;
             }
           }

           // Allow RPG sheet to fully own keyboard while open.
           if (isRpgOpen()) {
             if (e.key && e.key.toLowerCase() === 'p') {
               e.preventDefault();
               closeRpg();
             }
             return;
           }

           // Press 'P' to open.
           if (e.key && e.key.toLowerCase() === 'p') {
             e.preventDefault();
             openRpg();
             return;
           }

           const key = (e.key || '').toLowerCase();
           if (key.length === 1 && /[a-z0-9]/.test(key)) {
             keys += key;
             if (keys.length > 20) keys = keys.substring(1);
           }

           if (keys.endsWith('java')) showToast("☕ JAVA? MY FIRST LOVE.");
           if (keys.endsWith('docker')) showToast("🐳 IT WORKS ON MY MACHINE.");
           if (keys.endsWith(' hire')) { fireConfetti(); document.getElementById('contact').scrollIntoView(); }

           // New sequences
           if (keys.endsWith('matrix')) triggerMatrixRain();
           if (keys.endsWith('godmode')) triggerGodmode();
           if (keys.endsWith('arij')) triggerArijAscii();
           if (keys.endsWith('nexus')) triggerNexusOverride();
           if (keys.endsWith('coffee')) triggerCoffeeRain();
         };

         let idle = 0;
         setInterval(() => {
            idle++;
            if (idle === 30) showToast("👀 Recruiter detected? Want to skip?");
            if (idle === 60) showToast("👀 Still there? Hire me!");
         }, 1000);
         window.onmousemove = () => idle = 0;
      })();

      // ── PROGRESS BAR (Optimized) ─────────────────────────────
      let ticking = false;
      const prog = document.getElementById('scroll-progress');
      window.addEventListener('scroll', () => {
         if (!ticking) {
            window.requestAnimationFrame(() => {
               const h = document.documentElement.scrollHeight - innerHeight;
               prog.style.transform = `scaleX(${pageYOffset / h})`;
               ticking = false;
            });
            ticking = true;
         }
      }, { passive: true });

      // ── 8. SPOTLIGHT & GLASS REFLECTION ──────────────────────
      (function() {
         const mem = navigator.deviceMemory || 4;
         const cores = navigator.hardwareConcurrency || 4;
         window.isLowEnd = mem < 4 || cores < 4;

         if (window.matchMedia('(pointer: fine)').matches && !window.isLowEnd) {
            const spot = document.getElementById('global-spotlight');
            let cx = window.innerWidth / 2, cy = window.innerHeight / 2;
            let tx = cx, ty = cy;
            spot.classList.remove('opacity-0');

            document.addEventListener('mousemove', e => { tx = e.clientX; ty = e.clientY; }, { passive: true });
            
            function renderSpotlight() {
               cx += (tx - cx) * 0.1; cy += (ty - cy) * 0.1;
               spot.style.background = `radial-gradient(circle 300px at ${cx}px ${cy}px, rgba(255,255,255,0.03) 0%, transparent 70%)`;
               requestAnimationFrame(renderSpotlight);
            }
            requestAnimationFrame(renderSpotlight);

            setTimeout(() => {
               document.querySelectorAll('.glass-card').forEach(card => {
                  const inner = card.querySelector('.glass-inner') || card;
                  const light = document.createElement('div');
                  light.className = 'glass-light absolute inset-0 rounded-[inherit] opacity-0 z-[100] pointer-events-none';
                  inner.appendChild(light);

                  card.addEventListener('mousemove', e => {
                     const r = card.getBoundingClientRect();
                     const x = e.clientX - r.left, y = e.clientY - r.top;
                     const cX = r.width/2, cY = r.height/2;
                     const rotX = ((y - cY) / cY) * -8;
                     const rotY = ((x - cX) / cX) * 8;
                     
                     inner.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg) scale3d(1.02, 1.02, 1.02)`;
                     inner.style.transition = 'none';
                     light.style.opacity = '1';
                     light.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.08) 0%, transparent 60%)`;
                     inner.style.boxShadow = `${-rotY}px ${rotX}px 30px rgba(123,47,247,0.15)`;
                  }, { passive: true });

                  card.addEventListener('mouseleave', () => {
                     inner.style.transition = 'transform 0.6s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.6s ease';
                     inner.style.transform = `rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
                     inner.style.boxShadow = 'none';
                     light.style.opacity = '0';
                  });
               });
            }, 1000);
         }
      })();

      // ── 9. BACK TO TOP LOGIC ────────────────────────────
      (function() {
         const b2t = document.getElementById('back-to-top');
         if (!b2t) return;
         
         window.addEventListener('scroll', () => {
            if (window.scrollY > 800) {
               b2t.classList.add('show');
            } else {
               b2t.classList.remove('show');
            }
         });
         
         b2t.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
         });
      })();

      // ── 10. MAGNETIC HOVER ──────────────────────────────────
      (function() {
         if ('ontouchstart' in window) return;
         const mAgents = document.querySelectorAll('.magnetic');
         mAgents.forEach(btn => {
            const inner = btn.querySelector('.m-inner') || btn;
            btn.addEventListener('mousemove', e => {
               const rect = btn.getBoundingClientRect();
               const centerX = rect.left + rect.width / 2, centerY = rect.top + rect.height / 2;
               const x = (e.clientX - centerX), y = (e.clientY - centerY);
               btn.style.transform = `translate(${x * 0.3}px, ${y * 0.3}px) scale(1.05)`;
               if (inner !== btn) inner.style.transform = `translate(${x * 0.5}px, ${y * 0.5}px)`;
               btn.style.transition = 'transform 0.15s ease-out';
               if (inner !== btn) inner.style.transition = 'transform 0.15s ease-out';
            });
            btn.addEventListener('mouseleave', () => {
               btn.style.transform = `translate(0px, 0px) scale(1)`;
               if (inner !== btn) inner.style.transform = `translate(0px, 0px)`;
               btn.style.transition = 'transform 0.6s cubic-bezier(0.23, 1, 0.32, 1)';
               if (inner !== btn) inner.style.transition = 'transform 0.6s cubic-bezier(0.23, 1, 0.32, 1)';
            });
         });
      })();

      // ── 10. CINEMATIC OBSERVER ─────────────────────────────
      (function() {
         const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
               if (entry.isIntersecting) {
                  entry.target.classList.add('visible');
                  entry.target.querySelectorAll('.split-title').forEach(t => {
                     if (!t.dataset.split) {
                        const words = t.innerText.split(' ');
                        t.innerHTML = words.map((w, i) => `<span class="reveal-title-word" style="--delay: ${i * 80}ms">${w}</span>`).join(' ');
                        t.dataset.split = "true";
                     }
                  });
               }
            });
         }, { threshold: 0.1 });
         document.querySelectorAll('section, [class*="reveal"]').forEach(s => observer.observe(s));
         
         setInterval(() => {
            const el = document.querySelector('.glitch-text');
            if (el) {
               el.classList.add('auto-glitch');
               setTimeout(() => el.classList.remove('auto-glitch'), 400);
            }
         }, 10000);
      })();

      // ── 11. CYBER RIPPLE LENS ─────────────────────────────
      document.addEventListener('mousedown', function(e) {
         if (window.isLowEnd) return;
         const r = document.createElement('div');
         r.className = 'cyber-ripple';
         r.style.left = e.pageX + 'px'; r.style.top = e.pageY + 'px';
         document.body.appendChild(r);
         const ri = document.createElement('div');
         ri.className = 'cyber-ripple-inner';
         ri.style.left = e.pageX + 'px'; ri.style.top = e.pageY + 'px';
         document.body.appendChild(ri);
         setTimeout(() => { r.remove(); ri.remove(); }, 600);
      });

      // ── 12. GLOBAL 3D BACKGROUND ENGINE ────────────────────
      (function() {
         const container = document.getElementById('global-3d-bg');
         if (!container || typeof THREE === 'undefined') return;

         const scene = new THREE.Scene();
         const camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.1, 1000);
         const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
         renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
         renderer.setSize(window.innerWidth, window.innerHeight);
         container.appendChild(renderer.domElement);

          // ── CYBER-CITY HOLOGRAM (ULTRA-NEW) ──
          const cityGroup = new THREE.Group();
          scene.add(cityGroup);

          const gridDim = 12;
          const spacing = 4;
          const towers = [];

          for(let x = -gridDim/2; x < gridDim/2; x++) {
             for(let z = -gridDim/2; z < gridDim/2; z++) {
                const height = 2 + Math.random() * 10;
                const towerGeo = new THREE.BoxGeometry(1.5, height, 1.5);
                const towerMat = new THREE.MeshPhongMaterial({ 
                   color: 0x3b82f6, 
                   transparent: true, 
                   opacity: 0.3, 
                   wireframe: true,
                   emissive: 0x7b2ff7,
                   emissiveIntensity: 0.2
                });
                const tower = new THREE.Mesh(towerGeo, towerMat);
                tower.position.set(x * spacing, height/2 - 10, z * spacing);
                tower.userData = { 
                   originalHeight: height, 
                   noiseOffset: Math.random() * 100,
                   speed: 0.2 + Math.random() * 0.8
                };
                towers.push(tower);
                cityGroup.add(tower);
             }
          }

          // Ambient & Lights
          scene.add(new THREE.AmbientLight(0xffffff, 0.4));
          const pLight = new THREE.PointLight(0x7b2ff7, 3, 100);
          pLight.position.set(20, 30, 20);
          scene.add(pLight);

          camera.position.set(0, 15, 35);
          camera.lookAt(0, 0, 0);

          let mouseX = 0, mouseY = 0;
          window.addEventListener('mousemove', e => {
             mouseX = (e.clientX/window.innerWidth - 0.5) * 15;
             mouseY = (e.clientY/window.innerHeight - 0.5) * 15;
          });

          function animate() {
             requestAnimationFrame(animate);
             const p = geo.attributes.position.array;
             const time = Date.now() * 0.0005;

             for(let i=0; i<count; i++) {
                const i3 = i * 3;
                
                // Rotation
                const angle = 0.005 * speeds[i];
                const x = p[i3];
                const y = p[i3+1];
                p[i3] = x * Math.cos(angle) - y * Math.sin(angle);
                p[i3+1] = x * Math.sin(angle) + y * Math.cos(angle);

                // Depth movement + Scroll influence
                p[i3+2] += 0.1 * speeds[i];
                if(p[i3+2] > 40) p[i3+2] = -40;

                // Mouse influence (Gravitational Pinch)
                const dx = p[i3] - mouse.x;
                const dy = p[i3+1] - mouse.y;
                const d = Math.sqrt(dx*dx + dy*dy);
                if(d < 10) {
                   p[i3] -= dx * 0.02;
                   p[i3+1] -= dy * 0.02;
                }
             }

             geo.attributes.position.needsUpdate = true;
             vortexGroup.position.z = scrollY * 0.05;
             vortexGroup.rotation.z += 0.001;

             renderer.render(scene, camera);
          }
          animate();

          window.addEventListener('resize', () => {
             camera.aspect = window.innerWidth / window.innerHeight;
             camera.updateProjectionMatrix();
             renderer.setSize(window.innerWidth, window.innerHeight);
          });

         // Scroll Progress Integration
         const bar = document.getElementById('scroll-progress');
         if (bar) {
            window.addEventListener('scroll', () => {
               const winScroll = document.documentElement.scrollTop;
               const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
               const scrolled = (winScroll / height) * 100;
               bar.style.width = scrolled + "%";
            }, { passive: true });
         }
      })();
    </script>
	</body>
</html>
